{
  "_comment": "Setting fragment for the Review card. NOTE: there are deliberately NO settings for author, rating, date or body. Review content comes from the Judge.me review object only — a fabricated review is a fabricated endorsement. These settings govern presentation, nothing else.",
  "settings": [
    {
      "type": "select", "id": "review_style", "label": "t:components.review_card.style", "default": "list",
      "options": [
        { "value": "list",     "label": "t:components.review_card.style_list" },
        { "value": "featured", "label": "t:components.review_card.style_featured" },
        { "value": "carousel", "label": "t:components.review_card.style_carousel" },
        { "value": "detailed", "label": "t:components.review_card.style_detailed" },
        { "value": "vintage",  "label": "t:components.review_card.style_vintage" }
      ]
    },
    { "type": "range", "id": "truncate_length", "min": 80, "max": 400, "step": 20, "unit": "ch", "label": "t:components.review_card.truncate", "default": 200 },
    { "type": "checkbox", "id": "show_verified_badge", "label": "t:components.review_card.show_verified", "default": true },
    { "type": "checkbox", "id": "show_product_info", "label": "t:components.review_card.show_product", "default": false }
  ]
}
