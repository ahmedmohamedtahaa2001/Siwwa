{
  "_comment": "Setting fragment for the Button primitive. A snippet has no {% schema %} of its own — paste these into the consuming section's settings or block settings, prefixing ids where a section uses more than one button. Labels use t: keys resolved from siwa-theme/locales/en.default.schema.json.",
  "settings": [
    { "type": "text", "id": "cta_label", "label": "t:components.button.label", "default": "Shop now" },
    { "type": "url", "id": "cta_url", "label": "t:components.button.url" },
    {
      "type": "select", "id": "cta_style", "label": "t:components.button.style", "default": "primary",
      "options": [
        { "value": "minimal", "label": "t:components.button.style_minimal" },
        { "value": "primary", "label": "t:components.button.style_primary" },
        { "value": "dark",    "label": "t:components.button.style_dark" },
        { "value": "ghost",   "label": "t:components.button.style_ghost" },
        { "value": "icon",    "label": "t:components.button.style_icon" }
      ]
    },
    {
      "type": "select", "id": "cta_icon", "label": "t:components.button.icon", "default": "arrow-right",
      "info": "t:components.button.icon_info",
      "options": [
        { "value": "arrow-right", "label": "t:components.icon.arrow_right" },
        { "value": "plus",        "label": "t:components.icon.plus" },
        { "value": "bag",         "label": "t:components.icon.bag" },
        { "value": "check",       "label": "t:components.icon.check" },
        { "value": "heart",       "label": "t:components.icon.heart" }
      ]
    },
    { "type": "select", "id": "cta_size", "label": "t:components.button.size", "default": "md",
      "options": [
        { "value": "sm", "label": "t:components.size.sm" },
        { "value": "md", "label": "t:components.size.md" },
        { "value": "lg", "label": "t:components.size.lg" }
      ]
    },
    { "type": "checkbox", "id": "cta_full_width", "label": "t:components.button.full_width", "default": false }
  ]
}
