        { "value": "iconed",   "label": "t:components.note_pyramid.style_iconed" },
        { "value": "graphic",  "label": "t:components.note_pyramid.style_graphic" },
        { "value": "list",     "label": "t:components.note_pyramid.style_list" },
        { "value": "radial",   "label": "t:components.note_pyramid.style_radial" },
        { "value": "heritage", "label": "t:components.note_pyramid.style_heritage" }
      ]
    },
    { "type": "checkbox", "id": "note_show_icons", "label": "t:components.note_pyramid.show_icons", "default": true },
    { "type": "checkbox", "id": "note_hide_when_empty", "label": "t:components.note_pyramid.hide_when_empty", "default": true, "info": "t:components.note_pyramid.hide_when_empty_info" },
    { "type": "text", "id": "note_heading", "label": "t:components.note_pyramid.heading" }
