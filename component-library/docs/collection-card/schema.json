{
  "_comment": "Setting fragment for the Collection card. `show_count` defaults FALSE: 05-COLLECTIONS.md records captured products_count values larger than the whole 56-product catalogue. The heritage style cannot be firewalled in code (a collection has no vendor) — it is a merchant instruction in the info text.",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:components.collection_card.collection" },
    { "type": "image_picker", "id": "image", "label": "t:components.collection_card.image" },
    { "type": "text", "id": "title", "label": "t:components.collection_card.title" },
    { "type": "text", "id": "title_ar", "label": "t:components.collection_card.title_ar", "info": "t:components.bilingual.equal_weight_info" },
    { "type": "text", "id": "description", "label": "t:components.collection_card.description" },
    {
      "type": "select", "id": "collection_card_style", "label": "t:components.collection_card.style", "default": "overlay",
      "info": "t:components.collection_card.style_info",
      "options": [
        { "value": "overlay",   "label": "t:components.collection_card.style_overlay" },
        { "value": "split",     "label": "t:components.collection_card.style_split" },
        { "value": "minimal",   "label": "t:components.collection_card.style_minimal" },
        { "value": "cinematic", "label": "t:components.collection_card.style_cinematic" },
        { "value": "heritage",  "label": "t:components.collection_card.style_heritage" }
      ]
    },
    { "type": "checkbox", "id": "show_product_count", "label": "t:components.collection_card.show_count", "default": false, "info": "t:components.collection_card.show_count_info" },
    { "type": "text", "id": "cta_label", "label": "t:components.button.label" },
    { "type": "range", "id": "scrim_opacity", "min": 0, "max": 80, "step": 10, "unit": "%", "label": "t:components.image.overlay", "default": 40 }
  ]
}
