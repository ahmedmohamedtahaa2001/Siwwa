{
  "_comment": "Setting fragment for the Input primitive. `label` is required and is never replaced by `placeholder`. The `soft` style is intentionally identical to `minimal` while --r-md is 0.",
  "settings": [
    { "type": "text", "id": "field_label", "label": "t:components.input.label" },
    { "type": "text", "id": "field_placeholder", "label": "t:components.input.placeholder", "info": "t:components.input.placeholder_info" },
    {
      "type": "select", "id": "field_type", "label": "t:components.input.type", "default": "text",
      "options": [
        { "value": "text",     "label": "t:components.input.type_text" },
        { "value": "email",    "label": "t:components.input.type_email" },
        { "value": "tel",      "label": "t:components.input.type_tel" },
        { "value": "number",   "label": "t:components.input.type_number" },
        { "value": "search",   "label": "t:components.input.type_search" },
        { "value": "textarea", "label": "t:components.input.type_textarea" }
      ]
    },
    {
      "type": "select", "id": "field_style", "label": "t:components.input.style", "default": "minimal",
      "options": [
        { "value": "minimal", "label": "t:components.input.style_minimal" },
        { "value": "filled",  "label": "t:components.input.style_filled" },
        { "value": "soft",    "label": "t:components.input.style_soft" },
        { "value": "dark",    "label": "t:components.input.style_dark" },
        { "value": "icon",    "label": "t:components.input.style_icon" }
      ]
    },
    { "type": "text", "id": "field_hint", "label": "t:components.input.hint" },
    { "type": "checkbox", "id": "field_required", "label": "t:components.input.required", "default": false }
  ]
}
