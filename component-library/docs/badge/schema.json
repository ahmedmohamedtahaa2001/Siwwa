{
  "_comment": "Setting fragment for the Badge primitive. `authentic` is firewalled in badge.liquid: passing `product` downgrades it to `new` on any inspired-by product, so exposing the option here is safe.",
  "settings": [
    { "type": "checkbox", "id": "show_badge", "label": "t:components.badge.show", "default": false },
    {
      "type": "select", "id": "badge_type", "label": "t:components.badge.type", "default": "auto",
      "info": "t:components.badge.type_info",
      "options": [
        { "value": "auto",        "label": "t:components.badge.type_auto" },
        { "value": "sale",        "label": "t:components.badge.type_sale" },
        { "value": "in-stock",    "label": "t:components.badge.type_in_stock" },
        { "value": "new",         "label": "t:components.badge.type_new" },
        { "value": "best-seller", "label": "t:components.badge.type_best_seller" },
        { "value": "authentic",   "label": "t:components.badge.type_authentic" }
      ]
    },
    { "type": "text", "id": "badge_text", "label": "t:components.badge.text", "info": "t:components.badge.text_info" },
    { "type": "checkbox", "id": "badge_show_icon", "label": "t:components.badge.show_icon", "default": false }
  ]
}
