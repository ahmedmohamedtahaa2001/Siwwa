<!doctype html>
{%- liquid
  assign locale = request.locale.iso_code
  assign is_rtl = false
  if locale == 'ar' or locale == 'he' or locale == 'fa' or locale == 'ur'
    assign is_rtl = true
  endif
  assign preset = settings.theme_preset | default: 'archive'
-%}
<html
  lang="{{ locale }}"
  dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
      This must run BEFORE the stylesheets. `.siwa-reveal` only takes its hidden
      start state under `.js`, so content is never withheld from a visitor
      without JavaScript. Without this line every revealed section stays
      invisible for everyone else.
    {%- endcomment -%}
    <script>document.documentElement.classList.add('js');</script>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- comment -%}
      Type. Each design direction names its own Latin + Arabic pair, and all
      five pairs load here so switching direction or locale never waits on a
      font request. Loaded remotely by deliberate exception — see
      .theme-check.yml.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Inter:wght@300..700&family=Inter+Tight:wght@300..700&family=Archivo+Black&family=Cormorant+Garamond:wght@300..700&family=Nunito:wght@300..800&family=JetBrains+Mono:wght@400..600&display=swap"
    >
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=IBM+Plex+Sans+Arabic:wght@300..700&family=Cairo:wght@300..900&family=Amiri:wght@400;700&family=Noto+Kufi+Arabic:wght@300..700&family=Baloo+Bhaijaan+2:wght@400..800&family=Almarai:wght@300;400;700;800&display=swap"
    >

    {%- comment -%}
      The design system's load order is mandatory — the cascade depends on it.
      Tokens define the custom properties, base consumes them for the reset,
      type and layout, components consume both, and the preset layer re-points
      the tokens last so a design direction wins over the defaults without
      touching a single component rule.
    {%- endcomment -%}
    {{ 'siwa-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'siwa-base.css' | asset_url | stylesheet_tag }}
    {{ 'siwa-components.css' | asset_url | stylesheet_tag }}
    {{ 'siwa-themes.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body
    class="siwa-body"
    data-theme="{{ preset }}"
    data-locale="{{ locale }}"
    data-template="{{ template.name }}"
  >
    {%- comment -%}
      The skip link is the first focusable element in the body — WCAG 2.2
      SC 2.4.1, and the design system's own §6.1.
    {%- endcomment -%}
    <a class="siwa-skip-link" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- comment -%}
      Section groups, not `{% section %}`. Two reasons. A statically rendered
      section ignores its `presets`, so a fresh install would show an empty
      announcement bar until someone opened the Customizer. And a group lets a
      merchant reorder the bar against the header, or add a second promotional
      section above the nav, without a developer.
    {%- endcomment -%}
    {%- sections 'header-group' -%}

    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}

    {%- comment -%}
      One live region for the whole document. Cart count, filter results, price
      on variant change and search result counts all announce through it, so a
      screen reader hears the change without a component owning its own region.
    {%- endcomment -%}
    <div class="sr-only" id="siwa-live-region" role="status" aria-live="polite" aria-atomic="true"></div>

    <script src="{{ 'siwa-theme.js' | asset_url }}" defer></script>
  </body>
</html>
