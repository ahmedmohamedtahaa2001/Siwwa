{%- comment -%}
  FAQ / accordion. Uses <details>/<summary>, so it works with no
  JavaScript and is keyboard- and screen-reader-native. The `name`
  attribute gives one-open-at-a-time behaviour without a line of JS.
{%- endcomment -%}
{%- liquid
  assign exclusive = ''
  if section.settings.one_at_a_time
    assign exclusive = section.id | prepend: 'faq-'
  endif
-%}
<div class="section {% if section.settings.color_scheme == 'tonal' %}section--tonal{% endif %}">
  <div class="section__inner">
    {%- if section.settings.heading != blank -%}
      <div class="section__head {% if section.settings.center_heading %}section__head--center{% endif %}">
        <h2 class="section__title">
          {{ section.settings.heading }}
          
        </h2>
      </div>
    {%- endif -%}

    <div class="faq {% if section.settings.layout == 'two_column' %}faq--two{% endif %}">
      {%- for block in section.blocks -%}
        <details class="acc" {% if exclusive != blank %}name="{{ exclusive }}"{% endif %}
                 {% if block.settings.open_by_default %}open{% endif %}
                 {{ block.shopify_attributes }}>
          <summary class="acc__q">
            {{ block.settings.question }}
            
          </summary>
          <div class="acc__a rte">
            {{ block.settings.answer }}
            
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
    { "type": "checkbox", "id": "center_heading", "label": "t:sections.featured_collections.center_heading", "default": true },
    { "type": "select", "id": "layout", "label": "t:sections.faq.layout", "default": "single",
      "options": [
        { "value": "single", "label": "t:sections.faq.layout_single" },
        { "value": "two_column", "label": "t:sections.faq.layout_two_column" }
      ] },
    { "type": "checkbox", "id": "one_at_a_time", "label": "t:sections.faq.one_at_a_time", "default": true, "info": "t:sections.faq.one_at_a_time_info" },
    { "type": "select", "id": "color_scheme", "label": "t:sections.general.color_scheme", "default": "canvas",
      "options": [
        { "value": "canvas", "label": "t:sections.general.scheme_canvas" },
        { "value": "tonal", "label": "t:sections.general.scheme_tonal" }
      ] }
  ],
  "blocks": [
    { "type": "question", "name": "t:sections.faq.block",
      "settings": [
        { "type": "text", "id": "question", "label": "t:sections.faq.question" },
        { "type": "richtext", "id": "answer", "label": "t:sections.faq.answer" },
        { "type": "checkbox", "id": "open_by_default", "label": "t:sections.faq.open_default", "default": false }
      ] }
  ],
  "presets": [ { "name": "t:sections.faq.name", "blocks": [ { "type": "question" }, { "type": "question" } ] } ]
}
{% endschema %}
