{%- comment -%}
  Rich text — policy pages, about body copy. Bilingual.
{%- endcomment -%}
<div class="section {% if section.settings.color_scheme == 'tonal' %}section--tonal{% endif %}">
  <div class="section__inner" style="max-width:{{ section.settings.max_width }}px">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="section__title">
              {{ block.settings.heading }}
              
            </h2>
          {%- when 'text' -%}
            <div class="rte">{{ block.settings.body }}</div>
            
          {%- when 'quote' -%}
            {%- render 'testimonial-card', style: 'quote',
              quote: block.settings.quote, author: block.settings.author -%}
          {%- when 'image' -%}
            {%- render 'image-container', image: block.settings.image, ratio: '16x9', alt: block.settings.alt -%}
          {%- when 'button' -%}
            {%- render 'button', label: block.settings.label, url: block.settings.url, style: block.settings.style -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "settings": [
    { "type": "range", "id": "max_width", "min": 480, "max": 1200, "step": 40, "unit": "px", "label": "t:sections.rich_text.max_width", "default": 800 },
    { "type": "select", "id": "color_scheme", "label": "t:sections.general.color_scheme", "default": "canvas",
      "options": [
        { "value": "canvas", "label": "t:sections.general.scheme_canvas" },
        { "value": "tonal", "label": "t:sections.general.scheme_tonal" }
      ] }
  ],
  "blocks": [
    { "type": "heading", "name": "t:sections.rich_text.block_heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" }
      ] },
    { "type": "text", "name": "t:sections.rich_text.block_text",
      "settings": [
        { "type": "richtext", "id": "body", "label": "t:components.feature_card.body" }
      ] },
    { "type": "quote", "name": "t:sections.storytelling.block_quote",
      "settings": [
        { "type": "text", "id": "quote", "label": "t:components.testimonial.quote" },
        { "type": "text", "id": "author", "label": "t:components.testimonial.author" }
      ] },
    { "type": "image", "name": "t:sections.storytelling.block_image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:components.feature_card.image" },
        { "type": "text", "id": "alt", "label": "t:sections.rich_text.alt" }
      ] },
    { "type": "button", "name": "t:sections.rich_text.block_button",
      "settings": [
        { "type": "text", "id": "label", "label": "t:components.button.label" },
        { "type": "url", "id": "url", "label": "t:components.button.url" },
        { "type": "select", "id": "style", "label": "t:components.button.style", "default": "primary",
          "options": [
            { "value": "primary", "label": "t:components.button.style_primary" },
            { "value": "minimal", "label": "t:components.button.style_minimal" },
            { "value": "ghost", "label": "t:components.button.style_ghost" }
          ] }
      ] }
  ],
  "presets": [ { "name": "t:sections.rich_text.name", "blocks": [ { "type": "heading" }, { "type": "text" } ] } ]
}
{% endschema %}
