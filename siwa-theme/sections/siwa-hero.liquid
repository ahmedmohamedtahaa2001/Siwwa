{{ 'siwa-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign hero_class = 'siwa-hero'
  if s.alignment == 'center'
    assign hero_class = hero_class | append: ' siwa-hero__inner--bottom-center'
  elsif s.alignment == 'end'
    assign hero_class = hero_class | append: ' siwa-hero__inner--bottom-end'
  endif
  if s.text_color == 'dark'
    assign hero_class = hero_class | append: ' siwa-hero__content--dark'
  else
    assign hero_class = hero_class | append: ' siwa-hero__content--light'
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --siwa-hero-h: {{ s.height }}px;
    --siwa-hero-scrim-opacity: {{ s.scrim_opacity }};
  }
{% endstyle %}

<section id="shopify-section-{{ section.id }}" class="{{ hero_class }}" {% if s.heading != blank %}aria-label="{{ s.heading | escape }}"{% endif %}>

  <div class="siwa-hero__media {% if s.media_type == 'video' and s.video != blank %}siwa-hero__media--motion{% endif %}{% if s.no_scrim %} siwa-hero__media--no-scrim{% endif %}">
    {%- if s.video != blank and s.media_type == 'video' -%}
      {{ s.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1920x' }}
    {%- elsif s.image != blank -%}
      {{ s.image | image_url: width: 3000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,1920,2400,3000', sizes: '100vw', alt: s.image_alt | default: s.heading | escape }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="siwa-hero__inner">
    <div class="siwa-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="siwa-label siwa-hero__eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h1 class="siwa-hero-title">{{ s.heading }}</h1>
      {%- endif -%}

      {%- if s.subheading != blank -%}
        <div class="siwa-prose siwa-hero__subheading">{{ s.subheading }}</div>
      {%- endif -%}

      <div class="siwa-hero__actions">
        {%- if s.cta_label != blank -%}
          {%- render 'siwa-button', label: s.cta_label, href: s.cta_url, variant: s.cta_variant -%}
        {%- endif -%}
        {%- if s.secondary_label != blank -%}
          {%- render 'siwa-button', label: s.secondary_label, href: s.secondary_url, variant: s.secondary_variant -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "siwa-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "video", "id": "video", "label": "Background video (overrides image)" },
    { "type": "select", "id": "media_type", "label": "Media type", "default": "image", "options": [{"value":"image","label":"Image"},{"value":"video","label":"Video"}] },
    { "type": "range", "id": "height", "min": 320, "max": 900, "step": 10, "unit": "px", "label": "Height", "default": 620 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_label", "label": "Primary button label" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "select", "id": "cta_variant", "label": "Primary style", "default": "primary", "options": [{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"},{"value":"text","label":"Text"}] },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "select", "id": "secondary_variant", "label": "Secondary style", "default": "text", "options": [{"value":"text","label":"Text"},{"value":"secondary","label":"Secondary"}] },
    { "type": "select", "id": "alignment", "label": "Content position", "default": "start", "options": [{"value":"start","label":"Bottom left"},{"value":"center","label":"Bottom center"},{"value":"end","label":"Bottom right"}] },
    { "type": "select", "id": "text_color", "label": "Text colour", "default": "light", "options": [{"value":"light","label":"White"},{"value":"dark","label":"Black"}] },
    { "type": "range", "id": "scrim_opacity", "min": 0, "max": 1, "step": 0.05, "label": "Scrim opacity", "default": 0.7 },
    { "type": "checkbox", "id": "no_scrim", "label": "Disable scrim", "default": false }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
