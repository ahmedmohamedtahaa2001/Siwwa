{{ 'siwa-oracle.css' | asset_url | stylesheet_tag }}
<section class="siwa-oracle-page">
  <div class="siwa-container">
    <h1>{{ 'oracle.page_title' | t }}</h1>
    <p class="siwa-lead">{{ 'oracle.page_intro' | t }}</p>

    <form id="siwa-oracle-form" class="siwa-oracle__form">
      <ol class="siwa-oracle__steps">
        <li>
          <label>{{ 'oracle.q_signature' | t }}</label>
          <select name="signature">
            <option value="fruity">{{ 'oracle.opt_fruity' | t }}</option>
            <option value="woody">{{ 'oracle.opt_woody' | t }}</option>
            <option value="gourmand">{{ 'oracle.opt_gourmand' | t }}</option>
            <option value="fresh">{{ 'oracle.opt_fresh' | t }}</option>
            <option value="floral">{{ 'oracle.opt_floral' | t }}</option>
          </select>
        </li>
        <li>
          <label>{{ 'oracle.q_occasion' | t }}</label>
          <select name="occasion">
            <option value="daily">{{ 'oracle.opt_daily' | t }}</option>
            <option value="evening">{{ 'oracle.opt_evening' | t }}</option>
            <option value="special">{{ 'oracle.opt_special' | t }}</option>
          </select>
        </li>
        <li>
          <label>{{ 'oracle.q_intensity' | t }}</label>
          <select name="intensity">
            <option value="light">{{ 'oracle.opt_light' | t }}</option>
            <option value="moderate">{{ 'oracle.opt_moderate' | t }}</option>
            <option value="strong">{{ 'oracle.opt_strong' | t }}</option>
          </select>
        </li>
        <li>
          <label>{{ 'oracle.q_notes' | t }}</label>
          <select name="notes">
            <option value="citrus">{{ 'oracle.opt_citrus' | t }}</option>
            <option value="floral">{{ 'oracle.opt_floral' | t }}</option>
            <option value="woody">{{ 'oracle.opt_woody' | t }}</option>
            <option value="gourmand">{{ 'oracle.opt_gourmand' | t }}</option>
          </select>
        </li>
        <li>
          <label>{{ 'oracle.q_season' | t }}</label>
          <select name="season">
            <option value="summer">{{ 'oracle.opt_summer' | t }}</option>
            <option value="winter">{{ 'oracle.opt_winter' | t }}</option>
            <option value="all">{{ 'oracle.opt_all' | t }}</option>
          </select>
        </li>
      </ol>

      <p><button id="siwa-oracle-submit" class="siwa-btn siwa-btn--primary" type="button">{{ 'oracle.submit' | t }}</button></p>
    </form>

    <div id="siwa-oracle-results" style="display:none;">
      <h2>{{ 'oracle.results_title' | t }}</h2>
      <div id="siwa-oracle-cards" class="siwa-grid"></div>
      <p><a class="siwa-btn" href="/collections/testers">{{ 'oracle.results_cta' | t }}</a></p>
    </div>
  </div>

  <script>
    (function(){
      async function loadData(){
        try{
          var res = await fetch('{{ "siwa-oracle-data.json" | asset_url }}');
          return await res.json();
        }catch(e){ return { products: [] }; }
      }

      function scoreProduct(p, answers){
        var score = 0; var text = (p.description || p.title).toLowerCase();
        if(text.indexOf(answers.signature) !== -1) score += 2;
        if(text.indexOf(answers.notes) !== -1) score += 2;
        if(answers.intensity === 'strong' && text.match(/strong|projection|sillage/)) score +=1;
        if(answers.occasion === 'evening' && text.match(/evening|winter|rich|spicy/)) score +=1;
        if(answers.season === 'summer' && text.match(/summer|sun|citrus|fresh/)) score +=1;
        return score;
      }

      document.getElementById('siwa-oracle-submit').addEventListener('click', async function(){
        var form = document.getElementById('siwa-oracle-form');
        var f = new FormData(form);
        var answers = {
          signature: f.get('signature') || '',
          occasion: f.get('occasion') || '',
          intensity: f.get('intensity') || '',
          notes: f.get('notes') || '',
          season: f.get('season') || ''
        };
        var data = await loadData();
        var scored = data.products.map(function(p){ return { p:p, s: scoreProduct(p, answers) }; });
        scored.sort(function(a,b){ return b.s - a.s; });
        var picks = scored.slice(0,4).map(function(x){ return x.p; });
        var container = document.getElementById('siwa-oracle-cards'); container.innerHTML = '';
        picks.forEach(function(prod){
          var el = document.createElement('div'); el.className = 'siwa-card';
          el.innerHTML = '<h3>'+prod.title+'</h3><p>'+prod.description+'</p><p><a class="siwa-link" href="'+prod.url+'">View</a></p>';
          container.appendChild(el);
        });
        document.getElementById('siwa-oracle-results').style.display = 'block';
        window.scrollTo(0, document.getElementById('siwa-oracle-results').offsetTop - 40);
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "siwa-oracle-page",
  "settings": []
}
{% endschema %}
