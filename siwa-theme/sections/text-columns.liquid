{%- comment -%}
  Text columns / feature grid — the "Why Siwa" USP row.
  Composes feature-card. Replaces the live store's text-with-icons.
{%- endcomment -%}
<div class="section {% if section.settings.color_scheme == 'tonal' %}section--tonal{% elsif section.settings.color_scheme == 'dark' %}section--dark{% endif %}">
  <div class="section__inner">
    {%- if section.settings.heading != blank -%}
      <div class="section__head section__head--center">
        <h2 class="section__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="usp" style="grid-template-columns:repeat({{ section.settings.columns }},minmax(0,1fr))">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- render 'feature-card',
            style: section.settings.card_style,
            icon: block.settings.icon,
            image: block.settings.image,
            heading: block.settings.heading,
            body: block.settings.body,
            number: block.settings.number,
            cta_label: block.settings.cta_label,
            cta_url: block.settings.cta_url,
            heading_tag: 'h3' -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.text_columns.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "t:sections.featured_collections.columns", "default": 3 },
    { "type": "select", "id": "card_style", "label": "t:components.feature_card.style", "default": "icon",
      "options": [
        { "value": "icon", "label": "t:components.feature_card.style_icon" },
        { "value": "split", "label": "t:components.feature_card.style_split" },
        { "value": "overlay", "label": "t:components.feature_card.style_overlay" },
        { "value": "step", "label": "t:components.feature_card.style_step" },
        { "value": "heritage", "label": "t:components.feature_card.style_heritage" }
      ] },
    { "type": "select", "id": "color_scheme", "label": "t:sections.general.color_scheme", "default": "canvas",
      "options": [
        { "value": "canvas", "label": "t:sections.general.scheme_canvas" },
        { "value": "tonal", "label": "t:sections.general.scheme_tonal" },
        { "value": "dark", "label": "t:sections.general.scheme_dark" }
      ] }
  ],
  "blocks": [
    { "type": "column", "name": "t:sections.text_columns.block",
      "settings": [
        { "type": "select", "id": "icon", "label": "t:components.feature_card.icon", "default": "check",
          "options": [
            { "value": "check", "label": "t:components.icon.check" },
            { "value": "heart", "label": "t:components.icon.heart" },
            { "value": "leaf", "label": "t:components.icon.leaf" },
            { "value": "drop", "label": "t:components.icon.drop" },
            { "value": "wood", "label": "t:components.icon.wood" }
          ] },
        { "type": "image_picker", "id": "image", "label": "t:components.feature_card.image" },
        { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
        { "type": "richtext", "id": "body", "label": "t:components.feature_card.body" },
        { "type": "text", "id": "number", "label": "t:components.feature_card.number" },
        { "type": "text", "id": "cta_label", "label": "t:components.button.label" },
        { "type": "url", "id": "cta_url", "label": "t:components.button.url" }
      ] }
  ],
  "presets": [ { "name": "t:sections.text_columns.name", "blocks": [ { "type": "column" }, { "type": "column" }, { "type": "column" } ] } ]
}
{% endschema %}
