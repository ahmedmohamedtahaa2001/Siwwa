{%- comment -%}
  Scrolling marquee — the live store's "True Elegance" / "Signature Luxury" bands.
  Motion is suppressed wholesale by prefers-reduced-motion in tokens.css,
  and the track is aria-hidden with a static equivalent for assistive tech.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="section {% if section.settings.color_scheme == 'dark' %}section--dark{% elsif section.settings.color_scheme == 'tonal' %}section--tonal{% endif %}"
       style="--section-pad:{{ section.settings.padding }}px">
    {%- for row in (1..section.settings.rows) -%}
      <div class="marquee"
           data-siwa-marquee
           data-speed="{{ section.settings.speed }}"
           data-direction="{% if row == 2 %}reverse{% else %}forward{% endif %}"
           aria-hidden="true">
        <div class="marquee__track">
          {%- for i in (1..2) -%}
            {%- for block in section.blocks -%}
              <span class="marquee__item" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
                
              </span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
    <p class="visually-hidden">
      {%- for block in section.blocks -%}{{ block.settings.text }}. {% endfor -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.marquee.name",
  "settings": [
    { "type": "range", "id": "rows", "min": 1, "max": 2, "step": 1, "label": "t:sections.marquee.rows", "default": 1 },
    { "type": "range", "id": "speed", "min": 10, "max": 90, "step": 5, "unit": "s", "label": "t:sections.marquee.speed", "default": 40 },
    { "type": "range", "id": "padding", "min": 8, "max": 96, "step": 8, "unit": "px", "label": "t:sections.general.padding", "default": 24 },
    { "type": "select", "id": "color_scheme", "label": "t:sections.general.color_scheme", "default": "dark",
      "options": [
        { "value": "canvas", "label": "t:sections.general.scheme_canvas" },
        { "value": "tonal", "label": "t:sections.general.scheme_tonal" },
        { "value": "dark", "label": "t:sections.general.scheme_dark" }
      ] }
  ],
  "blocks": [
    { "type": "item", "name": "t:sections.marquee.block",
      "settings": [
        { "type": "text", "id": "text", "label": "t:sections.announcement.message" }
      ] }
  ],
  "presets": [ { "name": "t:sections.marquee.name", "blocks": [ { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
