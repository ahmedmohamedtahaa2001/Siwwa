{%- comment -%}
  Cart drawer — 5 variants.

  Variants (drawer_style):
    simple        Line items, subtotal, checkout.
    recommended   Adds "you may also like" below the items.
    shipping      Free-shipping progress bar. Threshold 1,500 EGP on the
                  live store — a setting here, not a constant.
    layering      Suggests a layering partner when the cart qualifies.
    bundle        Reminds the customer a pair could be bought as a bundle.

  ⚠ THE FREE-SHIPPING THRESHOLD IS A SETTING
  1,500 EGP is real (00-OVERVIEW.md) but it is a merchant decision that
  changes. It is a setting with that value as its default, never a literal.
{%- endcomment -%}
{%- liquid
  assign ds = section.settings.drawer_style
  assign threshold = section.settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign pct = 0
  if threshold > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
<div class="drawer drawer--end" id="CartDrawer" hidden data-siwa-drawer data-siwa-cart>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
    <button class="popup__close" type="button" data-siwa-drawer-close
            aria-label="{{ 'general.accessibility.close' | t }}">
      {%- render 'icon', name: 'close' -%}
    </button>

    <h2 class="ccard__title">{{ 'cart.general.title' | t }}</h2>

    {%- if section.settings.show_shipping_progress and threshold > 0 -%}
      <div class="ship">
        <span class="review__meta" aria-live="polite">
          {%- if remaining > 0 -%}
            {{ remaining | money }} {{ 'cart.shipping.away_from_free' | t }}
          {%- else -%}
            {{ 'cart.shipping.qualified' | t }}
          {%- endif -%}
        </span>
        <span class="ship__bar" role="img"
              aria-label="{{ 'cart.shipping.progress' | t: percent: pct }}">
          <i style="width:{{ pct }}%"></i>
        </span>
      </div>
    {%- endif -%}

    {%- if cart.item_count > 0 -%}
      <ul style="list-style:none;margin:0;padding:0;display:grid;gap:var(--sp-md)">
        {%- for item in cart.items -%}
          <li class="line">
            {%- render 'image-container', image: item.image, ratio: '4x5',
              class: 'line__img', alt: item.product.title -%}
            <div>
              <a href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="review__meta">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="price">{{ item.final_line_price | money }}</p>
            </div>
            <a href="{{ item.url_to_remove }}" class="btn btn--tertiary btn--sm"
               aria-label="{{ 'general.accessibility.remove' | t }}">
              {%- render 'icon', name: 'close' -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>

      <div class="drawer__foot">
        <div class="layering__total">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span class="price">{{ cart.total_price | money }}</span>
        </div>
        {%- render 'button', label: 'cart.general.checkout' | t, url: routes.cart_url,
          style: 'primary', size: 'lg', full_width: true -%}
        {%- render 'button', label: 'cart.general.continue_shopping' | t, style: 'ghost' -%}
      </div>

      {%- if ds == 'recommended' and section.settings.show_recommendations -%}
        <div data-cart-recommendations
             data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ cart.items.first.product_id }}&limit=3">
        </div>
      {%- endif -%}

      {%- if ds == 'layering' and section.settings.layering_partner_collection != blank -%}
        <div>
          <p class="layering__steplabel">{{ section.settings.layering_heading }}</p>
          {%- for product in section.settings.layering_partner_collection.products limit: 2 -%}
            {%- render 'product-card', product: product, style: 'compact' -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if ds == 'bundle' and section.settings.bundle_note != blank and cart.item_count > 1 -%}
        <p class="layering__reason">{{ section.settings.bundle_note }}</p>
      {%- endif -%}

    {%- else -%}
      <p class="pyramid__empty">{{ 'cart.general.empty' | t }}</p>
      {%- render 'button', label: 'collections.general.shop_all' | t,
        url: routes.all_products_collection_url, style: 'primary' -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": [
    { "type": "select", "id": "drawer_style", "label": "t:sections.cart_drawer.style", "default": "shipping",
      "options": [
        { "value": "simple", "label": "t:sections.cart_drawer.style_simple" },
        { "value": "recommended", "label": "t:sections.cart_drawer.style_recommended" },
        { "value": "shipping", "label": "t:sections.cart_drawer.style_shipping" },
        { "value": "layering", "label": "t:sections.cart_drawer.style_layering" },
        { "value": "bundle", "label": "t:sections.cart_drawer.style_bundle" }
      ] },
    { "type": "checkbox", "id": "show_shipping_progress", "label": "t:sections.cart_drawer.show_progress", "default": true },
    { "type": "number", "id": "free_shipping_threshold", "label": "t:sections.cart_drawer.threshold", "default": 1500, "info": "t:sections.cart_drawer.threshold_info" },
    { "type": "checkbox", "id": "show_recommendations", "label": "t:sections.cart_drawer.show_recommendations", "default": false },
    { "type": "text", "id": "layering_heading", "label": "t:components.layering.heading" },
    { "type": "collection", "id": "layering_partner_collection", "label": "t:components.layering.partner_collection" },
    { "type": "text", "id": "bundle_note", "label": "t:sections.cart_drawer.bundle_note" }
  ],
  "enabled_on": { "groups": ["overlay"] }
}
{% endschema %}
