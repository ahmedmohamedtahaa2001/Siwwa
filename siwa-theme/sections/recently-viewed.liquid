{%- comment -%}
  Recently viewed — feature A-05.

  The live store has a recently-viewed section that renders EMPTY and is
  filled client-side (`01-SITE-STRUCTURE.md`). This does the same job
  without the empty-shell problem.

  ⚠ WHY IT IS BUILT THIS WAY
  Shopify gives Liquid no access to arbitrary query parameters, so a
  section cannot be handed a list of handles and render them. (An earlier
  draft of this file assumed it could — it cannot.) The options are:

    a) JS fetches each product page and scrapes a card — N requests,
       slow, and brittle against markup changes.
    b) The section renders a candidate set server-side, hidden, and JS
       reveals the ones the visitor has actually seen, in their order.

  (b) is used. It costs one collection render and zero extra requests,
  and it degrades correctly: with JS off, or with no history, the whole
  section stays `hidden` and the page is unaffected.

  Keep `source_collection` reasonably small — it is rendered in full and
  then filtered. The catalogue is 56 products, so "all products" is fine
  here; on a larger store, point it at a best-sellers collection.

  ⚠ IT HIDES ITSELF WHEN EMPTY.
  A first-time visitor has no history. A heading above an empty row is
  worse than nothing, so the wrapper starts hidden and JS reveals it only
  once it has cards to show — which also means no layout shift.

  Privacy: product handles only, in localStorage, on the visitor's own
  device. Nothing is sent anywhere.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.source_collection
  assign candidates = source.products
  unless source
    assign candidates = collections.all.products
  endunless
-%}
<div
  class="section {% if section.settings.color_scheme == 'tonal' %}section--tonal{% endif %}"
  data-siwa-recent
  data-limit="{{ section.settings.products_limit }}"
  data-storage-key="siwa:recently-viewed"
  hidden
>
  <div class="section__inner">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="section__title">
        {{ section.settings.heading }}
        
      </h2>
    </div>

    {%- comment -%}
      Candidates render hidden. JS unhides the matches in visit order and
      reorders them with `order`, so no DOM is moved.
    {%- endcomment -%}
    <div class="pgrid" style="--grid-cols-desktop:{{ section.settings.products_per_row }}"
         data-recent-grid>
      {%- for product in candidates limit: section.settings.candidate_limit -%}
        <div data-recent-item="{{ product.handle }}" hidden>
          {%- render 'product-card',
            product: product,
            style: section.settings.product_card_style,
            show_reviews: true,
            heading_tag: 'h3' -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.recent.name",
  "settings": [
    { "type": "paragraph", "content": "t:sections.recent.info" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.general.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
    { "type": "collection", "id": "source_collection", "label": "t:sections.recent.source", "info": "t:sections.recent.source_info" },
    { "type": "range", "id": "candidate_limit", "min": 12, "max": 60, "step": 4, "label": "t:sections.recent.candidate_limit", "default": 56, "info": "t:sections.recent.candidate_limit_info" },
    { "type": "range", "id": "products_limit", "min": 2, "max": 12, "step": 1, "label": "t:components.product_grid.limit", "default": 4 },
    { "type": "range", "id": "products_per_row", "min": 2, "max": 6, "step": 1, "label": "t:components.product_grid.per_row", "default": 4 },
    { "type": "select", "id": "product_card_style", "label": "t:components.product_card.style", "default": "compact",
      "options": [
        { "value": "minimal", "label": "t:components.product_card.style_minimal" },
        { "value": "compact", "label": "t:components.product_card.style_compact" }
      ] },
    { "type": "select", "id": "color_scheme", "label": "t:sections.general.color_scheme", "default": "canvas",
      "options": [
        { "value": "canvas", "label": "t:sections.general.scheme_canvas" },
        { "value": "tonal", "label": "t:sections.general.scheme_tonal" }
      ] }
  ],
  "presets": [ { "name": "t:sections.recent.name" } ]
}
{% endschema %}
