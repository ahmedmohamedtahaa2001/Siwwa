{%- comment -%}
  Media grid — the live store's "Uncover Hidden Gems" tiles.
  Composes collection-card.
{%- endcomment -%}
<div class="section">
  <div class="section__inner">
    {%- if section.settings.heading != blank -%}
      <div class="section__head {% if section.settings.center_heading %}section__head--center{% endif %}">
        <h2 class="section__title">
          {{ section.settings.heading }}
          
        </h2>
      </div>
    {%- endif -%}
    <div class="mgrid {% if section.settings.layout == 'asymmetric' %}mgrid--asym{% endif %}"
         style="--tiles:{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- render 'collection-card',
            collection: block.settings.collection,
            image: block.settings.image,
            title: block.settings.title,
            description: block.settings.description,
            style: section.settings.tile_style,
            cta_label: block.settings.cta_label,
            accent_color: block.settings.accent_color,
            scrim_opacity: section.settings.overlay_opacity,
            ratio: section.settings.ratio,
            heading_tag: 'h3' -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.media_grid.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
    { "type": "checkbox", "id": "center_heading", "label": "t:sections.featured_collections.center_heading", "default": true },
    { "type": "select", "id": "layout", "label": "t:sections.media_grid.layout", "default": "even",
      "options": [
        { "value": "even", "label": "t:sections.media_grid.layout_even" },
        { "value": "asymmetric", "label": "t:sections.media_grid.layout_asymmetric" }
      ] },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "t:sections.featured_collections.columns", "default": 3 },
    { "type": "select", "id": "tile_style", "label": "t:components.collection_card.style", "default": "overlay",
      "options": [
        { "value": "overlay", "label": "t:components.collection_card.style_overlay" },
        { "value": "split", "label": "t:components.collection_card.style_split" },
        { "value": "minimal", "label": "t:components.collection_card.style_minimal" },
        { "value": "cinematic", "label": "t:components.collection_card.style_cinematic" },
        { "value": "heritage", "label": "t:components.collection_card.style_heritage" }
      ] },
    { "type": "select", "id": "ratio", "label": "t:components.image.ratio", "default": "4x5",
      "options": [
        { "value": "4x5", "label": "t:components.image.ratio_4x5" },
        { "value": "1x1", "label": "t:components.image.ratio_1x1" },
        { "value": "16x9", "label": "t:components.image.ratio_16x9" }
      ] },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 10, "unit": "%", "label": "t:components.image.overlay", "default": 40 }
  ],
  "blocks": [
    { "type": "tile", "name": "t:sections.media_grid.block",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:components.collection_card.collection" },
        { "type": "image_picker", "id": "image", "label": "t:components.feature_card.image" },
        { "type": "text", "id": "title", "label": "t:components.collection_card.title" },
        { "type": "text", "id": "description", "label": "t:components.collection_card.description" },
        { "type": "text", "id": "cta_label", "label": "t:components.button.label" },
        { "type": "select", "id": "accent_color", "label": "t:components.accent.label", "default": "none",
          "options": [
            { "value": "none", "label": "t:components.accent.none" },
            { "value": "palm-green", "label": "t:components.accent.palm_green" },
            { "value": "date-red", "label": "t:components.accent.date_red" },
            { "value": "date-yellow", "label": "t:components.accent.date_yellow" },
            { "value": "desert-brown", "label": "t:components.accent.desert_brown" }
          ] }
      ] }
  ],
  "presets": [ { "name": "t:sections.media_grid.name", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
