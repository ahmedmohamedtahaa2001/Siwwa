{%- comment -%}
  Image with text — 5 layouts. Mid-page CTAs and collection promos.
  Composes feature-card.
{%- endcomment -%}
{%- liquid
  assign l = section.settings.layout
  case l
    when 'split'
      assign fc_style = 'split'
    when 'parallax'
      assign fc_style = 'overlay'
    when 'vintage'
      assign fc_style = 'heritage'
    else
      assign fc_style = 'overlay'
  endcase
  assign reverse = false
  if section.settings.text_position == 'end'
    assign reverse = true
  endif
-%}
<div class="section {% if l == 'centered' or l == 'parallax' %}section--full{% endif %}"
     {% if section.settings.enable_parallax %}data-siwa-parallax{% endif %}>
  <div class="section__inner">
    {%- render 'feature-card',
      style: fc_style,
      heading: section.settings.heading,
      body: section.settings.body,
      image: section.settings.image,
      cta_label: section.settings.cta_label,
      cta_url: section.settings.cta_url,
      reverse: reverse,
      scrim_opacity: section.settings.overlay_opacity,
      accent_color: section.settings.accent_color,
      provenance: section.settings.provenance,
      heading_tag: 'h2' -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_text.name",
  "settings": [
    { "type": "select", "id": "layout", "label": "t:sections.image_text.layout", "default": "centered",
      "options": [
        { "value": "centered", "label": "t:sections.image_text.layout_centered" },
        { "value": "aligned", "label": "t:sections.image_text.layout_aligned" },
        { "value": "split", "label": "t:sections.image_text.layout_split" },
        { "value": "parallax", "label": "t:sections.image_text.layout_parallax" },
        { "value": "vintage", "label": "t:sections.image_text.layout_vintage" }
      ] },
    { "type": "image_picker", "id": "image", "label": "t:components.feature_card.image" },
    { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
    { "type": "richtext", "id": "body", "label": "t:components.feature_card.body" },
    { "type": "text", "id": "provenance", "label": "t:components.feature_card.provenance" },
    { "type": "text", "id": "cta_label", "label": "t:components.button.label" },
    { "type": "url", "id": "cta_url", "label": "t:components.button.url" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 10, "unit": "%", "label": "t:components.image.overlay", "default": 40 },
    { "type": "select", "id": "text_position", "label": "t:sections.image_text.text_position", "default": "start",
      "options": [
        { "value": "start", "label": "t:sections.hero.align_start" },
        { "value": "end", "label": "t:sections.hero.align_end" }
      ] },
    { "type": "checkbox", "id": "enable_parallax", "label": "t:sections.image_text.parallax", "default": false, "info": "t:sections.image_text.parallax_info" },
    { "type": "select", "id": "accent_color", "label": "t:components.accent.label", "default": "none",
      "options": [
        { "value": "none", "label": "t:components.accent.none" },
        { "value": "palm-green", "label": "t:components.accent.palm_green" },
        { "value": "date-red", "label": "t:components.accent.date_red" },
        { "value": "date-yellow", "label": "t:components.accent.date_yellow" },
        { "value": "desert-brown", "label": "t:components.accent.desert_brown" }
      ] }
  ],
  "presets": [ { "name": "t:sections.image_text.name" } ]
}
{% endschema %}
