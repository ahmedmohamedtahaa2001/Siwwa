{%- comment -%}
  Scent quiz section. Hosts the quiz-flow module.
  BENCHMARK.md Part 1 §3.5: the largest missing feature on the store.
{%- endcomment -%}
<div class="section {% if section.settings.color_scheme == 'tonal' %}section--tonal{% endif %}">
  <div class="section__inner" style="max-width:760px">
    {%- render 'quiz-flow',
      blocks: section.blocks,
      quiz_style: section.settings.quiz_style,
      result_type: section.settings.result_type,
      result_collection: section.settings.result_collection,
      fallback_collection: section.settings.fallback_collection,
      heading: section.settings.heading,
      section_id: section.id -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.quiz.name",
  "settings": [
    { "type": "select", "id": "quiz_style", "label": "t:components.quiz.style", "default": "form",
      "options": [
        { "value": "form", "label": "t:components.quiz.style_form" },
        { "value": "visual", "label": "t:components.quiz.style_visual" },
        { "value": "persona", "label": "t:components.quiz.style_persona" },
        { "value": "scoring", "label": "t:components.quiz.style_scoring" },
        { "value": "deep", "label": "t:components.quiz.style_deep" }
      ] },
    { "type": "text", "id": "heading", "label": "t:components.quiz.heading" },
    { "type": "select", "id": "result_type", "label": "t:components.quiz.result_type", "default": "single-product",
      "options": [
        { "value": "single-product", "label": "t:components.quiz.result_single" },
        { "value": "multi-product", "label": "t:components.quiz.result_multi" },
        { "value": "persona", "label": "t:components.quiz.result_persona" },
        { "value": "layering-combo", "label": "t:components.quiz.result_layering" }
      ] },
    { "type": "collection", "id": "result_collection", "label": "t:components.quiz.result_collection" },
    { "type": "collection", "id": "fallback_collection", "label": "t:components.quiz.fallback_collection", "info": "t:components.quiz.fallback_info" },
    { "type": "select", "id": "color_scheme", "label": "t:sections.general.color_scheme", "default": "tonal",
      "options": [
        { "value": "canvas", "label": "t:sections.general.scheme_canvas" },
        { "value": "tonal", "label": "t:sections.general.scheme_tonal" }
      ] }
  ],
  "blocks": [
    { "type": "question", "name": "t:components.quiz.question", "limit": 15,
      "settings": [
        { "type": "text", "id": "question_text", "label": "t:components.quiz.question_text" },
        { "type": "select", "id": "question_type", "label": "t:components.quiz.question_type", "default": "single-choice",
          "options": [
            { "value": "single-choice", "label": "t:components.quiz.type_single" },
            { "value": "multi-choice", "label": "t:components.quiz.type_multi" }
          ] },
        { "type": "text", "id": "answer_1_label", "label": "t:components.quiz.answer_label" },
        { "type": "text", "id": "answer_1_value", "label": "t:components.quiz.answer_value", "info": "t:components.quiz.answer_value_info" },
        { "type": "image_picker", "id": "answer_1_image", "label": "t:components.quiz.answer_image" },
        { "type": "text", "id": "answer_2_label", "label": "t:components.quiz.answer_label" },
        { "type": "text", "id": "answer_2_value", "label": "t:components.quiz.answer_value" },
        { "type": "image_picker", "id": "answer_2_image", "label": "t:components.quiz.answer_image" },
        { "type": "text", "id": "answer_3_label", "label": "t:components.quiz.answer_label" },
        { "type": "text", "id": "answer_3_value", "label": "t:components.quiz.answer_value" },
        { "type": "image_picker", "id": "answer_3_image", "label": "t:components.quiz.answer_image" },
        { "type": "text", "id": "answer_4_label", "label": "t:components.quiz.answer_label" },
        { "type": "text", "id": "answer_4_value", "label": "t:components.quiz.answer_value" },
        { "type": "image_picker", "id": "answer_4_image", "label": "t:components.quiz.answer_image" }
      ] }
  ],
  "presets": [ { "name": "t:sections.quiz.name", "blocks": [ { "type": "question" }, { "type": "question" }, { "type": "question" } ] } ]
}
{% endschema %}
