<section class="siwa-verify">
  <div class="siwa-container">
    <h1>{{ 'verify.title' | t }}</h1>
    <div id="siwa-verify-result">{{ 'verify.prompt' | t }}</div>
  </div>

  <script>
    (async function(){
      var params = new URLSearchParams(window.location.search);
      var batch = params.get('batch');
      var container = document.getElementById('siwa-verify-result');
      if(!batch){ container.innerHTML = '<p>'+container.innerText+'</p>'; return; }
      try{
        var res = await fetch('{{ "siwa-verification.json" | asset_url }}');
        var data = await res.json();
        var info = data.batches[batch] || null;
        if(info){
          container.innerHTML = '<h3>'+batch+' — '+info.status.toUpperCase()+'</h3><p>'+info.notes+'</p><p><a class="siwa-link" href="/products/'+info.handle+'">View product</a></p>';
        } else {
          container.innerHTML = '<p>No record for '+batch+'. Please contact support.</p>';
        }
      }catch(e){ container.innerHTML = '<p>Verification service unavailable.</p>'; }
    })();
  </script>
</section>

{% schema %}
{ "name": "siwa-verify" }
{% endschema %}
