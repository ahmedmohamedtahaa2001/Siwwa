{%- comment -%}
  Section: siwa-footer | Owner: A-02 | Task: ST-02

  G-02 SiteFooter. The last thing a customer reads, and the place three of
  the six trust gaps are actually closed: what you take as payment, what your
  policies say, and that Siwa is nobody else's house.

  THE SECTION WRAPPER IS THE FOOTER.
  tag: "footer" + class: "siwa-footer" gives one contentinfo landmark for the
  document with no extra element around it.

  NOTHING HERE IS A HARDCODED FACT.
  · Payment marks are rendered from shop.enabled_payment_types through
    payment_type_svg_tag, so the footer can never advertise a card checkout
    will refuse. No image file, no icon set, no manual list.
  · Policy links come from shop.policies, so a policy the merchant has not
    written simply does not appear.
  · The copyright year is `now`, and the shop name is shop.name.
  · The non-affiliation disclaimer is catalog.disclaimer and has no text
    setting at all — DESIGN.md §7.3 makes it legal copy that goes through
    counsel, not something to be edited in the Customizer. The block can be
    added or removed; its wording cannot be touched here.
  · Every other string is a locale key, or a schema setting that falls back
    to one when the merchant leaves it blank.

  No JavaScript. The newsletter is a real {% form 'customer' %} and the
  language toggle is a real {% form 'localization' %}, so both work with
  scripts off.
{%- endcomment -%}

{{ 'siwa-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign year = 'now' | date: '%Y'
  assign copyright = 'sections.footer.copyright' | t: year: year, shop: shop.name

  assign logo = s.logo
  if logo == blank
    assign logo = settings.logo
  endif

  assign wordmark = settings.logo_wordmark
  if wordmark == blank
    assign wordmark = shop.name
  endif

  assign show_locale = false
  if settings.show_language_toggle_footer and localization.available_languages.size > 1
    assign show_locale = true
  endif

  assign has_policies = false
  for policy in shop.policies
    if policy != blank
      assign has_policies = true
      break
    endif
  endfor
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --siwa-logo-width: {{ settings.logo_width }}px;
  }

  #shopify-section-{{ section.id }} .siwa-footer__inner {
    padding-block-start: {{ s.padding_top }}px;
    padding-block-end: {{ s.padding_bottom }}px;
  }

  {%- comment -%}
    Emitted inside a min-width query on purpose. A bare
    `#shopify-section-… { --siwa-footer-cols }` rule outranks the class-level
    media queries in siwa-footer.css and would freeze the desktop column
    count at every viewport — Gate 0 finding F2, the same trap .siwa-grid
    already fell into.
  {%- endcomment -%}
  @media (min-width: 1201px) {
    #shopify-section-{{ section.id }} .siwa-footer__grid {
      --siwa-footer-cols: {{ s.columns }};
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .siwa-footer__inner {
      padding-block-start: {{ s.mobile_padding_top }}px;
      padding-block-end: {{ s.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="siwa-container siwa-footer__inner">
  <div class="siwa-footer__top">
    <div class="siwa-footer__brand">
      <a class="siwa-footer__logo" href="{{ routes.root_url }}">
        {%- if s.show_logo and logo != blank -%}
          {%- assign logo_alt = shop.name | escape -%}
          {{
            logo
            | image_url: width: 440
            | image_tag:
              class: 'siwa-footer__logo-image',
              alt: logo_alt,
              loading: 'lazy',
              widths: '110, 165, 220, 330, 440',
              sizes: '(max-width: 768px) 40vw, 220px'
          }}
        {%- else -%}
          {{ wordmark }}
        {%- endif -%}
      </a>

      {%- if s.tagline != blank -%}
        <div class="siwa-footer__tagline siwa-prose">{{ s.tagline }}</div>
      {%- endif -%}
    </div>

    <div class="siwa-footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- liquid
              assign column = linklists[block.settings.menu]
              assign nav_label = 'accessibility.footer_navigation' | t
              if block.settings.heading != blank
                assign nav_label = block.settings.heading
              endif
            -%}
            <div class="siwa-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="siwa-footer__heading">
                  <span class="siwa-footer__mark" aria-hidden="true"></span>
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              {%- if column.links.size > 0 -%}
                <nav class="siwa-footer__nav" aria-label="{{ nav_label | escape }}">
                  <ul class="siwa-footer__links" role="list">
                    {%- for link in column.links -%}
                      <li>
                        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                          {{- link.title -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            {%- liquid
              assign nl_heading = 'sections.footer.newsletter_title' | t
              if block.settings.heading != blank
                assign nl_heading = block.settings.heading
              endif

              assign nl_body = 'sections.footer.newsletter_body' | t
              if block.settings.body != blank
                assign nl_body = block.settings.body
              endif

              assign nl_input_id = 'siwa-newsletter-' | append: block.id
              assign nl_error_id = 'siwa-newsletter-error-' | append: block.id
            -%}
            <div class="siwa-footer__col siwa-footer__col--wide" {{ block.shopify_attributes }}>
              <h2 class="siwa-footer__heading">
                <span class="siwa-footer__mark" aria-hidden="true"></span>
                {{ nl_heading }}
              </h2>
              <p class="siwa-footer__text">{{ nl_body }}</p>

              {%- form 'customer', id: nl_input_id, class: 'siwa-footer__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">

                {%- if form.posted_successfully? -%}
                  <p class="siwa-footer__form-success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                      <path d="M5 12.5 10 17.5 19 7" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    {{ 'sections.footer.newsletter_success' | t }}
                  </p>
                {%- endif -%}

                <div class="siwa-field">
                  <label class="siwa-field__label" for="{{ nl_input_id }}-email">
                    {{- 'sections.footer.newsletter_label' | t -}}
                  </label>
                  <div class="siwa-footer__form-row">
                    <input
                      class="siwa-input"
                      id="{{ nl_input_id }}-email"
                      type="email"
                      name="contact[email]"
                      value="{{ form.email }}"
                      autocomplete="email"
                      required
                      {%- if form.errors %}
                        aria-invalid="true"
                        aria-describedby="{{ nl_error_id }}"
                      {%- endif %}
                    >
                    <button class="siwa-button siwa-button--primary" type="submit">
                      {{- 'sections.footer.newsletter_submit' | t -}}
                    </button>
                  </div>

                  {%- comment -%}
                    §7.2 — "Invalid input." is not a message. The error names
                    the field, the fault and an example, and it is never
                    colour alone: icon, colour and text together.
                  {%- endcomment -%}
                  {%- if form.errors -%}
                    <p class="siwa-field__error" id="{{ nl_error_id }}">
                      <svg class="siwa-footer__error-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7.5v5.5M12 16.5v.5" stroke-linecap="round"></path>
                      </svg>
                      {{ 'sections.footer.newsletter_error' | t }}
                    </p>
                  {%- endif -%}
                </div>
              {%- endform -%}
            </div>

          {%- when 'text' -%}
            <div class="siwa-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="siwa-footer__heading">
                  <span class="siwa-footer__mark" aria-hidden="true"></span>
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="siwa-footer__text siwa-prose">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>

          {%- when 'disclaimer' -%}
            <div class="siwa-footer__col siwa-footer__col--wide" {{ block.shopify_attributes }}>
              <p class="siwa-footer__disclaimer">{{ 'catalog.disclaimer' | t }}</p>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="siwa-footer__bottom">
    <div class="siwa-footer__legal">
      <p class="siwa-footer__copyright">{{ copyright }}</p>

      {%- if s.show_policies and has_policies -%}
        <nav aria-label="{{ 'sections.footer.policies' | t }}">
          <ul class="siwa-footer__policies" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    <div class="siwa-footer__meta">
      {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="siwa-footer__payments" role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li class="siwa-footer__payment">
              {{ type | payment_type_svg_tag: class: 'siwa-footer__payment-svg' }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if show_locale -%}
        {%- form 'localization', class: 'siwa-footer__locale' -%}
          <fieldset class="siwa-footer__locale-set">
            <legend class="sr-only">{{ 'general.language.label' | t }}</legend>
            {%- for language in localization.available_languages -%}
              <button
                class="siwa-button siwa-button--sm siwa-button--quiet siwa-footer__locale-option"
                type="submit"
                name="locale_code"
                value="{{ language.iso_code }}"
                {%- if language.iso_code == localization.language.iso_code %} aria-current="true"{% endif %}
              >
                <span lang="{{ language.iso_code }}">{{ language.endonym_name }}</span>
              </button>
            {%- endfor -%}
          </fieldset>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "siwa-footer",
  "settings": [
    {
      "type": "header",
      "content": "Identity"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show the logo image",
      "info": "Off falls back to the wordmark in Theme settings → Brand, set in the display face.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the logo in Theme settings → Brand."
    },
    {
      "type": "richtext",
      "id": "tagline",
      "label": "Tagline",
      "info": "One or two concrete sentences — the workshop, the oasis, the batch. Not adjectives about luxury (DESIGN.md §7.1)."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment methods",
      "info": "Rendered from the payment providers your store actually accepts, so the footer can never claim a card checkout will refuse.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "info": "Taken from the policies you have written in Settings → Policies.",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "The language toggle follows Theme settings → Language → \"Show the language toggle in the footer\"."
    },
    {
      "type": "header",
      "content": "Layout & spacing"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "info": "Desktop only. The grid falls to two columns below 1200px and one below 768px on its own.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 144,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 144,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 144,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 144,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave blank to use the store's translated Field Notes heading."
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body",
          "info": "Leave blank to use the store's translated line. Say what arrives and how often — a promise a reader can hold you to."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The workshop"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body"
        }
      ]
    },
    {
      "type": "disclaimer",
      "name": "Non-affiliation disclaimer",
      "settings": [
        {
          "type": "paragraph",
          "content": "The wording is fixed and translated per locale, because it is legal copy that goes through trademark review (DESIGN.md §7.3). Add or remove the block; the sentence itself is not editable here."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "menu" },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "newsletter" },
      { "type": "disclaimer" }
    ]
  },
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "newsletter" },
        { "type": "disclaimer" }
      ]
    }
  ]
}
{% endschema %}
