{%- comment -%}
  Instagram feed. Shopify has no first-party Instagram API, so posts are
  merchant-picked images with links — honest, and it cannot break when a
  third-party token expires. If a live feed is wanted, an app block slot
  is provided.

  instagram-assets/ in this repository holds 18 images that show the real
  brand identity; they are the intended source.
{%- endcomment -%}
<div class="section {% if section.settings.color_scheme == 'tonal' %}section--tonal{% endif %}">
  <div class="section__inner">
    {%- if section.settings.heading != blank -%}
      <div class="section__head section__head--center">
        <h2 class="section__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.handle != blank -%}
          <a class="section__sub" href="{{ section.settings.profile_url }}" rel="noopener" target="_blank">
            {{ section.settings.handle }}
            <span class="visually-hidden">{{ 'general.accessibility.opens_new_window' | t }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.layout == 'carousel' -%}
      <div class="carousel-wrap" data-siwa-carousel>
        <div class="carousel" role="region" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.url }}" rel="noopener" target="_blank" {{ block.shopify_attributes }}>
              {%- render 'image-container', image: block.settings.image, ratio: '1x1', alt: block.settings.alt -%}
            </a>
          {%- endfor -%}
        </div>
        {%- render 'carousel-controls' -%}
      </div>
    {%- else -%}
      <div class="mgrid {% if section.settings.layout == 'featured' %}mgrid--asym{% endif %}"
           style="--tiles:{{ section.settings.columns }}">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.url }}" rel="noopener" target="_blank" {{ block.shopify_attributes }}>
            {%- render 'image-container', image: block.settings.image, ratio: '1x1', alt: block.settings.alt -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}<div {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.instagram.name",
  "settings": [
    { "type": "paragraph", "content": "t:sections.instagram.info" },
    { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
    { "type": "text", "id": "handle", "label": "t:sections.instagram.handle" },
    { "type": "url", "id": "profile_url", "label": "t:sections.instagram.profile_url" },
    { "type": "select", "id": "layout", "label": "t:sections.instagram.layout", "default": "grid",
      "options": [
        { "value": "grid", "label": "t:sections.instagram.layout_grid" },
        { "value": "carousel", "label": "t:sections.instagram.layout_carousel" },
        { "value": "featured", "label": "t:sections.instagram.layout_featured" }
      ] },
    { "type": "range", "id": "columns", "min": 3, "max": 6, "step": 1, "label": "t:sections.featured_collections.columns", "default": 4 },
    { "type": "select", "id": "color_scheme", "label": "t:sections.general.color_scheme", "default": "canvas",
      "options": [
        { "value": "canvas", "label": "t:sections.general.scheme_canvas" },
        { "value": "tonal", "label": "t:sections.general.scheme_tonal" }
      ] }
  ],
  "blocks": [
    { "type": "post", "name": "t:sections.instagram.block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:components.feature_card.image" },
        { "type": "text", "id": "alt", "label": "t:sections.rich_text.alt" },
        { "type": "url", "id": "url", "label": "t:components.button.url" }
      ] },
    { "type": "@app" }
  ],
  "presets": [ { "name": "t:sections.instagram.name" } ]
}
{% endschema %}
