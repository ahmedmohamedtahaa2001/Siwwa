{%- comment -%}
  Section: siwa-preset-preview | Owner: A-00 | Task: SIWA theme foundation

  The design-review surface. One specimen sheet per design direction, rendered
  side by side on a single page, so the team can compare the five directions on
  identical components rather than on five separate screenshots.

  The point of this section is that it contains NO per-direction markup. Every
  specimen below is written once. Each block wraps its copy in its own
  `data-theme` scope, and the token layer in assets/siwa-themes.css does the
  rest — which is also the proof that the preset mechanism works, because if a
  direction needed its own markup, it would show up here first.

  Delete-safe: this section is a review tool, not a storefront surface. Nothing
  else in the theme depends on it.
{%- endcomment -%}

{{ 'siwa-preset-preview.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

{% style %}
  #shopify-section-{{ section.id }} .siwa-preview {
    padding-block-start: {{ s.padding_top }}px;
    padding-block-end: {{ s.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .siwa-preview__sheets {
    gap: {{ s.sheet_gap }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .siwa-preview {
      padding-block-start: {{ s.mobile_padding_top }}px;
      padding-block-end: {{ s.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="siwa-preview">
  <div class="siwa-container">
    {%- if s.heading != blank or s.intro != blank -%}
      <div class="siwa-preview__intro siwa-stack">
        {%- if s.heading != blank -%}
          <h2 class="siwa-h2">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.intro != blank -%}
          <div class="siwa-prose">{{ s.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div
    class="siwa-preview__sheets siwa-preview__sheets--{{ s.layout }}"
    {% if s.layout == 'row' %}role="region" aria-label="{{ s.heading | escape }}" tabindex="0"{% endif %}
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign preset = block.settings.preset
        assign is_live = false
        if preset == settings.theme_preset
          assign is_live = true
        endif
      -%}

      {%- comment -%}
        The scope. Everything inside this element resolves its tokens from this
        direction's block in siwa-themes.css, regardless of what the store's
        live setting is.
      {%- endcomment -%}
      <section
        class="siwa-preview__sheet"
        data-theme="{{ preset }}"
        aria-labelledby="preview-{{ block.id }}-title"
        {{ block.shopify_attributes }}
      >
        <header class="siwa-preview__head">
          <p class="siwa-label siwa-preview__eyebrow">
            {{ block.settings.label }}
            {%- if is_live %} · {{ s.live_label }}{% endif -%}
          </p>
          <h3 class="siwa-h3" id="preview-{{ block.id }}-title">{{ block.settings.title }}</h3>
          {%- if block.settings.note != blank -%}
            <p class="siwa-body-sm siwa-muted">{{ block.settings.note }}</p>
          {%- endif -%}
        </header>

        {%- comment -%} ── Type ─────────────────────────────────────────── {%- endcomment -%}
        <div class="siwa-preview__group">
          <p class="siwa-label siwa-preview__group-label">{{ s.label_type }}</p>
          <p class="siwa-h1">{{ s.specimen_display }}</p>
          <p class="siwa-body">{{ s.specimen_body }}</p>
          <p class="siwa-body-sm siwa-muted">{{ s.specimen_meta }}</p>
        </div>

        {%- comment -%}
          ── Buttons ───────────────────────────────────────────────────────
          Principle 7: the tester CTA has the same height, type size and
          footprint as the primary. It takes the outline treatment, never the
          gold fill, whenever another CTA shares the surface.

          siwa-lint-allow 14: a specimen sheet shows the gold CTA at rest, busy
          and disabled. Three golds on a review page is three states of one
          button, not three competing calls to action in a storefront fold.
        {%- endcomment -%}
        <div class="siwa-preview__group">
          <p class="siwa-label siwa-preview__group-label">{{ s.label_buttons }}</p>
          <div class="siwa-cluster">
            <button class="siwa-button siwa-button--primary" type="button">{{ s.cta_primary }}</button>
            <button class="siwa-button siwa-button--tester" type="button">{{ s.cta_tester }}</button>
            <button class="siwa-button siwa-button--secondary" type="button">{{ s.cta_secondary }}</button>
            <button class="siwa-button siwa-button--quiet" type="button">{{ s.cta_quiet }}</button>
            <button class="siwa-button siwa-button--primary" type="button" aria-busy="true">
              {{ s.cta_primary }}
            </button>
            <button class="siwa-button siwa-button--primary" type="button" disabled>
              {{ s.cta_primary }}
            </button>
          </div>
        </div>

        {%- comment -%}
          ── Catalog stamps ────────────────────────────────────────────────
          Non-negotiable 1. These three grounds are never re-mapped by a
          direction — a stamp means the same thing in all five. Only the ink
          on them shifts, so the label still clears 4.5:1 on a dark page.
        {%- endcomment -%}
        <div class="siwa-preview__group">
          <p class="siwa-label siwa-preview__group-label">{{ s.label_badges }}</p>
          <div class="siwa-cluster">
            <span class="siwa-badge siwa-badge--original">{{ 'catalog.original' | t }}</span>
            <span class="siwa-badge siwa-badge--impression">{{ 'catalog.impression' | t }}</span>
            <span class="siwa-badge siwa-badge--verified">{{ 'catalog.verified' | t }}</span>
            <span class="siwa-badge siwa-badge--new">{{ 'catalog.new' | t }}</span>
            <span class="siwa-badge siwa-badge--sale">{{ 'catalog.sale' | t }}</span>
            <span class="siwa-badge siwa-badge--soldout">{{ 'catalog.sold_out' | t }}</span>
          </div>
        </div>

        {%- comment -%}
          ── Product card ──────────────────────────────────────────────────
          The price is ink and mono in every direction — principle 6, enforced
          in siwa-themes.css §7 rather than left to a component author.
        {%- endcomment -%}
        <div class="siwa-preview__group">
          <p class="siwa-label siwa-preview__group-label">{{ s.label_product }}</p>
          <ul class="siwa-grid siwa-preview__grid" role="list">
            <li class="siwa-card">
              <div class="siwa-card__media">
                <span class="siwa-badge siwa-badge--original siwa-badge--overlay">
                  {{- 'catalog.original' | t -}}
                </span>
                {{ 'product-1' | placeholder_svg_tag: 'siwa-preview__placeholder' }}
              </div>
              <div class="siwa-card__body">
                <span class="siwa-card__eyebrow">{{ s.card_family }}</span>
                <h4 class="siwa-card__title">
                  <a class="siwa-card__link" href="{{ routes.all_products_collection_url }}">
                    {{- s.card_title -}}
                  </a>
                </h4>
                <span class="siwa-card__price">
                  {{- s.card_price -}}
                  <span class="siwa-card__price-was">{{ s.card_price_was }}</span>
                </span>
              </div>
            </li>
            <li class="siwa-card">
              <div class="siwa-card__media">
                <span class="siwa-badge siwa-badge--impression siwa-badge--overlay">
                  {{- 'catalog.impression' | t -}}
                </span>
                {{ 'product-2' | placeholder_svg_tag: 'siwa-preview__placeholder' }}
              </div>
              <div class="siwa-card__body">
                <span class="siwa-card__eyebrow">{{ s.card_family_alt }}</span>
                <h4 class="siwa-card__title">
                  <a class="siwa-card__link" href="{{ routes.all_products_collection_url }}">
                    {{- s.card_title_alt -}}
                  </a>
                </h4>
                <span class="siwa-card__price">{{ s.card_price_alt }}</span>
              </div>
            </li>
          </ul>
        </div>

        {%- comment -%}
          ── Size selector ─────────────────────────────────────────────────
          Native radios in a fieldset. The tester tile differs from the 50ml
          tile by a dashed border and nothing else — same height, same type,
          same padding. Selection carries three channels: border, ground and
          weight, so it survives greyscale.
        {%- endcomment -%}
        <div class="siwa-preview__group">
          <p class="siwa-label siwa-preview__group-label">{{ s.label_sizes }}</p>
          <fieldset class="siwa-preview__fieldset">
            <legend class="siwa-label">{{ 'product.size' | t }}</legend>
            <div class="siwa-sizes">
              <label class="siwa-size siwa-size--tester">
                <input
                  class="siwa-size__input"
                  type="radio"
                  name="preview-size-{{ block.id }}"
                  value="tester"
                  checked
                >
                <span class="siwa-size__body">
                  <span class="siwa-size__name">{{ s.size_tester_name }}</span>
                  <span class="siwa-size__price">{{ s.size_tester_price }}</span>
                </span>
              </label>
              <label class="siwa-size">
                <input
                  class="siwa-size__input"
                  type="radio"
                  name="preview-size-{{ block.id }}"
                  value="50ml"
                >
                <span class="siwa-size__body">
                  <span class="siwa-size__name">{{ s.size_full_name }}</span>
                  <span class="siwa-size__price">{{ s.size_full_price }}</span>
                </span>
              </label>
            </div>
          </fieldset>
        </div>

        {%- comment -%}
          ── Meter ─────────────────────────────────────────────────────────
          The numeric label is mandatory. A bar alone encodes the value in
          length only, which fails SC 1.4.1 and principle 2.
        {%- endcomment -%}
        <div class="siwa-preview__group">
          <p class="siwa-label siwa-preview__group-label">{{ s.label_meter }}</p>
          <div class="siwa-meter" style="--meter-value: {{ s.meter_percent }}%">
            <div class="siwa-meter__head">
              <span>{{ 'product.performance.longevity' | t }}</span>
              <span class="siwa-meter__value">{{ s.meter_value }}</span>
            </div>
            <div
              class="siwa-meter__track"
              role="meter"
              aria-valuenow="{{ s.meter_hours }}"
              aria-valuemin="0"
              aria-valuemax="12"
              aria-valuetext="{{ s.meter_value }}"
              aria-label="{{ 'product.performance.longevity' | t }}"
            >
              <div class="siwa-meter__fill"></div>
            </div>
          </div>
        </div>

        {%- comment -%}
          ── Form ──────────────────────────────────────────────────────────
          The error state carries colour, an icon and specific text naming the
          expected format — never colour alone, never "Invalid input."
        {%- endcomment -%}
        <div class="siwa-preview__group">
          <p class="siwa-label siwa-preview__group-label">{{ s.label_form }}</p>
          <div class="siwa-field">
            <label class="siwa-field__label" for="preview-email-{{ block.id }}">
              {{ s.field_label }}
            </label>
            <input
              class="siwa-input"
              id="preview-email-{{ block.id }}"
              type="email"
              value="{{ s.field_value }}"
              aria-invalid="true"
              aria-describedby="preview-email-error-{{ block.id }}"
            >
            <span class="siwa-field__error" id="preview-email-error-{{ block.id }}">
              <span class="siwa-alert__icon" aria-hidden="true">!</span>
              {{ s.field_error }}
            </span>
          </div>
        </div>
      </section>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Design direction preview",
  "tag": "section",
  "class": "shopify-section--siwa-preset-preview",
  "settings": [
    { "type": "header", "content": "Intro" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design directions"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>The same components, rendered in each of the five design directions. Nothing below is styled per direction — every difference comes from the token layer.</p>"
    },
    {
      "type": "text",
      "id": "live_label",
      "label": "Live direction label",
      "info": "Appended to whichever direction is currently set in Theme settings.",
      "default": "currently live"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stack", "label": "Stacked (one direction per row)" },
        { "value": "row", "label": "Side by side (scrolls horizontally)" }
      ],
      "default": "stack"
    },

    { "type": "header", "content": "Group labels" },
    { "type": "text", "id": "label_type", "label": "Type group", "default": "Type" },
    { "type": "text", "id": "label_buttons", "label": "Buttons group", "default": "Buttons" },
    { "type": "text", "id": "label_badges", "label": "Stamps group", "default": "Catalog stamps" },
    { "type": "text", "id": "label_product", "label": "Product group", "default": "Product cards" },
    { "type": "text", "id": "label_sizes", "label": "Size group", "default": "Size selector" },
    { "type": "text", "id": "label_meter", "label": "Meter group", "default": "Performance" },
    { "type": "text", "id": "label_form", "label": "Form group", "default": "Form controls" },

    { "type": "header", "content": "Type specimen" },
    {
      "type": "text",
      "id": "specimen_display",
      "label": "Display line",
      "default": "Smoke over cold stone"
    },
    {
      "type": "textarea",
      "id": "specimen_body",
      "label": "Body line",
      "default": "Lasts six to eight hours on skin, longer on fabric. The saffron opens sharp and settles into a dry richness."
    },
    {
      "type": "text",
      "id": "specimen_meta",
      "label": "Meta line",
      "default": "Batch LOT-2025-0412 · verified before shipping"
    },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_primary", "label": "Primary", "default": "Add to bag" },
    { "type": "text", "id": "cta_tester", "label": "Tester", "default": "Try it first — 85 EGP" },
    { "type": "text", "id": "cta_secondary", "label": "Secondary", "default": "Size guide" },
    { "type": "text", "id": "cta_quiet", "label": "Quiet", "default": "Not now" },

    { "type": "header", "content": "Product cards" },
    { "type": "text", "id": "card_title", "label": "Original title", "default": "Oud Nights" },
    { "type": "text", "id": "card_family", "label": "Original family", "default": "Amber & Resin" },
    { "type": "text", "id": "card_price", "label": "Original price", "default": "980 EGP" },
    { "type": "text", "id": "card_price_was", "label": "Original compare-at price", "default": "1,220 EGP" },
    { "type": "text", "id": "card_title_alt", "label": "Impression title", "default": "Salt Flats No. 4" },
    { "type": "text", "id": "card_family_alt", "label": "Impression family", "default": "Mineral & Musk" },
    { "type": "text", "id": "card_price_alt", "label": "Impression price", "default": "410 EGP" },

    { "type": "header", "content": "Size selector" },
    { "type": "text", "id": "size_tester_name", "label": "Tester name", "default": "Tester 2ml" },
    { "type": "text", "id": "size_tester_price", "label": "Tester price", "default": "85 EGP" },
    { "type": "text", "id": "size_full_name", "label": "Full size name", "default": "50ml" },
    { "type": "text", "id": "size_full_price", "label": "Full size price", "default": "980 EGP" },

    { "type": "header", "content": "Performance meter" },
    { "type": "text", "id": "meter_value", "label": "Value label", "default": "6–8 hours" },
    {
      "type": "range",
      "id": "meter_percent",
      "label": "Fill",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 72
    },
    {
      "type": "range",
      "id": "meter_hours",
      "label": "Hours (accessible value)",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "h",
      "default": 7
    },

    { "type": "header", "content": "Form" },
    { "type": "text", "id": "field_label", "label": "Field label", "default": "Email" },
    { "type": "text", "id": "field_value", "label": "Field value", "default": "you@example" },
    {
      "type": "text",
      "id": "field_error",
      "label": "Field error",
      "default": "Email format is incorrect. Example: you@example.com"
    },

    { "type": "header", "content": "Layout & spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (mobile)",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "sheet_gap",
      "label": "Gap between directions",
      "min": 16, "max": 96, "step": 4, "unit": "px", "default": 48
    }
  ],
  "blocks": [
    {
      "type": "direction",
      "name": "Direction",
      "settings": [
        {
          "type": "select",
          "id": "preset",
          "label": "Design direction",
          "options": [
            { "value": "archive", "label": "Archive" },
            { "value": "oasis", "label": "Oasis Minimal" },
            { "value": "desert", "label": "Desert Bold" },
            { "value": "nocturne", "label": "Nocturne" },
            { "value": "papyrus", "label": "Papyrus Soft" }
          ],
          "default": "archive"
        },
        { "type": "text", "id": "label", "label": "Eyebrow", "default": "Direction" },
        { "type": "text", "id": "title", "label": "Title", "default": "Archive" },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Editorial field guide — serif display, hairline rules, gold foil."
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Design direction preview",
      "blocks": [
        { "type": "direction" },
        { "type": "direction" },
        { "type": "direction" },
        { "type": "direction" },
        { "type": "direction" }
      ]
    }
  ]
}
{% endschema %}
