{%- comment -%}
  Footer — 5 variants.

  Styles: ../component-library/css/components.css (.ftr and modifiers)

  Variants (footer_style):
    light    Four columns on canvas, hairline top rule.
    dark     Black Mesa ground, on-dark text. The default.
    minimal  One centred column — logo, key links, social, copyright.
    mega     Five columns; one carries an about block or blog posts.
    heritage Dark, one Cultural Accent rule, bilingual wordmark.

  ⚠ THE CONTACT LINKS ARE THE POINT OF THIS SECTION
  `00-OVERVIEW.md` §5 and anomaly 9: the live store prints its email
  address and WhatsApp number as PLAIN TEXT with no `mailto:`, `tel:` or
  `wa.me` anchor anywhere — a grep across every captured page returned
  zero. Its own copy tells customers to "reach out", then gives them
  nothing to tap. This section makes all three clickable.

  The real values ship as schema DEFAULTS (they are settings, so a
  merchant can change them) rather than being written into the markup.
{%- endcomment -%}
{%- liquid
  assign fs = section.settings.footer_style
  case fs
    when 'light'
      assign modifier = 'ftr--light'
    when 'minimal'
      assign modifier = 'ftr--center'
    when 'mega'
      assign modifier = 'ftr--mega'
    when 'heritage'
      assign modifier = 'ftr--heritage'
    else
      assign modifier = ''
  endcase

  assign accent_var = ''
  case section.settings.accent_color
    when 'palm-green'
      assign accent_var = '--accent-color:var(--palm-green)'
    when 'date-red'
      assign accent_var = '--accent-color:var(--date-red)'
    when 'date-yellow'
      assign accent_var = '--accent-color:var(--date-yellow)'
    when 'desert-brown'
      assign accent_var = '--accent-color:var(--desert-brown)'
  endcase
-%}
<footer class="ftr {{ modifier }}"
  style="{% if section.settings.background_color != blank %}background:{{ section.settings.background_color }};{% endif %}{{ accent_var }}">

  {%- if fs == 'heritage' -%}
    <span class="ftr__rule" aria-hidden="true"></span>
  {%- endif -%}

  <div class="ftr__grid">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- case block.type -%}

          {%- when 'link_list' -%}
            {%- if block.settings.heading != blank -%}
              <h4>{{ block.settings.heading }}</h4>
            {%- endif -%}
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>

          {%- when 'text' -%}
            {%- if block.settings.heading != blank -%}
              <h4>{{ block.settings.heading }}</h4>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="rte">{{ block.settings.body }}</div>
            {%- endif -%}

          {%- when 'contact' -%}
            {%- comment -%}
              The gap this section exists to close. Each line renders only
              if its value is set, and each is a real anchor.
            {%- endcomment -%}
            {%- if block.settings.heading != blank -%}
              <h4>{{ block.settings.heading }}</h4>
            {%- endif -%}
            <div class="ftr__contact">
              {%- if block.settings.email != blank -%}
                <a href="mailto:{{ block.settings.email }}">
                  {%- render 'icon', name: 'mail' -%}
                  {{ block.settings.email }}
                </a>
              {%- endif -%}
              {%- if block.settings.phone != blank -%}
                {%- comment -%}
                  tel: must be digits only. The displayed value keeps its
                  spaces; the href is stripped.
                {%- endcomment -%}
                {%- assign tel = block.settings.phone
                  | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
                <a href="tel:{{ tel }}">
                  {%- render 'icon', name: 'phone' -%}
                  {{ block.settings.phone }}
                </a>
              {%- endif -%}
              {%- if block.settings.whatsapp_url != blank -%}
                <a href="{{ block.settings.whatsapp_url }}" rel="noopener" target="_blank">
                  {%- render 'icon', name: 'whatsapp' -%}
                  {{ block.settings.whatsapp_label | default: block.settings.phone }}
                  <span class="visually-hidden">{{ 'general.accessibility.opens_new_window' | t }}</span>
                </a>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            {%- if block.settings.heading != blank -%}
              <h4>{{ block.settings.heading }}</h4>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="rte">{{ block.settings.body }}</div>
            {%- endif -%}
            {%- form 'customer', class: 'news' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="news__row">
                {%- render 'input',
                  id: 'FooterEmail-' | append: section.id,
                  name: 'contact[email]',
                  type: 'email',
                  label: block.settings.label | default: 'general.newsletter.label' | t,
                  placeholder: block.settings.placeholder,
                  input_style: 'dark',
                  required: true,
                  autocomplete: 'email' -%}
                {%- render 'button',
                  label: block.settings.button_label | default: 'general.newsletter.submit' | t,
                  style: 'primary', type: 'submit' -%}
              </div>
              {%- if form.errors -%}
                <p class="field__err">{{ form.errors.messages.email }}</p>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <p class="field__hint">{{ 'general.newsletter.success' | t }}</p>
              {%- endif -%}
            {%- endform -%}

          {%- when 'trust_badge' -%}
            {%- render 'feature-card',
              style: 'icon',
              icon: block.settings.icon,
              heading: block.settings.heading,
              body: block.settings.body -%}

          {%- when 'social' -%}
            {%- if block.settings.heading != blank -%}
              <h4>{{ block.settings.heading }}</h4>
            {%- endif -%}
            <div class="social">
              {%- if block.settings.instagram != blank -%}
                <a href="{{ block.settings.instagram }}" rel="noopener" target="_blank" aria-label="Instagram">
                  {%- render 'icon', name: 'instagram' -%}
                </a>
              {%- endif -%}
              {%- if block.settings.facebook != blank -%}
                <a href="{{ block.settings.facebook }}" rel="noopener" target="_blank" aria-label="Facebook">
                  {%- render 'icon', name: 'facebook' -%}
                </a>
              {%- endif -%}
              {%- if block.settings.tiktok != blank -%}
                <a href="{{ block.settings.tiktok }}" rel="noopener" target="_blank" aria-label="TikTok">
                  {%- render 'icon', name: 'tiktok' -%}
                </a>
              {%- endif -%}
              {%- if block.settings.whatsapp != blank -%}
                <a href="{{ block.settings.whatsapp }}" rel="noopener" target="_blank" aria-label="WhatsApp">
                  {%- render 'icon', name: 'whatsapp' -%}
                </a>
              {%- endif -%}
            </div>

        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="ftr__base">
    <span>
      {%- comment -%}
        Copyright in both scripts. The Arabic wordmark is a setting, not
        a literal — the bottles carry it and the site should too.
      {%- endcomment -%}
      {%- comment -%}
        Brand lockup, not doubled content — the same sanctioned exception
        as the header wordmark.
      {%- endcomment -%}
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
      {%- if section.settings.wordmark_ar != blank -%}
        <span lang="ar" dir="rtl"> · {{ section.settings.wordmark_ar }}</span>
      {%- endif -%}
      
    </span>

    {%- if section.settings.show_payment_icons -%}
      <span class="ftr__pay">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'ftr__pay-icon' }}
        {%- endfor -%}
      </span>
    {%- endif -%}

    <span>{{ powered_by_link }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "shopify-section--footer",
  "settings": [
    {
      "type": "select",
      "id": "footer_style",
      "label": "t:sections.footer.style",
      "default": "dark",
      "options": [
        { "value": "light", "label": "t:sections.footer.style_light" },
        { "value": "dark", "label": "t:sections.footer.style_dark" },
        { "value": "minimal", "label": "t:sections.footer.style_minimal" },
        { "value": "mega", "label": "t:sections.footer.style_mega" },
        { "value": "heritage", "label": "t:sections.footer.style_heritage" }
      ]
    },
    { "type": "color", "id": "background_color", "label": "t:settings_schema.colors_chrome.color_surface_dark" },
    {
      "type": "select",
      "id": "accent_color",
      "label": "t:components.accent.label",
      "default": "none",
      "info": "t:sections.footer.accent_info",
      "options": [
        { "value": "none", "label": "t:components.accent.none" },
        { "value": "palm-green", "label": "t:components.accent.palm_green" },
        { "value": "date-red", "label": "t:components.accent.date_red" },
        { "value": "date-yellow", "label": "t:components.accent.date_yellow" },
        { "value": "desert-brown", "label": "t:components.accent.desert_brown" }
      ]
    },
    { "type": "text", "id": "wordmark_ar", "label": "t:sections.footer.wordmark_ar", "default": "سيوة", "info": "t:sections.footer.wordmark_info" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:sections.footer.payment_icons", "default": false, "info": "t:sections.footer.payment_icons_info" }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "t:sections.footer.block_menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
        { "type": "link_list", "id": "menu", "label": "t:sections.header.main_menu" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.block_text",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
        { "type": "richtext", "id": "body", "label": "t:components.feature_card.body" }
      ]
    },
    {
      "type": "contact",
      "name": "t:sections.footer.block_contact",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "t:sections.footer.contact_info" },
        { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
        { "type": "text", "id": "email", "label": "t:sections.footer.email", "default": "contact@siwafragrances.com" },
        { "type": "text", "id": "phone", "label": "t:sections.footer.phone", "default": "+20 106 625 0757" },
        { "type": "url", "id": "whatsapp_url", "label": "t:sections.footer.whatsapp" },
        { "type": "text", "id": "whatsapp_label", "label": "t:sections.footer.whatsapp_label" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.block_newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
        { "type": "richtext", "id": "body", "label": "t:components.feature_card.body" },
        { "type": "text", "id": "label", "label": "t:components.input.label" },
        { "type": "text", "id": "placeholder", "label": "t:components.input.placeholder" },
        { "type": "text", "id": "button_label", "label": "t:components.button.label" }
      ]
    },
    {
      "type": "trust_badge",
      "name": "t:sections.footer.block_trust",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "t:components.feature_card.icon", "default": "check",
          "options": [
            { "value": "check", "label": "t:components.icon.check" },
            { "value": "heart", "label": "t:components.icon.heart" },
            { "value": "leaf", "label": "t:components.icon.leaf" }
          ]
        },
        { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
        { "type": "text", "id": "body", "label": "t:components.feature_card.body" }
      ]
    },
    {
      "type": "social",
      "name": "t:sections.footer.block_social",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
        { "type": "url", "id": "instagram", "label": "Instagram" },
        { "type": "url", "id": "facebook", "label": "Facebook" },
        { "type": "url", "id": "tiktok", "label": "TikTok" },
        { "type": "url", "id": "whatsapp", "label": "WhatsApp" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
