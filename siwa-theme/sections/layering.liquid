{%- comment -%}
  Layering / bundle builder section. Hosts the layering-picker module.
  Layering Vanilla is the most-reviewed product on the store (98 @ 5.00★)
  with no layering guidance anywhere — this is that gap.
{%- endcomment -%}
<div class="section {% if section.settings.color_scheme == 'tonal' %}section--tonal{% endif %}">
  <div class="section__inner">
    {%- render 'layering-picker',
      base_collection: section.settings.base_collection,
      partner_collection: section.settings.partner_collection,
      picker_style: section.settings.picker_style,
      blocks: section.blocks,
      heading: section.settings.heading,
      cta_label: section.settings.cta_label,
      bundle_discount: section.settings.bundle_discount,
      show_descriptions: section.settings.show_descriptions,
      section_id: section.id -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.layering.name",
  "settings": [
    { "type": "select", "id": "picker_style", "label": "t:components.layering.style", "default": "steps",
      "options": [
        { "value": "steps", "label": "t:components.layering.style_steps" },
        { "value": "dropdown", "label": "t:components.layering.style_dropdown" },
        { "value": "quiz", "label": "t:components.layering.style_quiz" },
        { "value": "grid", "label": "t:components.layering.style_grid" },
        { "value": "guided", "label": "t:components.layering.style_guided" }
      ] },
    { "type": "text", "id": "heading", "label": "t:components.layering.heading" },
    { "type": "collection", "id": "base_collection", "label": "t:components.layering.base_collection" },
    { "type": "collection", "id": "partner_collection", "label": "t:components.layering.partner_collection" },
    { "type": "text", "id": "cta_label", "label": "t:components.button.label" },
    { "type": "range", "id": "bundle_discount", "min": 0, "max": 50, "step": 5, "unit": "%", "label": "t:components.layering.discount", "default": 0, "info": "t:components.layering.discount_info" },
    { "type": "checkbox", "id": "show_descriptions", "label": "t:components.layering.show_descriptions", "default": false },
    { "type": "select", "id": "color_scheme", "label": "t:sections.general.color_scheme", "default": "canvas",
      "options": [
        { "value": "canvas", "label": "t:sections.general.scheme_canvas" },
        { "value": "tonal", "label": "t:sections.general.scheme_tonal" }
      ] }
  ],
  "blocks": [
    { "type": "partner", "name": "t:components.layering.partner_block", "limit": 8,
      "settings": [
        { "type": "product", "id": "partner_product", "label": "t:components.layering.partner_product" },
        { "type": "text", "id": "layering_reason", "label": "t:components.layering.reason", "info": "t:components.layering.reason_info" }
      ] }
  ],
  "presets": [ { "name": "t:sections.layering.name" } ]
}
{% endschema %}
