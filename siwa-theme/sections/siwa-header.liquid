{%- comment -%}
  Section: siwa-header | Owner: A-02 | Task: ST-02

  G-01 SiteNav. "Get to any category in one gesture, on any device, in either
  language" — DESIGN.md §3.6.

  THE SECTION WRAPPER IS THE NAV.
  The schema sets tag: "header" and class: "siwa-nav", so Shopify renders
  <header id="shopify-section-…" class="shopify-section siwa-nav">. Two
  things depend on that and would break if a wrapper were added inside:
    1. `position: sticky` needs a containing block taller than itself. A nav
       stuck inside a wrapper exactly its own height never travels.
    2. .siwa-megamenu is absolutely positioned against .siwa-nav with
       `inset-inline: 0`. That is what makes it full-bleed. Any positioned
       element between the two re-anchors it to a single menu item.
  Nothing between .siwa-nav and .siwa-megamenu sets `position`.

  BEHAVIOUR comes entirely from assets/siwa-theme.js. There is no script in
  this file and there must not be one:
    · data-siwa-toggle  — mega menus and the search panel. The script owns
                          aria-expanded on the trigger and [hidden] on the
                          panel.
    · data-siwa-drawer  — the ≤1200px link list. .is-open, the scrim, the
                          focus trap, the scroll lock, Escape, focus restore.
    · data-siwa-close   — the drawer head and the search panel's close.
    · data-siwa-panel   — on every panel root so data-siwa-close finds it.
  Everything degrades: the mega-menu trigger's destination is also the first
  link inside the panel, and the search trigger is an <a> to the search page
  that the script intercepts, so neither is a dead end without JavaScript.

  COPY. Every visible string is a locale key or a schema setting. The nav
  labels themselves come from the merchant's link list — Siwa Originals,
  Siwa Impressions, Try First and The Oracle are shipped as the mega-menu
  column-heading defaults, not typed into the markup.
{%- endcomment -%}

{{ 'siwa-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign menu = linklists[s.menu]

  assign nav_panel_id = 'siwa-nav-menu-' | append: section.id
  assign search_panel_id = 'siwa-nav-search-' | append: section.id
  assign search_input_id = 'siwa-nav-q-' | append: section.id

  comment
    The number is decorative and aria-hidden; this string is the button's
    accessible name and the text the shared live region announces when the
    bag changes.
  endcomment
  assign bag_label = 'accessibility.bag_count' | t: count: cart.item_count

  assign logo = s.logo
  if logo == blank
    assign logo = settings.logo
  endif

  assign wordmark = settings.logo_wordmark
  if wordmark == blank
    assign wordmark = shop.name
  endif

  assign show_locale = false
  if settings.show_language_toggle and localization.available_languages.size > 1
    assign show_locale = true
  endif

-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --siwa-logo-width: {{ settings.logo_width }}px;
  }

  {%- comment -%}
    The section wrapper is .siwa-nav, so "don't stick" has to be expressed
    against the wrapper's own id rather than as a class on an inner element.
  {%- endcomment -%}
  {%- unless s.sticky -%}
    #shopify-section-{{ section.id }} { position: static; }
  {%- endunless -%}

  #shopify-section-{{ section.id }} .siwa-nav__inner {
    padding-block-start: {{ s.padding_top }}px;
    padding-block-end: {{ s.padding_bottom }}px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .siwa-nav__inner {
      padding-block-start: {{ s.mobile_padding_top }}px;
      padding-block-end: {{ s.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="siwa-container">
  <div class="siwa-nav__inner">
    <div class="siwa-nav__lead">
      {%- comment -%}
        The drawer trigger. Hidden above 1200px by siwa-header.css, because
        above that the link list is the navigation and this would open
        nothing.
      {%- endcomment -%}
      <button
        class="siwa-button siwa-button--icon siwa-nav__toggle"
        type="button"
        data-siwa-drawer="{{ nav_panel_id }}"
        aria-controls="{{ nav_panel_id }}"
        aria-expanded="false"
        aria-label="{{ 'accessibility.open_menu' | t }}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>

      <a class="siwa-nav__logo" href="{{ routes.root_url }}">
        {%- if logo != blank -%}
          {%- assign logo_alt = shop.name | escape -%}
          {{
            logo
            | image_url: width: 440
            | image_tag:
              class: 'siwa-nav__logo-image',
              alt: logo_alt,
              loading: 'eager',
              widths: '110, 165, 220, 330, 440',
              sizes: '(max-width: 768px) 40vw, 220px'
          }}
        {%- else -%}
          {{ wordmark }}
        {%- endif -%}
      </a>
    </div>

    <nav class="siwa-nav__primary" aria-label="{{ 'accessibility.primary_navigation' | t }}">
      <ul class="siwa-nav__list" id="{{ nav_panel_id }}" role="list" data-siwa-panel>
        <li class="siwa-nav__drawer-head">
          <button
            class="siwa-button siwa-button--icon"
            type="button"
            data-siwa-close
            aria-label="{{ 'accessibility.close_menu' | t }}"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
              <path d="M6 6 18 18M18 6 6 18" stroke-linecap="round"></path>
            </svg>
          </button>
        </li>

        {%- for link in menu.links -%}
          {%- liquid
            assign panel_id = 'siwa-mega-' | append: section.id | append: '-' | append: forloop.index

            assign has_columns = false
            assign item_title = link.title | strip | downcase
            for mega in section.blocks
              assign target = mega.settings.menu_item | strip | downcase
              if target != blank and target == item_title
                assign has_columns = true
                break
              endif
            endfor

            assign has_children = false
            if link.links.size > 0
              assign has_children = true
            endif
          -%}

          {%- if has_columns or has_children -%}
            <li class="siwa-nav__item">
              <button
                class="siwa-nav__link"
                type="button"
                data-siwa-toggle="{{ panel_id }}"
                aria-controls="{{ panel_id }}"
                aria-expanded="false"
              >
                {{ link.title }}
                {%- comment -%}
                  A chevron is a block-axis indicator. It rotates 180° when
                  open and is never mirrored in RTL — only inline-axis arrows
                  are (DESIGN.md §3.6, §5).
                {%- endcomment -%}
                <svg class="siwa-nav__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <path d="M6 9 12 15 18 9" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>

              <div class="siwa-megamenu" id="{{ panel_id }}" data-siwa-panel hidden>
                <div class="siwa-container">
                  {%- comment -%}
                    The top-level item is a trigger, so its own destination
                    would otherwise be unreachable. It leads the panel
                    instead — no new copy, no dead end.
                  {%- endcomment -%}
                  <p class="siwa-megamenu__lead">
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </p>

                  <div class="siwa-megamenu__grid">
                    {%- if has_columns -%}
                      {%- for mega in section.blocks -%}
                        {%- assign target = mega.settings.menu_item | strip | downcase -%}
                        {%- if target == item_title -%}
                          {%- assign column = linklists[mega.settings.menu] -%}
                          <div class="siwa-megamenu__col" {{ mega.shopify_attributes }}>
                            {%- if mega.settings.heading != blank -%}
                              <p class="siwa-megamenu__title">{{ mega.settings.heading }}</p>
                            {%- endif -%}
                            {%- if column.links.size > 0 -%}
                              <ul class="siwa-megamenu__links" role="list">
                                {%- for child in column.links -%}
                                  <li>
                                    <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                                      {{- child.title -}}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- else -%}
                      {%- comment -%}
                        No mega-menu block claims this item, so its own child
                        links become the panel. A merchant who has not opened
                        the Customizer still gets a working second level.
                      {%- endcomment -%}
                      <div class="siwa-megamenu__col">
                        <ul class="siwa-megamenu__links" role="list">
                          {%- for child in link.links -%}
                            <li>
                              <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                                {{- child.title -}}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </li>
          {%- else -%}
            <li class="siwa-nav__item">
              <a
                class="siwa-nav__link"
                href="{{ link.url }}"
                {%- if link.current %} aria-current="page"{% endif %}
              >
                {{- link.title -}}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="siwa-nav__actions">
      {%- if s.show_search -%}
        {%- comment -%}
          An anchor, not a button. With JavaScript the script intercepts the
          click and opens the panel; without it, the same control navigates
          to the search page. Search is never behind a script.
        {%- endcomment -%}
        <a
          class="siwa-button siwa-button--icon siwa-nav__action"
          href="{{ routes.search_url }}"
          data-siwa-toggle="{{ search_panel_id }}"
          aria-controls="{{ search_panel_id }}"
          aria-expanded="false"
          aria-label="{{ 'general.search.label' | t }}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="6"></circle>
            <path d="M15.5 15.5 20 20" stroke-linecap="round"></path>
          </svg>
        </a>
      {%- endif -%}

      {%- if s.show_account and shop.customer_accounts_enabled -%}
        <a
          class="siwa-button siwa-button--icon siwa-nav__action"
          href="{{ routes.account_url }}"
          aria-label="{{ 'accessibility.account' | t }}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <circle cx="12" cy="8" r="3.5"></circle>
            <path d="M5 20c0-3.6 3.1-5.5 7-5.5s7 1.9 7 5.5" stroke-linecap="round"></path>
          </svg>
        </a>
      {%- endif -%}

      {%- comment -%}
        The count sits inside the button because .siwa-nav__count is
        absolutely positioned and .siwa-button is the only relative ancestor
        the design system guarantees. The number is decorative; the accessible
        name is accessibility.bag_count, and the sr-only twin is the hook the
        shared live region reads when the bag changes.
      {%- endcomment -%}
      <a
        class="siwa-button siwa-button--icon siwa-nav__action siwa-nav__bag"
        href="{{ routes.cart_url }}"
        aria-label="{{ bag_label }}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
          <path d="M5 7h14l-1 13H6L5 7Z" stroke-linejoin="round"></path>
          <path d="M9 7a3 3 0 0 1 6 0" stroke-linecap="round"></path>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="siwa-nav__count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
        <span class="sr-only" data-siwa-announce="polite">{{ bag_label }}</span>
      </a>

      {%- if show_locale -%}
        {%- form 'localization', class: 'siwa-nav__locale' -%}
          <fieldset class="siwa-nav__locale-set">
            <legend class="sr-only">{{ 'general.language.label' | t }}</legend>
            {%- for language in localization.available_languages -%}
              <button
                class="siwa-button siwa-button--sm siwa-button--quiet siwa-nav__locale-option"
                type="submit"
                name="locale_code"
                value="{{ language.iso_code }}"
                {%- if language.iso_code == localization.language.iso_code %} aria-current="true"{% endif %}
              >
                <span lang="{{ language.iso_code }}">{{ language.endonym_name }}</span>
              </button>
            {%- endfor -%}
          </fieldset>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</div>

{%- if s.show_search -%}
  {%- comment -%}
    The search panel borrows .siwa-megamenu for its full-bleed anchoring,
    its shadow and its ≤1200px flattening. It is a sibling of the container
    and a direct child of .siwa-nav, so nothing positioned sits between it
    and its containing block.
  {%- endcomment -%}
  <div class="siwa-megamenu siwa-nav__search" id="{{ search_panel_id }}" data-siwa-panel hidden>
    <div class="siwa-container">
      <form class="siwa-nav__search-form" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <div class="siwa-field siwa-nav__search-field">
          <label class="siwa-field__label" for="{{ search_input_id }}">
            {{- 'general.search.label' | t -}}
          </label>
          <div class="siwa-nav__search-row">
            <input
              class="siwa-input"
              id="{{ search_input_id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.placeholder' | t }}"
              autocomplete="off"
            >
            <button class="siwa-button siwa-button--secondary" type="submit">
              {{- 'general.search.label' | t -}}
            </button>
          </div>
        </div>
        <button
          class="siwa-button siwa-button--icon siwa-nav__search-close"
          type="button"
          data-siwa-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <path d="M6 6 18 18M18 6 6 18" stroke-linecap="round"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "siwa-nav",
  "settings": [
    {
      "type": "header",
      "content": "Identity"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the logo in Theme settings → Brand, then to the wordmark set there. Its width follows the Brand → Logo width setting so the header and the footer can never drift apart."
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary menu",
      "info": "The store's spine: Siwa Originals, Siwa Impressions, Try First and The Oracle. Add a mega-menu column block below and point it at one of these items to give it a panel; an item with child links gets a panel automatically.",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show the account link",
      "info": "Only appears when customer accounts are enabled for the store.",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout & spacing"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Keep the header on screen while scrolling",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "mega_column",
      "name": "Mega menu column",
      "settings": [
        {
          "type": "paragraph",
          "content": "One column of a mega menu. Every column pointing at the same top-level item is grouped into that item's panel, four across. Below 1200px the panel flattens into the mobile drawer on its own."
        },
        {
          "type": "text",
          "id": "menu_item",
          "label": "Top-level menu item",
          "info": "Matched against the title of an item in the primary menu, ignoring case.",
          "default": "Shop"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Siwa Originals"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Links"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "default": {
    "blocks": [
      {
        "type": "mega_column",
        "settings": { "heading": "Siwa Originals" }
      },
      {
        "type": "mega_column",
        "settings": { "heading": "Siwa Impressions" }
      },
      {
        "type": "mega_column",
        "settings": { "heading": "Try First" }
      },
      {
        "type": "mega_column",
        "settings": { "heading": "The Oracle" }
      }
    ]
  },
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "mega_column",
          "settings": { "heading": "Siwa Originals" }
        },
        {
          "type": "mega_column",
          "settings": { "heading": "Siwa Impressions" }
        },
        {
          "type": "mega_column",
          "settings": { "heading": "Try First" }
        },
        {
          "type": "mega_column",
          "settings": { "heading": "The Oracle" }
        }
      ]
    }
  ]
}
{% endschema %}
