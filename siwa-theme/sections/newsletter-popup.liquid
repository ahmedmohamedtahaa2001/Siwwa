{%- comment -%}
  Newsletter popup — 5 trigger styles.

  Uses a native <dialog>, so focus trapping, Escape-to-close and the
  backdrop are browser behaviour rather than hand-rolled JavaScript.

  ⚠ A POPUP INTERRUPTS. Exit-intent and scroll triggers are less hostile
  than an immediate one; `respect_close` remembers a dismissal so the
  same visitor is not asked twice.
{%- endcomment -%}
<dialog class="popup {% if section.settings.popup_style == 'bar' %}popup--bar{% endif %} {% if section.settings.image != blank %}popup--split{% endif %}"
  id="NewsletterPopup-{{ section.id }}"
  data-siwa-popup
  data-trigger="{{ section.settings.trigger }}"
  data-delay="{{ section.settings.delay_seconds | times: 1000 }}"
  data-scroll-percent="{{ section.settings.scroll_percent }}"
  data-remember="{{ section.settings.respect_close }}"
  data-storage-key="siwa:newsletter:{{ section.id }}"
  aria-labelledby="PopupHeading-{{ section.id }}">
  <div class="popup__inner">
    <button class="popup__close" type="button" data-siwa-popup-close
            aria-label="{{ 'general.accessibility.close' | t }}">
      {%- render 'icon', name: 'close' -%}
    </button>

    {%- if section.settings.image != blank -%}
      {%- render 'image-container', image: section.settings.image, ratio: '4x5', alt: '' -%}
    {%- endif -%}

    <div style="display:grid;gap:var(--sp-sm)">
      <h2 class="ccard__title" id="PopupHeading-{{ section.id }}">
        {{ section.settings.heading }}
        
      </h2>
      {%- if section.settings.body != blank -%}
        <div class="rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.popup_style == 'two_step' -%}
        <div data-popup-step="1">
          <div class="news__row">
            {%- render 'button', label: section.settings.yes_label, style: 'primary', id: 'PopupYes-' | append: section.id -%}
            {%- render 'button', label: section.settings.no_label, style: 'ghost', id: 'PopupNo-' | append: section.id -%}
          </div>
        </div>
      {%- endif -%}

      <div {% if section.settings.popup_style == 'two_step' %}data-popup-step="2" hidden{% endif %}>
        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="news__row">
            {%- render 'input', id: 'PopupEmail-' | append: section.id,
              name: 'contact[email]', type: 'email',
              label: 'general.newsletter.label' | t,
              placeholder: section.settings.placeholder,
              required: true, autocomplete: 'email' -%}
            {%- render 'button', label: section.settings.button_label | default: 'general.newsletter.submit' | t,
              style: 'primary', type: 'submit' -%}
          </div>
          {%- if form.posted_successfully? -%}
            <p class="field__hint" role="status">{{ 'general.newsletter.success' | t }}</p>
            {%- if section.settings.discount_code != blank -%}
              <p class="stamp">{{ section.settings.discount_code }}</p>
            {%- endif -%}
          {%- endif -%}
          {%- if form.errors -%}
            <p class="field__err" role="alert">{{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</dialog>

{% schema %}
{
  "name": "t:sections.newsletter_popup.name",
  "settings": [
    { "type": "select", "id": "popup_style", "label": "t:sections.newsletter_popup.style", "default": "modal",
      "options": [
        { "value": "modal", "label": "t:sections.newsletter_popup.style_modal" },
        { "value": "bar", "label": "t:sections.newsletter_popup.style_bar" },
        { "value": "two_step", "label": "t:sections.newsletter_popup.style_two_step" }
      ] },
    { "type": "select", "id": "trigger", "label": "t:sections.newsletter_popup.trigger", "default": "time",
      "options": [
        { "value": "time", "label": "t:sections.newsletter_popup.trigger_time" },
        { "value": "exit", "label": "t:sections.newsletter_popup.trigger_exit" },
        { "value": "scroll", "label": "t:sections.newsletter_popup.trigger_scroll" }
      ] },
    { "type": "range", "id": "delay_seconds", "min": 0, "max": 30, "step": 1, "unit": "s", "label": "t:sections.newsletter_popup.delay", "default": 5 },
    { "type": "range", "id": "scroll_percent", "min": 10, "max": 90, "step": 10, "unit": "%", "label": "t:sections.newsletter_popup.scroll_percent", "default": 50 },
    { "type": "checkbox", "id": "respect_close", "label": "t:sections.newsletter_popup.respect_close", "default": true, "info": "t:sections.newsletter_popup.respect_close_info" },
    { "type": "image_picker", "id": "image", "label": "t:components.feature_card.image" },
    { "type": "text", "id": "heading", "label": "t:components.feature_card.heading" },
    { "type": "richtext", "id": "body", "label": "t:components.feature_card.body" },
    { "type": "text", "id": "placeholder", "label": "t:components.input.placeholder" },
    { "type": "text", "id": "button_label", "label": "t:components.button.label" },
    { "type": "text", "id": "discount_code", "label": "t:sections.newsletter_popup.discount_code" },
    { "type": "text", "id": "yes_label", "label": "t:sections.newsletter_popup.yes_label" },
    { "type": "text", "id": "no_label", "label": "t:sections.newsletter_popup.no_label" }
  ],
  "enabled_on": { "groups": ["overlay"] }
}
{% endschema %}
