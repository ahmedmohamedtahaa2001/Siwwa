{%- comment -%}
  Star rating — display mode.

  Styles: ../component-library/css/components.css (.stars, .star-full,
  .star-empty, .rating-line)

  Renders five stars with a half-star where the average warrants it.
  Judge.me hydrates its own badge for product-level ratings — use
  `judgeme-preview-badge` there. This snippet is for ratings that come
  from a review object or an aggregate figure.

  Accepts:
    rating     {Number}  0–5, may be fractional (e.g. 4.98)
    count      {Number}  optional review count, rendered beside the stars
    show_count {Boolean} default true when `count` is given
    size       {String}  'featured' renders large stars
    class      {String}

  Accessibility: the stars are decorative (aria-hidden) and the rating is
  announced once, as text, via a visually hidden label. Otherwise a
  screen reader reads five separate images.
{%- endcomment -%}
{%- liquid
  assign r = rating | default: 0 | times: 1.0
  assign size_class = ''
  if size == 'featured' or size == 'carousel'
    assign size_class = 'stars--lg'
  endif
  assign do_count = show_count
  if show_count == nil and count != blank
    assign do_count = true
  endif
  assign label = 'general.accessibility.star_rating' | t: rating: rating, rating_max: 5
-%}
<span class="rating-line {{ class }}">
  <span class="stars {{ size_class }}" role="img" aria-label="{{ label | escape }}">
    {%- for i in (1..5) -%}
      {%- liquid
        assign threshold = i | minus: 0.5
        if r >= i
          assign star_class = 'star-full'
        elsif r >= threshold
          assign star_class = 'star-full'
        else
          assign star_class = 'star-empty'
        endif
      -%}
      <svg viewBox="0 0 24 24" class="{{ star_class }}" aria-hidden="true" focusable="false">
        <path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4 6.2 20.5l1.1-6.5L2.6 9.4l6.5-.9z"/>
      </svg>
    {%- endfor -%}
  </span>
  {%- if do_count -%}
    <span class="count">{{ 'products.reviews.count' | t: count: count }}</span>
  {%- endif -%}
</span>
