{%- comment -%}
  Feature card — 5 variants. USPs, service promises, "how it works"
  steps, and heritage blocks.

  Styles: ../component-library/css/components.css (.fcard, .usp__i, .iwt)

  Variants (the `style` argument):
    icon      .usp__i           Icon above, heading, two lines. The existing
                                USP tile — "14-day return", "Support 24/7".
    split     .iwt              Image one side, text the other. Reverses
                                with `reverse`, stacks on mobile.
    overlay   .fcard--overlay   Full-bleed image, dark scrim, serif heading.
    step      .fcard--step      Large number in gold, heading, body.
    heritage  .fcard--heritage  Arabic + Latin heading at EQUAL weight,
                                pull-quote body, one Cultural Accent rule,
                                provenance line. HERITAGE ONLY.

  ONE LANGUAGE AT A TIME
  There is no parallel `heading_ar` field, and there was one until
  2026-08-13. It was wrong: a bilingual store shows English to English
  visitors and Arabic to Arabic visitors, and rendering both at once
  produces a page in two languages simultaneously.

  Content is translated under Settings → Languages (Translate & Adapt),
  which is Shopify's own mechanism. What the theme still does per-locale:
  direction, type family, numerals and layout mirroring — all driven from
  `request.locale` in layout/theme.liquid.

  BENCHMARK.md Part 2 §4's point stands — the bottles carry Arabic and the
  site should too — but it is answered by a properly translated Arabic
  storefront, not by doubling every heading.

  ⚠ TWO-REGISTER NOTE
  `heritage` and `accent_color` are for genuine Siwan content — the
  oasis, Amazigh identity, Kershef architecture, the Sunburst motif,
  named cooperatives. Not for dressing up a dupe.

  Accepts:
    heading       {String}
    body          {String}   richtext
    image         {Image}
    icon          {String}   glyph name for the icon variant
    number        {String}   "01", "02" — step variant
    provenance    {String}   e.g. "Sourced from Siwa Oasis"
    cta_label     {String}
    cta_url       {String}
    style         {String}   icon | split | overlay | step | heritage
    reverse       {Boolean}  split variant — image on the other side
    accent_color  {String}   heritage variant only
    scrim_opacity {Number}   overlay variant, 0–80, default 45
    heading_tag   {String}   h2 | h3, default h3
{%- endcomment -%}
{%- liquid
  assign fc_style = style | default: 'icon'
  assign tag = heading_tag | default: 'h3'

  assign accent_var = ''
  case accent_color
    when 'palm-green'
      assign accent_var = '--accent-color:var(--palm-green)'
    when 'date-red'
      assign accent_var = '--accent-color:var(--date-red)'
    when 'date-yellow'
      assign accent_var = '--accent-color:var(--date-yellow)'
    when 'desert-brown'
      assign accent_var = '--accent-color:var(--desert-brown)'
  endcase
-%}
{%- capture heading_markup -%}
  {%- if heading != blank -%}
    <{{ tag }} class="fcard__heading">
      {%- if heading != blank -%}<span lang="{{ request.locale.iso_code }}">{{ heading }}</span>{%- endif -%}
      
    </{{ tag }}>
  {%- endif -%}
{%- endcapture -%}
{%- capture body_markup -%}
  {%- if body != blank -%}<div class="fcard__body rte">{{ body }}</div>{%- endif -%}
  
{%- endcapture -%}
{%- capture cta_markup -%}
  {%- if cta_label != blank -%}
    {%- render 'button', label: cta_label, url: cta_url, style: 'ghost',
      icon: 'arrow-right', icon_is_directional: true -%}
  {%- endif -%}
{%- endcapture -%}

{%- case fc_style -%}

  {%- when 'icon' -%}
    <div class="usp__i {{ class }}">
      {%- if icon != blank -%}{%- render 'icon', name: icon -%}{%- endif -%}
      {%- if heading != blank -%}<b>{{ heading }}</b>{%- endif -%}
      
      {%- if body != blank -%}<span>{{ body | strip_html }}</span>{%- endif -%}
      {{ cta_markup }}
    </div>

  {%- when 'split' -%}
    <div class="iwt {% if reverse %}iwt--rev{% endif %} {{ class }}">
      {%- render 'image-container', image: image, ratio: '4x5',
        sizes: '(min-width: 750px) 50vw, 100vw', alt: heading -%}
      <div class="fcard">
        {{ heading_markup }}
        {{ body_markup }}
        {{ cta_markup }}
      </div>
    </div>

  {%- when 'overlay' -%}
    <div class="fcard fcard--overlay {{ class }}">
      {%- render 'image-container', image: image, ratio: '16x9',
        scrim_opacity: scrim_opacity | default: 45, sizes: '100vw', alt: heading -%}
      <div class="fcard__body-wrap">
        {{ heading_markup }}
        {{ body_markup }}
        {{ cta_markup }}
      </div>
    </div>

  {%- when 'step' -%}
    <div class="fcard fcard--step {{ class }}">
      {%- if number != blank -%}
        <span class="fcard__num" aria-hidden="true">{{ number }}</span>
      {%- endif -%}
      <div class="fcard">
        {{ heading_markup }}
        {{ body_markup }}
        {{ cta_markup }}
      </div>
    </div>

  {%- when 'heritage' -%}
    <div class="fcard fcard--heritage vintage-surface {{ class }}"
      {% if accent_var != blank %}style="{{ accent_var }}"{% endif %}>
      <span class="edge-wear" aria-hidden="true"></span>
      <span class="fcard__rule" aria-hidden="true"></span>
      {{ heading_markup }}
      {{ body_markup }}
      {%- if provenance != blank -%}
        <span class="pcard__provenance">{{ provenance }}</span>
      {%- endif -%}
      {%- if image != blank -%}
        {%- render 'image-container', image: image, ratio: '3x4',
          sizes: '(min-width: 750px) 40vw, 100vw', alt: heading -%}
      {%- endif -%}
      {{ cta_markup }}
    </div>

{%- endcase -%}
