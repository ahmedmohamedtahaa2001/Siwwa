{%- comment -%}
  Price — range, sale and sold-out aware.

  Styles: ../component-library/css/components.css (.price, .was, .from)

  Currency formatting comes from the store's own money format, never
  from a string written here. The library's static prototype prints
  "LE 1,234" / "١٢٣٤ ج.م" by hand because it has no Shopify runtime;
  in the theme that is `money` filter territory and must stay so.

  Accepts:
    product         {Product}  required
    variant         {Variant}  optional. When given, prices that variant
                               instead of the product range.
    show_from       {Boolean}  default true. "From X" when variants differ.
    show_compare_at {Boolean}  default true. Struck-through original.

  Accessibility: the struck-through compare-at price is announced with a
  visually hidden label, otherwise a screen reader reads two numbers with
  no indication which one is payable.
{%- endcomment -%}
{%- liquid
  if variant != blank
    assign price = variant.price
    assign compare_at = variant.compare_at_price
    assign is_range = false
  else
    assign price = product.price_min
    assign compare_at = product.compare_at_price_max
    assign is_range = false
    if product.price_min != product.price_max
      assign is_range = true
    endif
  endif

  assign do_from = show_from
  if show_from == nil
    assign do_from = true
  endif

  assign do_compare = show_compare_at
  if show_compare_at == nil
    assign do_compare = true
  endif

  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif
-%}
<span class="price">
  {%- if is_range and do_from -%}
    <span class="from">{{ 'products.product.price_from' | t }}</span>
  {%- endif -%}

  <span class="price__current">{{ price | money }}</span>

  {%- if on_sale and do_compare -%}
    <s class="was">
      <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
      {{ compare_at | money }}
    </s>
  {%- endif -%}
</span>
