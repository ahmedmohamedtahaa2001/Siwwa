{%- comment -%}
  Collection card — 5 variants. Grid tiles linking to a collection.

  Styles: ../component-library/css/components.css (.ccard and modifiers)

  Variants (the `style` argument):
    overlay    .ccard--overlay    Full-bleed image, title over a scrim.
    split      .ccard--split      Image top, solid panel below with count + CTA.
    minimal    .ccard--minimal    Small square image, large title beneath.
    cinematic  .ccard--cinematic  16:9 or 21:9, centred title and tagline.
    heritage   .ccard--heritage   Vintage tile, embroidery rule in one
                                  Cultural Accent colour. HERITAGE ONLY.

  ⚠ TWO-REGISTER NOTE
  `heritage` and any `accent_color` belong to collections that are
  genuinely about Siwan heritage — the Originals, the Oasis collection.
  A collection of inspired-by dupes styled as heritage is a firewall
  breach. Unlike product-card this cannot be enforced in code — a
  collection has no vendor to test — so it is a merchant instruction,
  surfaced in the schema `info` text.
  Source: Planning/BENCHMARK.md Part 2 §5.

  ⚠ PRODUCT COUNTS ARE UNRELIABLE
  `05-COLLECTIONS.md` records `products_count` values that exceed the
  56-product catalogue (for-him 83, for-her 80, perfumes 82). Shopify's
  live `collection.products_count` will be correct, but do not port the
  captured figures. `show_count` defaults to false for that reason.

  Accepts:
    collection   {Collection}  required
    image        {Image}       overrides collection.image
    title        {String}      overrides collection.title
    description  {String}      short tagline
    style        {String}      overlay | split | minimal | cinematic | heritage
    show_count   {Boolean}     default false — see above
    cta_label    {String}
    accent_color {String}      heritage variant only
    scrim_opacity {Number}     0–80, overlay and cinematic variants
    ratio        {String}      overrides the per-variant default
    heading_tag  {String}      h2 | h3, default h3
{%- endcomment -%}
{%- liquid
  assign cc_style = style | default: 'overlay'

  case cc_style
    when 'split'
      assign modifier = 'ccard--split'
      assign default_ratio = '4x5'
      assign default_scrim = 0
    when 'minimal'
      assign modifier = 'ccard--minimal'
      assign default_ratio = '1x1'
      assign default_scrim = 0
    when 'cinematic'
      assign modifier = 'ccard--cinematic'
      assign default_ratio = '21x9'
      assign default_scrim = 45
    when 'heritage'
      assign modifier = 'ccard--heritage vintage-surface'
      assign default_ratio = '1x1'
      assign default_scrim = 0
    else
      assign modifier = 'ccard--overlay'
      assign default_ratio = '4x5'
      assign default_scrim = 40
  endcase

  assign cc_ratio = ratio | default: default_ratio
  assign cc_scrim = scrim_opacity | default: default_scrim
  assign cc_image = image | default: collection.image | default: collection.featured_image
  assign cc_title = title | default: collection.title
  assign tag = heading_tag | default: 'h3'

  assign accent_var = ''
  case accent_color
    when 'palm-green'
      assign accent_var = '--accent-color:var(--palm-green)'
    when 'date-red'
      assign accent_var = '--accent-color:var(--date-red)'
    when 'date-yellow'
      assign accent_var = '--accent-color:var(--date-yellow)'
    when 'desert-brown'
      assign accent_var = '--accent-color:var(--desert-brown)'
  endcase
-%}
<a
  class="ccard {{ modifier }} {{ class }}"
  href="{{ collection.url }}"
  {% if accent_var != blank %}style="{{ accent_var }}"{% endif %}
>
  {%- if cc_style == 'heritage' -%}
    <span class="edge-wear" aria-hidden="true"></span>
  {%- endif -%}

  {%- unless cc_style == 'heritage' and cc_image == blank -%}
    {%- render 'image-container',
      image: cc_image,
      ratio: cc_ratio,
      scrim_opacity: cc_scrim,
      sizes: '(min-width: 990px) 33vw, 100vw',
      alt: cc_title -%}
  {%- endunless -%}

  <div class="ccard__body">
    {%- if cc_style == 'heritage' -%}
      <span class="ccard__rule" aria-hidden="true"></span>
    {%- endif -%}

    <{{ tag }} class="ccard__title">
      {{ cc_title }}
      
    </{{ tag }}>

    {%- if description != blank -%}
      <p class="ccard__meta">{{ description }}</p>
    {%- endif -%}

    {%- if show_count and collection.products_count > 0 -%}
      <p class="ccard__meta">
        {{ 'collections.general.product_count' | t: count: collection.products_count }}
      </p>
    {%- endif -%}

    {%- if cta_label != blank -%}
      {%- comment -%}
        Rendered as a span, not a button or link: the whole card is
        already an <a>, and nesting an interactive element inside it
        would produce invalid markup and a confusing tab order.
      {%- endcomment -%}
      <span class="btn btn--tertiary" aria-hidden="true">{{ cta_label }}</span>
    {%- endif -%}
  </div>
</a>
