{%- comment -%}
  Product card — the default card, to client spec 2026-08-13.

  Styles: ../component-library/css/components.css (.pcd)

  Structure, top to bottom:
    badge          optional, over the image
    media          TWO images — the second replaces the first on hover
    sub            "Inspired by <house>" or the concentration
    title
    notes          accord line, clamped to three lines
    rating-line    flex, two children pushed apart: [stars] | [reviews]
    foot           price  ·  Add to bag / Notify me

  Used on Best selling, Inspired by, and any product rail.

  ⚠ TWO-REGISTER FIREWALL — enforced, not trusted to the caller.
  `authentic` badges carry the Cultural Accent Set and downgrade to
  `new` on any inspired-by product. Register resolves through
  product-register.liquid. Source: Planning/BENCHMARK.md Part 2 §5.

  ⚠ PRICE IS NEVER OPTIONAL.
  "Price?" / "بكام" is the single most repeated question across every
  Instagram post in the capture (instagram-assets/README.md). The price
  renders on every card, always.

  Accepts:
    product      {Product}  required
    show_badge   {Boolean}
    badge_type   {String}   auto | sale | new | best-seller | authentic
    show_notes   {Boolean}  default true
    cta_label    {String}
    heading_tag  {String}   h2 | h3, default h3
    index        {Number}   stagger index
{%- endcomment -%}
{%- liquid
  capture register_raw
    render 'product-register', product: product
  endcapture
  assign register = register_raw | strip
  assign is_original = false
  if register == 'original'
    assign is_original = true
  endif

  assign tag = heading_tag | default: 'h3'
  assign sold_out = false
  unless product.available
    assign sold_out = true
  endunless

  assign do_notes = show_notes
  if show_notes == nil
    assign do_notes = true
  endif

  comment  Second image drives the hover swap. Falls back to one image.  endcomment
  assign img_a = product.featured_image
  assign img_b = product.images[1]

  comment  Badge, with the firewall applied.  endcomment
  assign badge = badge_type | default: 'auto'
  if badge == 'auto'
    if product.compare_at_price > product.price
      assign badge = 'sale'
    elsif is_original
      assign badge = 'authentic'
    else
      assign badge = 'new'
    endif
  endif
  unless is_original
    if badge == 'authentic'
      assign badge = 'new'
    endif
  endunless

  case badge
    when 'sale'
      assign badge_class = 'pcd__badge--sale'
      assign badge_text = 'products.badges.sale' | t
    when 'authentic'
      assign badge_class = 'pcd__badge--auth'
      assign badge_text = 'products.badges.authentic' | t
    when 'best-seller'
      assign badge_class = ''
      assign badge_text = 'products.badges.best_seller' | t
    else
      assign badge_class = 'pcd__badge--new'
      assign badge_text = 'products.badges.new' | t
  endcase
  if sold_out
    assign badge_class = ''
    assign badge_text = 'products.badges.sold_out' | t
  endif

  assign accords = product.metafields.fragrance.accords
  if accords == blank
    assign accords = product.description | strip_html | truncatewords: 26
  endif
-%}
<article class="pcd {% if sold_out %}pcd--out{% endif %} {{ class }}"
         style="--i:{{ index | default: 0 }}"
         data-product-id="{{ product.id }}"
         data-register="{{ register }}">

  <a class="pcd__media {% unless img_b %}pcd__media--single{% endunless %}"
     href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if show_badge and badge_text != blank -%}
      <span class="pcd__badge {{ badge_class }}">{{ badge_text }}</span>
    {%- endif -%}

    {%- if img_a -%}
      {{ img_a | image_url: width: 800 | image_tag:
         class: 'pcd__img--a', loading: 'lazy',
         widths: '300, 450, 600, 800',
         sizes: '(min-width: 990px) 25vw, 50vw',
         alt: img_a.alt | default: product.title }}
      {%- if img_b -%}
        {{ img_b | image_url: width: 800 | image_tag:
           class: 'pcd__img--b', loading: 'lazy',
           widths: '300, 450, 600, 800',
           sizes: '(min-width: 990px) 25vw, 50vw',
           alt: img_b.alt | default: product.title }}
      {%- endif -%}
    {%- else -%}
      <span class="pcd__ph">{%- render 'icon', name: 'bottle' -%}</span>
    {%- endif -%}
  </a>

  <div class="pcd__body">
    <p class="pcd__sub">
      {%- if is_original -%}
        {{ product.metafields.fragrance.concentration | default: shop.name }}
      {%- elsif product.vendor != blank -%}
        {{ 'products.product.inspired_by' | t }} {{ product.vendor }}
      {%- endif -%}
    </p>

    <{{ tag }} class="pcd__title">
      <a href="{{ product.url }}" style="color:inherit;text-decoration:none">{{ product.title }}</a>
    </{{ tag }}>

    {%- if do_notes and accords != blank -%}
      <p class="pcd__notes">{{ accords }}</p>
    {%- endif -%}

    {%- comment -%}
      Rating line: exactly two children, pushed apart. Stars and score on
      one side, review count on the other.
    {%- endcomment -%}
    <div class="pcd__rating">
      <div>
        {%- render 'star-rating', rating: product.metafields.reviews.rating.value -%}
        {%- if product.metafields.reviews.rating.value != blank -%}
          <span class="pcd__score">{{ product.metafields.reviews.rating.value | round: 2 }}</span>
        {%- endif -%}
      </div>
      <div>
        {%- if product.metafields.reviews.rating_count != blank -%}
          <span class="pcd__count">
            {{ 'products.reviews.count' | t: count: product.metafields.reviews.rating_count }}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div class="pcd__foot">
      <span class="pcd__price">
        {%- if product.price_min != product.price_max -%}
          <small>{{ 'products.product.price_from' | t }}</small>
        {%- endif -%}
        {{ product.price_min | money }}
        {%- if product.compare_at_price_max > product.price_min -%}
          <s>{{ product.compare_at_price_max | money }}</s>
        {%- endif -%}
      </span>

      {%- if sold_out -%}
        {%- render 'button', label: 'products.product.notify_me' | t, style: 'minimal', size: 'sm' -%}
      {%- else -%}
        {%- render 'button',
          label: cta_label | default: 'products.product.add_to_cart' | t,
          style: 'minimal', size: 'sm' -%}
      {%- endif -%}
    </div>
  </div>
</article>
