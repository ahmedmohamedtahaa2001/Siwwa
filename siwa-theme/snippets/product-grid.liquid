{%- comment -%}
  Product grid — 5 variants. Renders a list of products as cards.

  Styles: ../component-library/css/components.css (.pgrid, .carousel, .tabs)
  Behaviour: assets/siwa-modules.js (carousel, tabs)

  Variants (the `grid_style` argument):
    standard  .pgrid              4 / 3 / 2 / 1 responsive. The default.
    compact   .pgrid--compact     6 / 4 / 3 / 2. Large catalogues.
    masonry   .pgrid--masonry     Varying heights. Progressive enhancement.
    carousel  .carousel           Single row, scroll-snap, arrow controls.
    tabbed    .tabs               Two or three collections behind tabs.

  ⚠ MASONRY IS PROGRESSIVE, NOT GUARANTEED
  `grid-template-rows: masonry` is not yet supported in most browsers.
  The `@supports not` fallback uses CSS columns, which reorders cards
  down-then-across rather than across-then-down. That reordering is
  visual only — DOM order, and therefore reading and tab order, is
  unchanged. Do not use masonry where rank matters (best sellers).

  ⚠ FILTERING AND SORTING LIVE IN THE SECTION, NOT HERE
  Faceted filtering needs `collection.filters` and the Section Rendering
  API for AJAX updates, both of which are section-level concerns. This
  snippet renders a grid of whatever it is handed. The Phase 4
  `main-collection` section wires the facets and re-renders this.

  Accepts:
    products      {Array}    required. Products to render.
    grid_style    {String}   standard | compact | masonry | carousel | tabbed
    columns       {Number}   2–6. Emitted as --grid-cols-desktop; the
                             stylesheet derives the responsive value, so
                             breakpoints still win over the inline value.
    card_style    {String}   passed through to product-card
    show_reviews  {Boolean}  passed through. Default true.
    show_vendor   {Boolean}  passed through.
    show_badge    {Boolean}  passed through.
    limit         {Number}   max products rendered
    heading_tag   {String}   heading level for the cards
    blocks        {Array}    tabbed variant: section.blocks, each with
                             settings.tab_label / collection
    section_id    {String}   required for tabbed and carousel — scopes ids
    empty_message {String}   shown when there is nothing to render
{%- endcomment -%}
{%- liquid
  assign gs = grid_style | default: 'standard'
  assign cols = columns | default: 4
  assign uid = section_id | default: 'grid'

  case gs
    when 'compact'
      assign grid_class = 'pgrid pgrid--compact'
    when 'masonry'
      assign grid_class = 'pgrid pgrid--masonry'
    else
      assign grid_class = 'pgrid'
  endcase

  assign do_reviews = show_reviews
  if show_reviews == nil
    assign do_reviews = true
  endif
-%}

{%- if gs == 'tabbed' and blocks != blank -%}
  {%- comment -%}
    Tabbed. Real ARIA tabs: roving tabindex, aria-controls, arrow-key
    navigation from siwa-modules.js. Panels are `hidden`, not
    visually-hidden, so inactive panels stay out of the tab order.
    Blocks — never a fixed {% for i in (1..3) %} loop (Law 3).
  {%- endcomment -%}
  <div class="tabs" data-siwa-tabs>
    <div class="tabs__list" role="tablist">
      {%- for block in blocks -%}
        <button
          class="tabs__tab"
          role="tab"
          type="button"
          id="{{ uid }}-tab-{{ block.id }}"
          aria-controls="{{ uid }}-panel-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.tab_label }}
          
        </button>
      {%- endfor -%}
    </div>

    {%- for block in blocks -%}
      <div
        class="tabs__panel"
        role="tabpanel"
        id="{{ uid }}-panel-{{ block.id }}"
        aria-labelledby="{{ uid }}-tab-{{ block.id }}"
        tabindex="0"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <div class="{{ grid_class }}" style="--grid-cols-desktop:{{ cols }}">
          {%- for product in block.settings.collection.products limit: limit -%}
            {%- render 'product-card',
              product: product,
              style: card_style,
              show_reviews: do_reviews,
              show_vendor: show_vendor,
              show_badge: show_badge,
              heading_tag: heading_tag -%}
          {%- else -%}
            <p class="pyramid__empty">{{ empty_message | default: '' }}</p>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

{%- elsif gs == 'carousel' -%}
  <div class="carousel-wrap" data-siwa-carousel>
    <div class="carousel carousel--cards" role="region" tabindex="0"
         aria-label="{{ 'collections.general.view_all' | t }}">
      {%- for product in products limit: limit -%}
        {%- render 'product-card',
          product: product,
          style: card_style,
          show_reviews: do_reviews,
          show_vendor: show_vendor,
          show_badge: show_badge,
          heading_tag: heading_tag -%}
      {%- endfor -%}
    </div>
    {%- render 'carousel-controls' -%}
  </div>

{%- else -%}
  <div class="{{ grid_class }}" style="--grid-cols-desktop:{{ cols }}">
    {%- for product in products limit: limit -%}
      {%- render 'product-card',
        product: product,
        style: card_style,
        show_reviews: do_reviews,
        show_vendor: show_vendor,
        show_badge: show_badge,
        heading_tag: heading_tag,
        reveal_index: forloop.index0 -%}
    {%- else -%}
      {%- if empty_message != blank -%}
        <p class="pyramid__empty">{{ empty_message }}</p>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
