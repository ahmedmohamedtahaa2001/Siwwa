{%- comment -%}
  Image container — responsive wrapper with aspect-ratio control.

  This is the Liquid transplant of the component library's existing
  `Image` primitive. It renders the SAME .pimg class the gallery uses —
  no second image convention is introduced.
  Styles: ../component-library/css/components.css (.pimg and modifiers)

  Ratios (the `ratio` argument) — the library ships 4:5, 1:1 and 16:9;
  3:4 and 21:9 are added here for editorial and cinematic use:
    4x5   portrait, product card default (matches the bottle proportion)
    16x9  landscape, hero and feature rows
    1x1   square, collection tiles and Instagram grid
    3x4   portrait, editorial and storytelling
    21x9  cinematic, ultra-wide oasis photography

  Aspect ratio is emitted as an inline value rather than one of five
  fixed classes, so a section can expose it as a free schema setting.

  Uses Shopify's image_tag filter, so srcset, sizes, width, height and
  loading are generated — no fixed pixel dimensions are baked in.

  Accepts:
    image     {Image}    Shopify image object (image_picker or product image)
    ratio     {String}   4x5 | 16x9 | 1x1 | 3x4 | 21x9
    alt       {String}   overrides image.alt. See the alt-text note below.
    focal     {String}   center | top | bottom
    zoom      {Boolean}  .pimg--zoom, 1.06 scale on hover
    sizes     {String}   CSS sizes attribute, default '100vw'
    widths    {String}   comma-separated srcset widths
    loading   {String}   lazy | eager. Use eager above the fold ONLY.
    fetch_priority {String} high | low | auto
    scrim_opacity {Number} 0–80, from a schema range. 0 renders no scrim.
    class     {String}

  ALT TEXT: 08-ASSETS.md records an alt-text gap on the live store
  (1.16 images per product, alt largely absent). This snippet falls back
  to image.alt, then to the caller's `alt`, and renders alt="" —
  correctly marking the image decorative — rather than inventing a
  description. Closing the gap is a content task, not a markup one.
{%- endcomment -%}
{%- liquid
  case ratio
    when '16x9'
      assign ar = '16/9'
    when '1x1'
      assign ar = '1/1'
    when '3x4'
      assign ar = '3/4'
    when '21x9'
      assign ar = '21/9'
    else
      assign ar = '4/5'
  endcase

  case focal
    when 'top'
      assign focal_class = 'pimg--top'
    when 'bottom'
      assign focal_class = 'pimg--bottom'
    else
      assign focal_class = ''
  endcase

  assign zoom_class = ''
  if zoom
    assign zoom_class = 'pimg--zoom'
  endif

  assign img_alt = alt | default: image.alt
  assign img_sizes = sizes | default: '100vw'
  assign img_widths = widths | default: '360, 540, 720, 900, 1080, 1440, 1800'
  assign img_loading = loading | default: 'lazy'

  assign scrim = scrim_opacity | default: 0
  assign scrim_decimal = scrim | divided_by: 100.0

  capture wrapper_style
    echo 'aspect-ratio:' | append: ar
    if scrim > 0
      echo ';--scrim-opacity:' | append: scrim_decimal
    endif
  endcapture
-%}
<div class="pimg {{ focal_class }} {{ zoom_class }} {{ class }}" style="{{ wrapper_style }}">
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 1800
      | image_tag:
        loading: img_loading,
        fetchpriority: fetch_priority,
        sizes: img_sizes,
        widths: img_widths,
        alt: img_alt
    }}
  {%- else -%}
    <div class="pimg__ph">
      {{ 'image' | placeholder_svg_tag: 'pimg__placeholder' }}
    </div>
  {%- endif -%}

  {%- if scrim > 0 -%}
    <span class="pimg__scrim" aria-hidden="true"></span>
  {%- endif -%}
</div>
