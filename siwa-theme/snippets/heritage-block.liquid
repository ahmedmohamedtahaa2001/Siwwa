{%- comment -%}
  Heritage / storytelling block — 5 variants.

  Styles: ../component-library/css/components.css
          (.story, .timeline, .artisan, .heritage--cinematic)

  Variants (the `block_style` argument):
    split      Image one side, text the other. One accent rule.
    quote      Large serif pull-quote, attribution, optional vintage surface.
    timeline   Numbered or dated chapters with a connecting line. Blocks.
    artisan    Photo, name, role, quote, product connection. Kahina model.
    cinematic  21:9 image, text overlaid, one Cultural Accent CTA.

  ⚠ THIS IS THE ONE PLACE THE CULTURAL ACCENT SET BELONGS
  Everywhere else it is firewalled off. Here it is the point. The
  embroidery palette — palm green, date red, date yellow, desert brown —
  carries the Siwan identity that `BENCHMARK.md` Part 2 finds almost
  entirely absent from the current site.

  ⚠ AND IT MUST BE TRUE
  Content to surface, per BENCHMARK Part 2 §2–3: Amazigh identity and the
  Siwi language; Shali Fortress; the Temple of the Oracle and Alexander;
  Kershef salt-clay-mud architecture; the Sunburst motif; dates, olives
  and salt as ingredients. The Kahina model that §3 recommends is
  QUANTIFIED ethics — "X% of revenue to a named partner", countable
  items, named cooperatives. Unquantified warmth is the thing it warns
  against. Every field here is merchant-authored precisely so a person
  who knows the truth writes it; nothing is generated.

  ⚠ ARTISAN ATTRIBUTION NAMES REAL PEOPLE
  The `artisan` variant publishes a name, a photograph and a quote.
  Consent is a prerequisite, not a nicety. Do not populate it with stock
  photography of unnamed people — that is the opposite of the Kahina
  model it is imitating.

  Accepts:
    heading        {String}
    body           {String}   richtext
    image          {Image}
    quote          {String}   quote variant
    attribution    {String}
    provenance     {String}   e.g. "Sourced from Siwa Oasis"
    blocks         {Array}    timeline / artisan variants
    block_style    {String}   split | quote | timeline | artisan | cinematic
    accent_color   {String}   none | palm-green | date-red | date-yellow
                              | desert-brown
    enable_vintage {Boolean}  paper grain, vignette, edge wear
    reverse        {Boolean}  split variant
    cta_label      {String}
    cta_url        {String}
    scrim_opacity  {Number}   cinematic variant
    heading_tag    {String}   h2 | h3, default h2
{%- endcomment -%}
{%- liquid
  assign bs = block_style | default: 'split'
  assign tag = heading_tag | default: 'h2'

  assign accent_var = ''
  case accent_color
    when 'palm-green'
      assign accent_var = '--accent-color:var(--palm-green)'
    when 'date-red'
      assign accent_var = '--accent-color:var(--date-red)'
    when 'date-yellow'
      assign accent_var = '--accent-color:var(--date-yellow)'
    when 'desert-brown'
      assign accent_var = '--accent-color:var(--desert-brown)'
  endcase

  assign vintage_class = ''
  if enable_vintage
    assign vintage_class = 'vintage-surface'
  endif
-%}
{%- capture heading_markup -%}
  {%- if heading != blank -%}
    <{{ tag }} class="fcard__heading">
      {%- if heading != blank -%}{{ heading }}{%- endif -%}
      
    </{{ tag }}>
  {%- endif -%}
{%- endcapture -%}
{%- capture body_markup -%}
  {%- if body != blank -%}<div class="story rte">{{ body }}</div>{%- endif -%}
  
  {%- if provenance != blank -%}
    <span class="pcard__provenance">{{ provenance }}</span>
  {%- endif -%}
{%- endcapture -%}
{%- capture cta_markup -%}
  {%- if cta_label != blank -%}
    {%- render 'button', label: cta_label, url: cta_url, style: 'ghost',
      icon: 'arrow-right', icon_is_directional: true -%}
  {%- endif -%}
{%- endcapture -%}

<div class="heritage heritage--{{ bs }} {{ vintage_class }} {{ class }}"
  {% if accent_var != blank %}style="{{ accent_var }}"{% endif %}>

  {%- if enable_vintage -%}<span class="edge-wear" aria-hidden="true"></span>{%- endif -%}

  {%- case bs -%}

    {%- when 'quote' -%}
      <figure class="story" style="margin:0">
        <span class="heritage__rule" aria-hidden="true"></span>
        <blockquote style="margin:0">
          <p class="story__quote">{{ quote }}</p>
        </blockquote>
        {%- if attribution != blank -%}
          <figcaption class="story__eyebrow">{{ attribution }}</figcaption>
        {%- endif -%}
        {{ cta_markup }}
      </figure>

    {%- when 'timeline' -%}
      {%- comment -%} Chapters as blocks — never a fixed loop (Law 3). {%- endcomment -%}
      {{ heading_markup }}
      <div class="timeline">
        {%- for block in blocks -%}
          <div class="timeline__item" {{ block.shopify_attributes }}>
            <div class="timeline__marker">
              {%- if block.settings.chapter_number != blank -%}
                <span class="timeline__num" aria-hidden="true">
                  {{ block.settings.chapter_number }}
                </span>
              {%- endif -%}
              <span class="timeline__line" aria-hidden="true"></span>
            </div>
            <div class="story">
              {%- if block.settings.chapter_heading != blank -%}
                <h3 class="fcard__heading">
                  {{ block.settings.chapter_heading }}
                  
                </h3>
              {%- endif -%}
              {%- if block.settings.chapter_image != blank -%}
                {%- render 'image-container', image: block.settings.chapter_image,
                  ratio: '16x9', alt: block.settings.chapter_heading -%}
              {%- endif -%}
              {%- if block.settings.chapter_body != blank -%}
                <div class="rte">{{ block.settings.chapter_body }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

    {%- when 'artisan' -%}
      {{ heading_markup }}
      {{ body_markup }}
      <div class="artisan__grid">
        {%- for block in blocks -%}
          <figure class="artisan" style="margin:0" {{ block.shopify_attributes }}>
            {%- if block.settings.photo != blank -%}
              {%- render 'image-container', image: block.settings.photo,
                ratio: '3x4', alt: block.settings.name -%}
            {%- endif -%}
            <figcaption>
              {%- if block.settings.name != blank -%}
                <p class="artisan__name">{{ block.settings.name }}</p>
              {%- endif -%}
              {%- if block.settings.role != blank -%}
                <span class="artisan__role">{{ block.settings.role }}</span>
              {%- endif -%}
            </figcaption>
            {%- if block.settings.quote != blank -%}
              <blockquote style="margin:0">
                <p class="story">{{ block.settings.quote }}</p>
              </blockquote>
            {%- endif -%}
            {%- if block.settings.product_connection != blank -%}
              <span class="layering__reason">{{ block.settings.product_connection }}</span>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>

    {%- when 'cinematic' -%}
      {%- render 'image-container', image: image, ratio: '21x9',
        scrim_opacity: scrim_opacity | default: 50, sizes: '100vw', alt: heading -%}
      <div class="heritage__body">
        <span class="heritage__rule" aria-hidden="true"></span>
        {{ heading_markup }}
        {{ body_markup }}
        {{ cta_markup }}
      </div>

    {%- else -%}
      {%- comment -%} split {%- endcomment -%}
      <div class="iwt {% if reverse %}iwt--rev{% endif %}">
        {%- render 'image-container', image: image, ratio: '4x5',
          sizes: '(min-width: 750px) 50vw, 100vw', alt: heading -%}
        <div class="story">
          <span class="heritage__rule" aria-hidden="true"></span>
          {{ heading_markup }}
          {{ body_markup }}
          {{ cta_markup }}
        </div>
      </div>

  {%- endcase -%}
</div>
