{%- comment -%}
  Scent quiz / finder — 5 variants.

  Styles: ../component-library/css/components.css (.quiz, .qopt, .pcards)
  Behaviour: assets/siwa-modules.js (steps, scoring, result)

  WHY THIS EXISTS
  `BENCHMARK.md` Part 1 §3.5 records this as the largest missing feature:
  every Tier 1 and Tier 2 competitor has a scent finder and Siwa has
  none. Reference architectures: Oakcha (note family + designer
  preference), Skylar (score to a core scent plus a layering combo),
  Fragrantica (algorithmic accord matching).

  Variants (the `quiz_style` argument):
    form      5–7 questions, progress bar, radio options. Simplest.
    visual    Image cards per answer. Tap to select.
    persona   Answers map to a Persona archetype, then to a product line.
    scoring   Skylar-style — a core scent plus an optional layering pair.
    deep      15+ questions, note preferences, three ranked matches.

  ⚠ QUESTIONS AND ANSWERS ARE BLOCKS, NEVER A FIXED LOOP
  Development Law 3. Every question is a schema block; every answer is a
  nested value on that block. A merchant can add, remove and reorder
  questions without a developer.

  ⚠ SCORING MAPS TO REAL PRODUCTS, AND MAY FAIL TO
  Each answer carries an `answer_value` — a tag or a scent family. The
  scorer counts values and resolves the winner against
  `result_collection`. When nothing matches well enough it falls back to
  `fallback_collection` rather than inventing a match. A quiz that always
  produces a confident answer is a quiz that is lying.

  ⚠ THE PERSONA SYSTEM IS A HINT, NOT A SPEC
  `07-COPY-CONTENT.md` finds Persona language already in some product
  copy, but there is no defined archetype set. The `persona` variant
  reads archetypes from blocks; nobody has authored them yet.

  Accepts:
    blocks             {Array}   question blocks. Each: question_text,
                                 question_type,
                                 answer_1..4 label/value/image
    quiz_style         {String}  form | visual | persona | scoring | deep
    result_type        {String}  single-product | multi-product | persona
                                 | layering-combo
    result_collection  {Collection}  products the result resolves against
    fallback_collection {Collection} used when no answer scores well
    heading            {String}
    cta_label          {String}
    section_id         {String}  required — scopes ids and radio names
{%- endcomment -%}
{%- liquid
  assign qs = quiz_style | default: 'form'
  assign uid = section_id | default: 'quiz'
  assign total = blocks.size
  assign visual = false
  if qs == 'visual' or qs == 'persona'
    assign visual = true
  endif
-%}
<div
  class="quiz"
  data-siwa-quiz
  data-uid="{{ uid }}"
  data-style="{{ qs }}"
  data-result-type="{{ result_type | default: 'single-product' }}"
  data-result-collection="{{ result_collection.handle }}"
  data-fallback-collection="{{ fallback_collection.handle }}"
  {%- comment -%}
    Strings for the JS. siwa-modules.js contains no sentences — it reads
    every message from these attributes, which come from locales/.
  {%- endcomment -%}
  data-msg-step="{{ 'products.quiz.step' | t | escape }}"
  data-msg-next="{{ 'products.quiz.next' | t | escape }}"
  data-msg-see="{{ 'products.quiz.see_result' | t | escape }}"
  data-msg-pick="{{ 'products.quiz.pick_one' | t | escape }}"
>
  {%- if heading != blank -%}
    <h2 class="quiz__q">
      {{ heading }}
      
    </h2>
  {%- endif -%}

  {%- comment -%}
    Progress. aria-valuenow is updated by the JS; the bar is also
    described in text for screen readers, because a bar alone says
    nothing.
  {%- endcomment -%}
  <div class="quiz__prog" role="progressbar"
       aria-valuemin="1" aria-valuemax="{{ total }}" aria-valuenow="1"
       aria-label="{{ 'products.quiz.progress' | t }}">
    <i data-quiz-bar style="width:0%"></i>
  </div>
  <p class="quiz__step" data-quiz-step aria-live="polite"></p>

  <form data-quiz-form>
    {%- for block in blocks -%}
      <fieldset
        class="quiz__step-panel"
        data-quiz-question="{{ forloop.index }}"
        {% unless forloop.first %}hidden{% endunless %}
        {{ block.shopify_attributes }}
      >
        <legend class="quiz__q">
          {{ block.settings.question_text }}
          
        </legend>

        <div class="quiz__opts {% if visual %}quiz__opts--visual{% endif %}">
          {%- for i in (1..4) -%}
            {%- liquid
              assign label_key = 'answer_' | append: i | append: '_label'
              assign value_key = 'answer_' | append: i | append: '_value'
              assign image_key = 'answer_' | append: i | append: '_image'
              assign a_label = block.settings[label_key]
              assign a_value = block.settings[value_key]
              assign a_image = block.settings[image_key]
            -%}
            {%- if a_label != blank -%}
              {%- assign input_type = 'radio' -%}
              {%- if block.settings.question_type == 'multi-choice' -%}
                {%- assign input_type = 'checkbox' -%}
              {%- endif -%}
              <label class="{% if visual %}qopt--visual{% else %}qopt{% endif %}">
                <input
                  type="{{ input_type }}"
                  name="{{ uid }}-q{{ forloop.parentloop.index }}"
                  value="{{ a_value | default: a_label | handle }}"
                  data-quiz-answer>
                {%- if visual and a_image != blank -%}
                  {%- render 'image-container', image: a_image, ratio: '1x1', alt: a_label -%}
                {%- endif -%}
                <span>{{ a_label }}</span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </fieldset>
    {%- else -%}
      <p class="pyramid__empty">{{ 'products.quiz.no_questions' | t }}</p>
    {%- endfor -%}

    <div class="quiz__nav">
      {%- render 'button', label: 'products.quiz.back' | t, style: 'ghost', id: uid | append: '-back' -%}
      {%- render 'button',
        label: cta_label | default: 'products.quiz.next' | t,
        style: 'primary', id: uid | append: '-next' -%}
    </div>
  </form>

  {%- comment -%}
    Result. Populated client-side. `aria-live` announces it, and focus is
    moved here by the JS so a keyboard user is not left at the bottom of
    a hidden form.
  {%- endcomment -%}
  <div class="quiz__result" data-quiz-result tabindex="-1" aria-live="polite" hidden></div>

  <noscript>
    <p class="pyramid__empty">{{ 'products.quiz.no_js' | t }}</p>
  </noscript>
</div>
