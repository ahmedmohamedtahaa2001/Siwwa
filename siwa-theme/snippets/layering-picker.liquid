{%- comment -%}
  Layering picker / bundle builder — 5 variants.

  Styles: ../component-library/css/components.css (.layering, .bundle, .pick)
  Behaviour: assets/siwa-modules.js (selection, live total, cart add)

  WHY THIS EXISTS
  Layering Vanilla is the store's single most-reviewed product — 98
  reviews at 5.00★ (`_CORRECTIONS.md` §1) — and the site offers no
  guidance whatsoever on what to layer it with. This module is the gap.
  Reference: Snif's layering bundles, Skylar's quiz-to-combo output
  (DIRECTION.md Part 2). Commerce mechanics follow Snif, not Amouage —
  when they disagree, Snif wins on price register.

  Variants (the `picker_style` argument):
    steps     Step 1 base, step 2 partner, step 3 add both. Most guided.
    dropdown  Two selects, live total, one button. Fastest.
    quiz      Reads a quiz result and presents the matched pair.
    grid      All compatible products; pick one, partners highlight.
    guided    "Start with the most loved, then choose" + reasons per partner.

  ⚠ COMPATIBILITY DATA DOES NOT EXIST
  There is no metafield recording which scents layer well together, and
  the store has zero custom metafields (03-DATA-SCHEMA.md §7). Partners
  come from `partner_collection` — a merchant-curated collection — which
  is honest: a human decided, rather than an algorithm implying data that
  was never collected. `layering_reason` is likewise merchant-authored
  per partner, via blocks.

  ⚠ NO DISCOUNT IS APPLIED HERE
  `bundle_discount` renders a message only. Actually discounting a pair
  requires a cart-level Shopify Function or an automatic discount
  configured in the admin. Rendering a saving the checkout will not
  honour is worse than rendering none, so this snippet does not.

  Accepts:
    base_collection    {Collection}  scents to layer FROM
    partner_collection {Collection}  scents to layer WITH
    picker_style       {String}      steps | dropdown | quiz | grid | guided
    blocks             {Array}       guided variant: partner + reason per block
    show_descriptions  {Boolean}
    bundle_discount    {Number}      percentage, message only — see above
    heading            {String}
    section_id         {String}      required — scopes ids and radio names
    cta_label          {String}
{%- endcomment -%}
{%- liquid
  assign ps = picker_style | default: 'steps'
  assign uid = section_id | default: 'layering'
  assign base_products = base_collection.products
  assign partner_products = partner_collection.products
-%}
{%- comment -%}
  Strings for the JS. siwa-modules.js never contains a sentence — it
  reads every message from these attributes, which come from locales/.
{%- endcomment -%}
<div
  class="layering"
  data-siwa-layering
  data-uid="{{ uid }}"
  data-msg-incomplete="{{ 'products.layering.incomplete' | t | escape }}"
  data-msg-added="{{ 'products.product.added' | t | escape }}"
  data-msg-failed="{{ 'products.product.add_failed' | t | escape }}"
>

  {%- if heading != blank -%}
    <h2 class="ccard__title">{{ heading }}</h2>
  {%- endif -%}

  {%- case ps -%}

    {%- when 'dropdown' -%}
      <div class="layering__step">
        <label class="layering__steplabel" for="{{ uid }}-base">
          {{ 'products.layering.base' | t }}
        </label>
        <select class="select" id="{{ uid }}-base" data-layering-base>
          {%- for product in base_products -%}
            <option value="{{ product.selected_or_first_available_variant.id }}"
                    data-price="{{ product.price }}">{{ product.title }}</option>
          {%- endfor -%}
        </select>
      </div>
      <div class="layering__step">
        <label class="layering__steplabel" for="{{ uid }}-partner">
          {{ 'products.layering.partner' | t }}
        </label>
        <select class="select" id="{{ uid }}-partner" data-layering-partner>
          {%- for product in partner_products -%}
            <option value="{{ product.selected_or_first_available_variant.id }}"
                    data-price="{{ product.price }}">{{ product.title }}</option>
          {%- endfor -%}
        </select>
      </div>

    {%- when 'grid' -%}
      <div class="layering__step">
        <span class="layering__steplabel">{{ 'products.layering.base' | t }}</span>
        <div class="layering__opts">
          {%- for product in base_products -%}
            <label class="pick">
              <input type="radio" name="{{ uid }}-base" data-layering-base
                     value="{{ product.selected_or_first_available_variant.id }}"
                     data-price="{{ product.price }}">
              {%- render 'product-card', product: product, style: 'compact', show_reviews: true -%}
              <span class="pick__box" aria-hidden="true"></span>
            </label>
          {%- endfor -%}
        </div>
      </div>
      <div class="layering__step">
        <span class="layering__steplabel">{{ 'products.layering.partner' | t }}</span>
        <div class="layering__opts">
          {%- for product in partner_products -%}
            <label class="pick">
              <input type="radio" name="{{ uid }}-partner" data-layering-partner
                     value="{{ product.selected_or_first_available_variant.id }}"
                     data-price="{{ product.price }}">
              {%- render 'product-card', product: product, style: 'compact', show_reviews: true -%}
              <span class="pick__box" aria-hidden="true"></span>
            </label>
          {%- endfor -%}
        </div>
      </div>

    {%- when 'guided' -%}
      {%- comment -%}
        Blocks, never a fixed loop (Law 3). Each block pairs a real
        product with a merchant-written reason — "fruity twist",
        "deeper warmth" — because no compatibility data exists to
        generate one from.
      {%- endcomment -%}
      {%- assign lead = base_products.first -%}
      {%- if lead != blank -%}
        <div class="layering__step">
          <span class="layering__steplabel">{{ 'products.layering.start_with' | t }}</span>
          {%- render 'product-card', product: lead, style: 'minimal', show_reviews: true -%}
        </div>
      {%- endif -%}
      <div class="layering__step">
        <span class="layering__steplabel">{{ 'products.layering.then_choose' | t }}</span>
        <div class="layering__opts">
          {%- for block in blocks -%}
            {%- assign partner = block.settings.partner_product -%}
            {%- if partner != blank -%}
              <label class="pick" {{ block.shopify_attributes }}>
                <input type="radio" name="{{ uid }}-partner" data-layering-partner
                       value="{{ partner.selected_or_first_available_variant.id }}"
                       data-price="{{ partner.price }}">
                {%- render 'product-card', product: partner, style: 'compact' -%}
                {%- if block.settings.layering_reason != blank -%}
                  <span class="layering__reason">{{ block.settings.layering_reason }}</span>
                {%- endif -%}
                <span class="pick__box" aria-hidden="true"></span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    {%- when 'quiz' -%}
      {%- comment -%}
        Populated by the quiz result. Empty until the quiz runs — the
        JS fills data-layering-base / -partner from the stored outcome.
      {%- endcomment -%}
      <div class="layering__pair" data-layering-quiz-result>
        <p class="pyramid__empty">{{ 'products.layering.take_quiz' | t }}</p>
      </div>

    {%- else -%}
      {%- comment -%} steps {%- endcomment -%}
      <div class="layering__step">
        <span class="layering__steplabel">{{ 'products.layering.step_one' | t }}</span>
        <div class="layering__opts">
          {%- for product in base_products limit: 6 -%}
            <label class="pick">
              <input type="radio" name="{{ uid }}-base" data-layering-base
                     value="{{ product.selected_or_first_available_variant.id }}"
                     data-price="{{ product.price }}">
              {%- render 'product-card', product: product, style: 'compact' -%}
              <span class="pick__box" aria-hidden="true"></span>
            </label>
          {%- endfor -%}
        </div>
      </div>
      <div class="layering__step">
        <span class="layering__steplabel">{{ 'products.layering.step_two' | t }}</span>
        <div class="layering__opts">
          {%- for product in partner_products limit: 6 -%}
            <label class="pick">
              <input type="radio" name="{{ uid }}-partner" data-layering-partner
                     value="{{ product.selected_or_first_available_variant.id }}"
                     data-price="{{ product.price }}">
              {%- render 'product-card', product: product, style: 'compact' -%}
              <span class="pick__box" aria-hidden="true"></span>
            </label>
          {%- endfor -%}
        </div>
      </div>
  {%- endcase -%}

  <div class="layering__total">
    <span class="price" data-layering-total aria-live="polite"></span>
    {%- render 'button',
      label: cta_label | default: 'products.layering.add_duo' | t,
      style: 'primary', id: uid | append: '-add' -%}
  </div>

  {%- if bundle_discount != blank and bundle_discount > 0 -%}
    {%- comment -%}
      Message only. The saving must also be configured as an automatic
      discount or a Shopify Function, or checkout will not honour it.
    {%- endcomment -%}
    <p class="layering__reason">
      {{ 'products.layering.discount_note' | t: percent: bundle_discount }}
    </p>
  {%- endif -%}

  <p class="layering__reason" data-layering-status role="status"></p>
</div>
