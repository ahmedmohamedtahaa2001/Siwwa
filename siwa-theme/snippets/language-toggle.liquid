{%- comment -%}
  Language toggle — EN / AR.

  Styles: ../component-library/css/components.css (.langtog)

  Uses Shopify's NATIVE localization form. That matters: it sets the
  locale cookie server-side, so the next request renders the whole page
  in the chosen language — direction, type families, numerals, title,
  meta description, canonical and JSON-LD all follow. A JavaScript
  toggle that swapped visible strings would leave every one of those
  wrong, and would be invisible to search engines.

  Only renders when more than one locale is published. Add Arabic under
  Settings → Languages in the admin; until then this is silent rather
  than a dead control.
{%- endcomment -%}
{%- if shop.published_locales.size > 1 -%}
  {%- form 'localization', class: 'langtog' -%}
    {%- for locale in shop.published_locales -%}
      <button
        type="submit"
        name="locale_code"
        value="{{ locale.iso_code }}"
        lang="{{ locale.iso_code }}"
        {% if locale.primary %}data-primary="true"{% endif %}
        aria-current="{% if locale.iso_code == request.locale.iso_code %}true{% else %}false{% endif %}"
      >
        {{ locale.endonym_name }}
      </button>
    {%- endfor -%}
  {%- endform -%}
{%- endif -%}
