{%- comment -%}
  Carousel — one component for every horizontal rail on the site.

  Styles: ../component-library/css/components.css (.car)
  Behaviour: assets/siwa-modules.js (initCarousel)

  Best sellers, inspired-by and bundles all use this. Before it there
  were three near-identical rails; now there is one, and an arrow fix
  lands everywhere at once.

  A snippet cannot wrap caller markup, so the items are captured and
  passed in:

    {%- capture items -%}
      {% for p in collection.products %}{% render 'product-card-v2', product: p %}{% endfor %}
    {%- endcapture -%}
    {% render 'carousel', items: items, heading: 'Best selling', section_id: section.id %}

  The controls sit UNDER the track as one bar — prev · dots · next, dots
  centred. That is the site's single control convention: every rail is
  paged the same way, so a customer learns it once. The track itself is
  content-agnostic — product cards, UGC reels, bundles and quotes all go
  in as captured markup and are styled by the slide, not by the rail.

  Accepts:
    items       {String}   captured markup, one node per slide
    heading     {String}
    eyebrow     {String}
    link_label  {String}   optional "view all"
    link_url    {String}
    dark        {Boolean}  controls for a dark ground
    media       {Boolean}  narrow slides for portrait 9:16 reels
    section_id  {String}   scopes the aria-label
{%- endcomment -%}
<div class="car {% if dark %}car--dark{% endif %} {% if media %}car--media{% endif %}" data-siwa-carousel>
  {%- if heading != blank or eyebrow != blank or link_label != blank -%}
    <div class="car__head">
      <div>
        {%- if eyebrow != blank -%}<p class="eyebrow">{{ eyebrow }}</p>{%- endif -%}
        {%- if heading != blank -%}<h2 class="section__title">{{ heading }}</h2>{%- endif -%}
      </div>
      {%- if link_label != blank -%}
        <a class="btn btn--tertiary" href="{{ link_url }}">{{ link_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="car__track carousel" role="region" tabindex="0"
       aria-label="{{ heading | default: 'collections.general.view_all' | t | escape }}">
    {{ items }}
  </div>

  {%- render 'carousel-controls' -%}
</div>
