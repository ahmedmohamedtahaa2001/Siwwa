{%- comment -%}
  Bundle card — square, to client spec 2026-08-13.

  Styles: ../component-library/css/components.css (.bcd)

  Two rows:
    top     three cells, one photograph per fragrance in the bundle
    bottom  bundle name · what is in it · price · saving

  Rides the shared `carousel` snippet like any other rail.

  ⚠ NO BUNDLE PRODUCTS EXIST IN THE CATALOGUE YET.
  This renders a real Shopify product whose line items are the bundle —
  either a bundle SKU or a product with a `bundle.products` metafield
  listing the handles. Until those are created in the admin, the band it
  sits in has nothing to show. `05-COLLECTIONS.md` records no bundle
  collection; Snif's set-plus-trial-ladder is the model to copy
  (DIRECTION.md Part 1 §2.5).

  ⚠ THE SAVING MUST BE REAL.
  `saving` is computed from compare-at vs price. If the bundle has no
  compare-at set, no saving renders — a discount the checkout will not
  honour is worse than none.

  Accepts:
    product   {Product}  the bundle product
    members   {Array}    up to 3 products it contains. Falls back to the
                         `bundle.products` metafield list.
    index     {Number}
{%- endcomment -%}
{%- liquid
  assign list = members
  if list == blank
    assign list = product.metafields.bundle.products.value
  endif

  assign saving = 0
  if product.compare_at_price_max > product.price_min
    assign saving = product.compare_at_price_max | minus: product.price_min
  endif
-%}
<a class="bcd {{ class }}" href="{{ product.url }}" style="--i:{{ index | default: 0 }}">
  <span class="bcd__row">
    {%- for i in (1..3) -%}
      {%- assign member = list[forloop.index0] -%}
      <span class="bcd__cell">
        {%- if member.featured_image -%}
          {{ member.featured_image | image_url: width: 500 | image_tag:
             loading: 'lazy', alt: member.title }}
        {%- else -%}
          <span class="bcd__ph">{%- render 'icon', name: 'bottle' -%}</span>
        {%- endif -%}
      </span>
    {%- endfor -%}
  </span>

  <span class="bcd__body">
    <span class="bcd__title">{{ product.title }}</span>
    {%- if list.size > 0 -%}
      <span class="bcd__items">
        {%- for m in list -%}{{ m.title }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
      </span>
    {%- endif -%}
    <span class="bcd__foot">
      <span class="bcd__price">{{ product.price_min | money }}</span>
      {%- if saving > 0 -%}
        <span class="bcd__was">{{ product.compare_at_price_max | money }}</span>
        <span class="bcd__save">{{ 'products.bundle.save' | t: amount: saving | money }}</span>
      {%- endif -%}
    </span>
  </span>
</a>
