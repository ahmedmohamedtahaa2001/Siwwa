{%- comment -%}
  Review card — 5 variants. One customer review.

  Styles: ../component-library/css/components.css (.review and modifiers)

  Variants (the `style` argument):
    list      .review             Avatar monogram, name, stars, date, body,
                                  verified badge. The PDP default.
    featured  .review--featured   Larger, full body, product name, location.
    carousel  .review--carousel   Centred, short quote, big stars. Homepage.
    detailed  .review--detailed   Adds variant purchased, helpful votes,
                                  and the shop's reply if there is one.
    vintage   .review--vintage    Pull-quote in the vintage surface, initials
                                  in a frame, one Cultural Accent colour.

  ⚠ REVIEW CONTENT IS NEVER AUTHORED
  Every field below comes from a Judge.me review object passed in as
  `review`. No review text, author, rating or date may be typed into a
  schema setting — a fabricated review is a fabricated endorsement.
  The one exception is the `reviews-section` homepage block, where a
  merchant curates WHICH real review to feature; even there the content
  is echoed from the review object.

  ⚠ REVIEWS STAY LOUD
  DIRECTION.md Part 1 §2.1: do not copy Amouage's review restraint.
  They sell at $395; Siwa sells at ~$19 with 4.98★ from 1,212 reviews.
  Prominence is the strategy, not a decoration.

  Accepts:
    review          {Object}  required. Expected shape:
                              .author .location .rating .date .title .body
                              .verified .product .variant .helpful_votes .reply
    style           {String}  list | featured | carousel | detailed | vintage
    truncate_length {Number}  80–400, default 200. 0 disables truncation.
    show_verified   {Boolean} default true
    show_product    {Boolean} default false
    accent_color    {String}  vintage variant only
{%- endcomment -%}
{%- liquid
  assign rv_style = style | default: 'list'
  assign limit = truncate_length | default: 200

  case rv_style
    when 'featured'
      assign modifier = 'review--featured'
    when 'carousel'
      assign modifier = 'review--carousel'
      assign limit = truncate_length | default: 80
    when 'detailed'
      assign modifier = 'review--detailed'
      assign limit = 0
    when 'vintage'
      assign modifier = 'review--vintage'
    else
      assign modifier = ''
  endcase

  assign do_verified = show_verified
  if show_verified == nil
    assign do_verified = true
  endif

  assign body = review.body
  assign truncated = false
  if limit > 0 and body.size > limit
    assign body = body | truncate: limit
    assign truncated = true
  endif

  comment
    Monogram from the author's initial. Judge.me supplies display names
    like "Ahmed M." — the first character is the initial in both scripts.
  endcomment
  assign monogram = review.author | strip | slice: 0, 1 | upcase

  comment
    Arabic review bodies are real in this catalogue and must render RTL
    even while the page is English. .review__body[lang="ar"] handles the
    font, direction and leading.
  endcomment
  assign body_lang = 'en'
  if review.language != blank
    assign body_lang = review.language
  endif

  assign accent_var = ''
  case accent_color
    when 'palm-green'
      assign accent_var = '--accent-color:var(--palm-green)'
    when 'date-red'
      assign accent_var = '--accent-color:var(--date-red)'
    when 'date-yellow'
      assign accent_var = '--accent-color:var(--date-yellow)'
    when 'desert-brown'
      assign accent_var = '--accent-color:var(--desert-brown)'
  endcase
-%}
<article class="review {{ modifier }} {{ class }}"
  {% if accent_var != blank %}style="{{ accent_var }}"{% endif %}>

  {%- if rv_style == 'vintage' -%}
    <span class="edge-wear" aria-hidden="true"></span>
  {%- endif -%}

  <div class="review__head">
    {%- unless rv_style == 'carousel' -%}
      <span class="review__avatar" aria-hidden="true">{{ monogram }}</span>
    {%- endunless -%}

    {%- if review.rating != blank -%}
      {%- render 'star-rating', rating: review.rating, size: rv_style -%}
    {%- endif -%}

    {%- if review.author != blank -%}
      <span class="review__author">{{ review.author }}</span>
    {%- endif -%}

    {%- if do_verified and review.verified -%}
      <span class="review__verified">{{ 'products.reviews.verified' | t }}</span>
    {%- endif -%}
  </div>

  {%- if review.title != blank and rv_style != 'carousel' -%}
    <p class="review__title"><strong>{{ review.title }}</strong></p>
  {%- endif -%}

  <p class="review__body" lang="{{ body_lang }}"
     {% if body_lang == 'ar' %}dir="rtl"{% endif %}>{{ body }}</p>

  {%- if truncated -%}
    <a href="{{ review.url | default: '#' }}" class="btn btn--tertiary btn--sm">
      {{ 'products.reviews.read_more' | t }}
    </a>
  {%- endif -%}

  <p class="review__meta">
    {%- if review.location != blank -%}{{ review.location }}{%- endif -%}
    {%- if review.date != blank -%}
      {%- if review.location != blank %} · {% endif -%}
      <time datetime="{{ review.date }}">{{ review.date | date: '%-d %B %Y' }}</time>
    {%- endif -%}
    {%- if show_product and review.product != blank -%} · {{ review.product }}{%- endif -%}
    {%- if rv_style == 'detailed' and review.variant != blank -%} · {{ review.variant }}{%- endif -%}
  </p>

  {%- if rv_style == 'detailed' -%}
    {%- if review.helpful_votes != blank -%}
      <p class="review__votes review__meta">
        {{ 'products.reviews.helpful' | t }} ({{ review.helpful_votes }})
      </p>
    {%- endif -%}
    {%- if review.reply != blank -%}
      <div class="review__reply">
        <p class="review__meta">{{ 'products.reviews.reply_from' | t: shop: shop.name }}</p>
        <p class="review__body">{{ review.reply }}</p>
      </div>
    {%- endif -%}
  {%- endif -%}
</article>
