{%- comment -%}
  Review widget — 5 variants. The full review presentation for a PDP or
  a landing page.

  Styles: ../component-library/css/components.css (.rsummary, .rwidget--split)

  Variants (the `widget_style` argument):
    embed     Judge.me's own widget, unmodified, styled to match tokens.
              The safest option and the default.
    list      Custom-rendered review cards from a review array.
    summary   Aggregate + N featured reviews + "see all" expander.
    histogram Star distribution beside the list, filterable by rating.
    carousel  Top-rated reviews as large testimonial cards.

  ⚠ JUDGE.ME IS AN APP BLOCK — PREFER `embed`
  The full review list, submission form, photo uploads, voting and
  moderation all live in Judge.me. Re-implementing them against the API
  means re-implementing all of it. `embed` renders the app's own div and
  lets it hydrate. The custom variants are for merchandising surfaces
  where the reviews are already in hand.

  ⚠ NOT VERIFIED AGAINST A LIVE STORE
  No store credentials exist in this repository. The Judge.me markup here
  follows `06-REVIEWS.md` §4 (theme app extension `judgeme-657`, widget
  version 3.0) but has not been run. Confirm before relying on it.

  ⚠ AGGREGATE FIGURES ARE NOT HARDCODED
  4.98★ / 1,212 is the live figure at 2026-08-12, and it moves — it was
  1,176 at the 2026-07-27 capture. Nothing here writes a number. The
  aggregate comes from `shop.metafields.judgeme.*`, and `03-DATA-SCHEMA.md`
  §7 warns those are stored inside a settings blob as unrendered template
  strings, so they may resolve empty. When they do, the aggregate block is
  omitted rather than filled with a stale constant.

  Accepts:
    product          {Product}  required for embed / list / histogram
    reviews          {Array}    review objects for the custom variants
    widget_style     {String}   embed | list | summary | histogram | carousel
    show_histogram   {Boolean}
    show_summary     {Boolean}
    featured_count   {Number}   0–10
    allow_filtering  {Boolean}  histogram rows become rating filters
    review_style     {String}   passed to review-card
    heading          {String}
    cta_label        {String}
    cta_url          {String}
{%- endcomment -%}
{%- liquid
  assign ws = widget_style | default: 'embed'
  assign featured = featured_count | default: 3

  assign agg_rating = shop.metafields.judgeme.all_reviews_rating
  assign agg_count = shop.metafields.judgeme.all_reviews_count
  assign has_aggregate = false
  if agg_rating != blank and agg_count != blank
    assign has_aggregate = true
  endif
-%}
<div class="rwidget {% if ws == 'histogram' %}rwidget--split{% endif %} {{ class }}">

  {%- if heading != blank -%}
    <h2 class="ccard__title">{{ heading }}</h2>
  {%- endif -%}

  {%- case ws -%}

    {%- when 'embed' -%}
      {%- comment -%}
        Judge.me's own review widget. The class and data-id are the app's
        hydration contract — renaming either silently removes every
        review on the page.
      {%- endcomment -%}
      <div class="jdgm-widget jdgm-review-widget"
           data-id="{{ product.id }}"
           data-product-title="{{ product.title | escape }}">
        {{- product.metafields.judgeme.widget -}}
      </div>

    {%- else -%}

      {%- if show_summary or ws == 'summary' or ws == 'histogram' -%}
        <div class="rsummary">
          {%- if has_aggregate -%}
            <div class="rsummary__top">
              <span class="rsummary__avg">{{ agg_rating }}</span>
              {%- render 'star-rating', rating: agg_rating, size: 'featured' -%}
              <span class="review__meta">
                {{ 'products.reviews.count' | t: count: agg_count }}
              </span>
            </div>
          {%- endif -%}

          {%- if show_histogram or ws == 'histogram' -%}
            {%- comment -%}
              Histogram. Counts come from the review data passed in; the
              shape is never assumed. Each row is a real filter control
              when `allow_filtering` is set, and inert text otherwise —
              never a div with a click handler.
            {%- endcomment -%}
            <div class="rsummary__hist">
              {%- for star in (1..5) reversed -%}
                {%- assign bucket = 'rating_' | append: star -%}
                {%- assign n = reviews_histogram[bucket] | default: 0 -%}
                {%- assign pct = 0 -%}
                {%- if agg_count != blank and agg_count > 0 -%}
                  {%- assign pct = n | times: 100 | divided_by: agg_count -%}
                {%- endif -%}
                <div class="rsummary__row">
                  {%- if allow_filtering -%}
                    <button type="button" data-review-filter="{{ star }}"
                      aria-label="{{ 'general.accessibility.star_rating' | t: rating: star, rating_max: 5 }}">
                      <span class="review__meta">{{ star }}</span>
                      <span class="rsummary__bar"><i style="width:{{ pct }}%"></i></span>
                      <span class="rsummary__n">{{ n }}</span>
                    </button>
                  {%- else -%}
                    <span class="review__meta">{{ star }}</span>
                    <span class="rsummary__bar" role="img"
                      aria-label="{{ 'products.reviews.count' | t: count: n }}">
                      <i style="width:{{ pct }}%"></i>
                    </span>
                    <span class="rsummary__n">{{ n }}</span>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if ws == 'carousel' -%}
        <div class="carousel carousel--cards" role="region" tabindex="0"
             aria-label="{{ heading | default: '' | escape }}">
          {%- for review in reviews limit: featured -%}
            {%- render 'review-card', review: review, style: 'carousel' -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="rwidget__list">
          {%- for review in reviews limit: featured -%}
            {%- render 'review-card',
              review: review,
              style: review_style | default: 'list',
              show_product: true -%}
          {%- else -%}
            {%- comment -%}
              No reviews in hand. Two of 56 products genuinely have none
              (`soiree`, `sundaze`) — say nothing rather than showing an
              empty widget frame.
            {%- endcomment -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if cta_label != blank -%}
        {%- render 'button', label: cta_label, url: cta_url, style: 'minimal' -%}
      {%- endif -%}

  {%- endcase -%}
</div>
