3e\u003cbr\u003e \u003c\/span\u003e\u003cspan\u003eHeart Notes: Caramel, sugar, creamy gourmand accords\u003c\/span\u003e\u003cspan\u003e\u003cbr\u003e \u003c\/span\u003e\u003cspan\u003eBase Notes: Vanilla, ambergris, warm woods, soft spices\u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eBest For \u003cbr\u003e\u003c\/strong\u003e\u003cspan\u003eEvenings and indulgent moments\u003c\/span\u003e\u003cspan\u003e\u003cbr\u003e \u003c\/span\u003e\u003cspan\u003eDate nights and special occasions\u003c\/span\u003e\u003cspan\u003e\u003cbr\u003e \u003c\/span\u003e\u003cspan\u003eCooler weather\u003c\/span\u003e\u003cspan\u003e\u003cbr\u003e \u003c\/span\u003e\u003cspan\u003eSignature scent for lovers of rich, gourmand fragrances\u003c\/span\u003e\u003c\/p\u003e","published_at":"2026-04-24T01:48:50+03:00","created_at":"2026-04-24T01:37:16+03:00","updated_at":"2026-08-16T18:04:13+03:00","vendor":"Lost In Paris Roja","product_type":"","tags":[],"variants":[{"id":42972997648432,"title":"30 ml","option1":"30 ml","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":false,"featured_image":null,"available":false,"price":"750.00","grams":0,"compare_at_price":null,"position":1,"product_id":7954857918512,"created_at":"2026-04-24T01:44:21+03:00","updated_at":"2026-08-16T18:04:13+03:00"},{"id":42972997681200,"title":"50 ml","option1":"50 ml","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":false,"featured_image":null,"available":false,"price":"1100.00","grams":0,"compare_at_price":null,"position":2,"product_id":7954857918512,"created_at":"2026-04-24T01:44:21+03:00","updated_at":"2026-08-16T18:04:13+03:00"},{"id":42972997713968,"title":"100 ml","option1":"100 ml","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":false,"featured_image":null,"available":false,"price":"1900.00","grams":0,"compare_at_price":null,"position":3,"product_id":7954857918512,"created_at":"2026-04-24T01:44:21+03:00","updated