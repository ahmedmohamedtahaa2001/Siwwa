{%- liquid
  assign icon_size = size | default: 24
  assign stroke = stroke_width | default: 1.5
-%}
<svg class="icon icon--{{ icon | handle }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'search' -%}<circle cx="14.4167" cy="14.4167" r="6.8611" stroke="currentColor" stroke-width="{{ stroke }}"/><line x1="20.0173" y1="20.0173" x2="25.5" y2="25.5" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="square"/>
    {%- when 'close' -%}<line x1="24" y1="8" x2="8" y2="24" stroke="currentColor" stroke-width="{{ stroke }}"/><line x1="8" y1="8" x2="24" y2="24" stroke="currentColor" stroke-width="{{ stroke }}"/>
    {%- when 'menu' -%}<line x1="5" y1="10" x2="27" y2="10" stroke="currentColor" stroke-width="{{ stroke }}"/><line x1="5" y1="22" x2="27" y2="22" stroke="currentColor" stroke-width="{{ stroke }}"/>
    {%- when 'bag' -%}<path d="M8 11h16l-1 16H9L8 11Z" stroke="currentColor" stroke-width="{{ stroke }}"/><path d="M12 12V9a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="{{ stroke }}"/>
    {%- when 'account' -%}<circle cx="16" cy="11" r="5" stroke="currentColor" stroke-width="{{ stroke }}"/><path d="M6 28c.8-6 4.1-9 10-9s9.2 3 10 9" stroke="currentColor" stroke-width="{{ stroke }}"/>
    {%- when 'caret' -%}<path d="m8 13 8 7 8-7" stroke="currentColor" stroke-width="{{ stroke }}"/>
    {%- when 'arrow-right' -%}<path d="M5 16h21M19 9l7 7-7 7" stroke="currentColor" stroke-width="{{ stroke }}"/>
    {%- when 'globe' -%}<circle cx="16" cy="16" r="11" stroke="currentColor" stroke-width="{{ stroke }}"/><path d="M5 16h22M16 5c4 4 4 18 0 22M16 5c-4 4-4 18 0 22" stroke="currentColor" stroke-width="{{ stroke }}"/>
  {%- endcase -%}
</svg>
