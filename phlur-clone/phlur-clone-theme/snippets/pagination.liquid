{% if paginate.pages > 1 %}<nav class="system-pagination" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}" rel="prev">Previous</a>{% endif %}<span aria-current="page">{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}" rel="next">Next</a>{% endif %}</nav>{% endif %}
