{%- if settings.newsletter_popup_enable -%}<div class="newsletter-popup" data-newsletter-popup data-delay="{{ settings.newsletter_popup_delay | times: 1000 }}" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ settings.newsletter_popup_heading | escape }}"><button type="button" data-newsletter-close aria-label="{{ settings.close_label | escape }}">{% render 'icon-svg', icon: 'close', size: settings.shell_icon_size, stroke_width: settings.shell_icon_stroke_width %}</button><h2>{{ settings.newsletter_popup_heading | escape }}</h2><div>{{ settings.newsletter_popup_text }}</div>{% form 'customer', class: 'newsletter-popup__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="{{ settings.newsletter_email_placeholder | escape }}" required><button type="submit">{{ settings.newsletter_submit_label | escape }}</button>{% endform %}</div>{%- endif -%}
