{%- assign mobile_about_url = section.settings.about_link | default: pages.contact.url | default: routes.root_url -%}{%- assign mobile_membership_url = section.settings.membership_link | default: routes.all_products_collection_url -%}
<div id="Details-menu-drawer-container" class="menu-drawer-container">
  <aside id="menu-drawer" class="menu-drawer" data-mobile-menu data-dialog role="dialog" aria-modal="true" aria-label="{{ section.settings.mobile_navigation_label | default: 'Mobile navigation' | escape }}" aria-hidden="true" tabindex="-1">
    <div class="menu-drawer__header"><button type="button" data-mobile-menu-close aria-label="{{ section.settings.close_label | default: 'Close' | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5 19 19M19 5 5 19" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button></div>
    <div class="menu-drawer__inner-container"><div class="menu-drawer__navigation-container">
      <nav class="menu-drawer__navigation" aria-label="{{ section.settings.mobile_navigation_label | default: 'Mobile navigation' | escape }}"><ul class="menu-drawer__menu list-menu" role="list"><li class="js_accordion_menu open"><button type="button" class="menu-drawer__menu-item list-menu__item" data-mobile-shop-toggle aria-expanded="true" aria-controls="MobileShopMenu-{{ section.id }}">{{ section.settings.shop_label | default: 'Shop' | escape }}<span class="chevron" aria-hidden="true"></span></button><div id="MobileShopMenu-{{ section.id }}" class="menu-drawer__submenu"><div class="menu-drawer__inner-submenu"><ul class="menu-drawer__menu list-menu" role="list">{%- for block in section.blocks -%}{%- if block.type == 'shop_link' -%}<li><a class="menu-drawer__menu-item list-menu__item" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.label | escape }}</a></li>{%- endif -%}{%- endfor -%}</ul></div></div></li><li><a class="menu-drawer__menu-item list-menu__item" href="{{ mobile_about_url }}">{{ section.settings.about_label | default: 'Contact' | escape }}</a></li><li><a class="menu-drawer__menu-item list-menu__item" href="{{ mobile_membership_url }}">{{ section.settings.membership_label | default: 'Shop All' | escape }}</a></li></ul></nav>
      <div class="menu-drawer__utility-links"><ul class="menu-drawer__menu list-menu"><li><a href="{{ routes.search_url }}" class="menu-drawer__account h5">Search</a></li>{% if shop.customer_accounts_enabled %}<li><a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="menu-drawer__account h5">{% if customer %}Account{% else %}Sign in{% endif %}</a></li>{% endif %}</ul>
        <div class="menu-drawer__localization"><localization-form>{% form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' %}<h2 class="visually-hidden" id="HeaderCountryMobileLabel">Country/region</h2><div class="disclosure"><button type="button" class="menu-drawer__locale disclosure__button" aria-expanded="false" aria-controls="HeaderCountryMobile-country-results" aria-describedby="HeaderCountryMobileLabel" data-localization-toggle><img src="{{ 'phlur-globe.svg' | asset_url }}" alt="Localization Icon" width="16" height="16"><span>{{ localization.country.name | default: 'United States' }}&nbsp;&nbsp;·&nbsp;&nbsp;{{ localization.country.currency.iso_code | default: 'USD' }}{{ localization.country.currency.symbol | default: '$' }}&nbsp;&nbsp;·&nbsp;&nbsp;{{ localization.language.endonym_name | default: 'English' | capitalize }}</span><svg viewBox="0 0 10 6" aria-hidden="true"><path d="m1 1 4 4 4-4" fill="none" stroke="currentColor"/></svg></button><div class="disclosure__list-wrapper country-selector" id="HeaderCountryMobile-country-results" hidden data-localization-list><button type="button" class="country-selector__close-button" aria-label="Close" data-localization-close><svg viewBox="0 0 18 17" aria-hidden="true"><path d="M1 1 17 16M17 1 1 16" stroke="currentColor"/></svg></button><h3 class="location-title">Location Settings</h3><ul role="list" class="list-unstyled countries"><li><button type="submit" name="country_code" value="US" class="disclosure__link" aria-current="true">United States&nbsp;&nbsp;·&nbsp;&nbsp;USD$&nbsp;&nbsp;·&nbsp;&nbsp;English</button></li><li><button type="submit" name="country_code" value="CA" class="disclosure__link">Canada&nbsp;&nbsp;·&nbsp;&nbsp;CAD$&nbsp;&nbsp;·&nbsp;&nbsp;English</button></li><li><button type="submit" name="country_code" value="CA" class="disclosure__link">Canada&nbsp;&nbsp;·&nbsp;&nbsp;CAD$&nbsp;&nbsp;·&nbsp;&nbsp;French</button></li></ul></div><div class="country-selector__overlay" data-localization-close></div></div><input type="hidden" name="country_code" value="{{ localization.country.iso_code | default: 'US' }}"><input type="hidden" name="language_code" value="{{ localization.language.iso_code | default: 'en' }}">{% endform %}</localization-form></div>
      </div>
    </div></div>
  </aside>
</div><button class="shell-overlay" type="button" data-shell-overlay aria-label="{{ section.settings.close_label | default: 'Close' | escape }}" hidden></button>
