{%- liquid
  assign recommendation_variant = recommendation.selected_or_first_available_variant
  assign recommendation_title = recommendation.metafields.custom.product_title_fragrance.value | default: recommendation.title | default: fallback_title
  assign recommendation_subtitle = recommendation.metafields.custom.product_title_category.value | default: recommendation.metafields.custom.subtitle.value | default: recommendation.metafields.descriptors.subtitle.value | default: fallback_subtitle
  if recommendation_subtitle == blank and recommendation.has_only_default_variant == false
    assign recommendation_subtitle = recommendation_variant.title
  endif
-%}
<li class="cart-drawer__recommendation swiper-slide{% if index == 1 %} swiper-slide-active{% elsif index == 2 %} swiper-slide-next{% endif %}" role="group">
  <div class="rebuy-product-media"><a class="cart-drawer__recommendation-image rebuy-product-image clickable" href="{{ recommendation.url | default: fallback_link }}">{%- if recommendation != blank -%}{{- recommendation.featured_image | image_url: width: 600 | image_tag: class: 'primary-image', loading: 'lazy', widths: '189, 378, 600', alt: recommendation.featured_image.alt -}}{%- if recommendation.images[1] -%}{{- recommendation.images[1] | image_url: width: 600 | image_tag: class: 'secondary-image', loading: 'lazy', widths: '189, 378, 600', alt: '' -}}{%- endif -%}{%- else -%}{%- assign fallback_image_prefix = fallback_image | slice: 0, 4 -%}<img class="primary-image" src="{% if fallback_image_prefix == 'http' %}{{ fallback_image }}{% else %}{{ fallback_image | asset_url }}{% endif %}" alt="{{ recommendation_title | escape }}" width="800" height="800" loading="lazy">{%- endif -%}</a></div>
  <div class="rebuy-product-info"><a class="cart-drawer__recommendation-product-title rebuy-product-title clickable" href="{{ recommendation.url | default: fallback_link }}" role="heading" aria-level="5"><span class="product-title-metafield">{{ recommendation_title }}</span><span class="variant">{{ recommendation_subtitle }}</span></a></div>
  <div class="rebuy-product-actions">{%- if recommendation != blank -%}<form action="{{ routes.cart_add_url }}" method="post" data-cart-recommendation-form><input type="hidden" name="id" value="{{ recommendation_variant.id }}"><button class="rebuy-button" type="submit" {% unless recommendation_variant.available %}disabled{% endunless %}><span>{% if recommendation_variant.available %}Add{% else %}Sold out{% endif %}</span><span aria-hidden="true">·</span><span class="rebuy-product-price">{{ recommendation_variant.price | money_without_trailing_zeros }}</span>{%- if recommendation_variant.compare_at_price > recommendation_variant.price -%}<s>{{ recommendation_variant.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}</button></form>{%- else -%}<a class="rebuy-button" href="{{ fallback_link }}"><span>Add</span><span aria-hidden="true">·</span><span class="rebuy-product-price">{{ fallback_price }}</span>{%- unless fallback_compare == 'none' -%}<s>{{ fallback_compare }}</s>{%- endunless -%}</a>{%- endif -%}</div>
</li>
