<li id="Slide-{{ section_id }}-{{ index }}" class="swiper-slide featured-collection__slide{% if index == 1 %} swiper-slide-active{% elsif index == 2 %} swiper-slide-next{% endif %}" data-cascade style="--animation-order:{{ index }};margin-right:16px">
  <div class="card-wrapper product-card-wrapper underline-links-hover"><div class="card card--standard card--media" style="--ratio-percent:100%">
    <div class="card__inner color-scheme-2 gradient ratio" style="--ratio-percent:100%"><div class="card__media"><div class="media media--transparent media--hover-effect">
      {%- if product != blank and product.featured_media != blank -%}
        {{ product.featured_media | image_url: width: 1066 | image_tag: widths: '165,360,533,720,940,1066', sizes: '(min-width:1600px) 367px, (min-width:990px) calc((100vw - 130px)/4), (min-width:750px) calc((100vw - 120px)/3), calc((100vw - 35px)/2)', class: 'motion-reduce', loading: 'lazy' }}
        {%- if product.media[1] != blank -%}{{ product.media[1] | image_url: width: 1066 | image_tag: widths: '165,360,533,720,940,1066', sizes: '(min-width:1600px) 367px, (min-width:990px) calc((100vw - 130px)/4), (min-width:750px) calc((100vw - 120px)/3), calc((100vw - 35px)/2)', class: 'motion-reduce featured-collection__hover-image', loading: 'lazy' }}{%- else -%}<img src="{{ fallback_hover }}" alt="" class="motion-reduce featured-collection__hover-image" width="1066" height="1066" loading="lazy">{%- endif -%}
      {%- else -%}
        <img src="{{ fallback_image }}&amp;width=533" srcset="{{ fallback_image }}&amp;width=165 165w, {{ fallback_image }}&amp;width=360 360w, {{ fallback_image }}&amp;width=533 533w, {{ fallback_image }}&amp;width=720 720w, {{ fallback_image }}&amp;width=940 940w, {{ fallback_image }}&amp;width=1066 1066w" sizes="(min-width:1600px) 367px, (min-width:990px) calc((100vw - 130px)/4), (min-width:750px) calc((100vw - 120px)/3), calc((100vw - 35px)/2)" alt="{{ alts[ix] | escape }}" class="motion-reduce" width="4000" height="4000" loading="lazy"><img src="{{ fallback_hover }}&amp;width=533" srcset="{{ fallback_hover }}&amp;width=165 165w, {{ fallback_hover }}&amp;width=360 360w, {{ fallback_hover }}&amp;width=533 533w, {{ fallback_hover }}&amp;width=720 720w, {{ fallback_hover }}&amp;width=940 940w, {{ fallback_hover }}&amp;width=1066 1066w" sizes="(min-width:1600px) 367px, (min-width:990px) calc((100vw - 130px)/4), (min-width:750px) calc((100vw - 120px)/3), calc((100vw - 35px)/2)" alt="" class="motion-reduce featured-collection__hover-image" width="4000" height="4000" loading="lazy">
      {%- endif -%}
    </div></div><div class="card__content"><div class="card__information"><h4 class="card__heading aktiv"><a id="StandardCardNoMediaLink-{{ section_id }}-{{ index }}" href="{{ display_url }}" class="full-unstyled-link" aria-labelledby="StandardCardNoMediaLink-{{ section_id }}-{{ index }}{% if display_badge != blank %} NoMediaStandardBadge-{{ section_id }}-{{ index }}{% endif %}">{{ full_title | escape }}</a></h4></div>{% if display_badge != blank %}<div class="card__badge top left show-label-badge"><span class="badge badge-label badge--bottom-left" id="NoMediaStandardBadge-{{ section_id }}-{{ index }}" style="background-color:#fff;color:#000">{{ display_badge }}</span></div>{% endif %}</div></div>
    <div class="card__content"><div class="card__information">{% if display_badge != blank %}<span id="Badge-{{ section_id }}-{{ index }}" class="visually-hidden">{{ display_badge }}</span>{% endif %}<h4 class="card__heading aktiv" id="title-{{ section_id }}-{{ index }}"><a id="CardLink-{{ section_id }}-{{ index }}" href="{{ display_url }}" class="full-unstyled-link" aria-labelledby="CardLink-{{ section_id }}-{{ index }}{% if display_badge != blank %} Badge-{{ section_id }}-{{ index }}{% endif %}">{{ display_title | escape }}<br><p class="variant-info p2">{{ display_subtitle | escape }}</p></a></h4><div class="card-information"><span class="caption-large light"></span></div></div>
      <div class="quick-add no-js-hidden"><product-form data-section-id="{{ section_id }}"><form method="post" action="{{ routes.cart_add_url | default: '/cart/add' }}" id="quick-add-{{ section_id }}{{ variant_id }}" accept-charset="UTF-8" class="form" enctype="multipart/form-data" novalidate="novalidate" data-type="add-to-cart-form"><input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓"><input type="hidden" name="id" value="{{ variant_id }}" class="product-variant-id"><button type="submit" id="quick-add-{{ section_id }}{{ variant_id }}-submit" class="quick-add__submit outline-black button button--full-width" aria-labelledby="quick-add-{{ section_id }}{{ variant_id }}-submit title-{{ section_id }}-{{ index }}" aria-live="polite" data-sold-out-message="true"{% unless product_available %} disabled aria-disabled="true"{% endunless %}><span class="flex-container-row{% unless product_available %} hidden{% endunless %}"><span class="add">{{ add_label | default: 'Add' | escape }}</span><span aria-hidden="true">&nbsp;·&nbsp;</span><span class="price"><span class="price__container"><span class="price__regular"><span class="visually-hidden visually-hidden--inline">Regular price</span><span class="price-item price-item--regular">{{ display_price }}</span></span>{% if compare_price != blank %}<span class="price__sale"><span class="visually-hidden visually-hidden--inline">Regular price</span><s class="price-item price-item--regular">{{ compare_price }}</s></span>{% endif %}</span></span></span><span class="sold-out-message{% if product_available %} hidden{% endif %}">Sold out</span><span class="loading__spinner hidden" aria-hidden="true"><svg class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg></span></button><input type="hidden" name="product-id" value="{{ form_product_id }}"><input type="hidden" name="section-id" value="{{ section_id }}"></form></product-form></div>
    </div>
  </div></div>
</li>
