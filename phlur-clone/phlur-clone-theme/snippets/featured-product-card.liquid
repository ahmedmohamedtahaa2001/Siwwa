  assign fallback_url = '/products/' | append: product_handles[ix]
  assign fallback_image = images[ix]
  assign fallback_hover = hovers[ix]
  if fallback_catalog == 'perfumes'
    assign fallback_image = images[ix] | asset_url | append: '?v=1'
    assign fallback_hover = hovers[ix] | asset_url | append: '?v=1'
  endif
  assign display_title = product.metafields.custom.display_title | default: titles[ix]
  assign full_title = product.title | default: full_titles[ix]
  assign display_subtitle = product.metafields.custom.display_subtitle | default: product.metafields.descriptors.subtitle | default: subtitles[ix]
  assign display_badge = product.metafields.custom.badge | default: product.metafields.descriptors.badge | default: badges[ix]
  assign display_url = product.url | default: fallback_url
  assign variant_id = product.selected_or_first_available_variant.id | default: variants[ix]
  assign form_product_id = product.id | default: product_ids[ix]
  assign product_available = true
  if product != blank and product.selected_or_first_available_variant.available == false
    assign product_available = false
  endif
  assign display_price = prices[ix]
  assign compare_price = compares[ix] | strip
  if product != blank and product.price != blank
    assign display_price = product.price | money
    if product.compare_at_price > product.price
      assign compare_price = product.compare_at_price | money
    else
      assign compare_price = blank
    endif
