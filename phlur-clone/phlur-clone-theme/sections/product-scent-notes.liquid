{{ 'product-scent-notes.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }}{--scent-notes-bg:{{ section.settings.background_color }};--scent-notes-text:{{ section.settings.text_color }};--scent-border:{{ section.settings.border_color }};--scent-notes-gap:{{ section.settings.item_gap }}px;--scent-stack-gap:{{ section.settings.stack_gap }}px;--scent-heading-gap:{{ section.settings.heading_gap }}px;--scent-heading-gap-tablet:{{ section.settings.heading_gap_tablet }}px;--scent-row-padding:{{ section.settings.row_padding }}px;--scent-row-padding-mobile:{{ section.settings.row_padding_mobile }}px;--scent-heading-size:{{ section.settings.heading_size }}px;--scent-heading-tracking:{{ section.settings.heading_tracking | divided_by: 100.0 }}px;--scent-label-size:{{ section.settings.label_size }}px;--scent-label-tracking:{{ section.settings.label_tracking | divided_by: 100.0 }}px;--scent-notes-size:{{ section.settings.notes_size }}px;margin-top:{{ section.settings.margin_top }}px;margin-bottom:{{ section.settings.margin_bottom }}px;background:var(--scent-notes-bg);color:var(--scent-notes-text)}
  #shopify-section-{{ section.id }} .scent-notes{box-sizing:border-box;max-width:{{ section.settings.section_max_width }}px;padding:{{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px}
  #shopify-section-{{ section.id }} .scent-notes__image{object-position:{{ section.settings.image_position }}}
  @media(max-width:989px){#shopify-section-{{ section.id }} .scent-notes{padding:0 {{ section.settings.tablet_padding_horizontal }}px {{ section.settings.padding_bottom }}px}}
  @media(max-width:749px){#shopify-section-{{ section.id }} .scent-notes{padding:{{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_horizontal }}px {{ section.settings.mobile_padding_bottom }}px}}
{% endstyle %}
<div class="page-width container-padding-60 scent-notes scroll-trigger animate--slide-in">
  <h2 class="aktiv">{{ section.settings.heading | escape }}</h2>
  <div class="flex-container-row">
    <div class="flex-one-third">
      {%- for block in section.blocks -%}<div class="scent-note-section" {{ block.shopify_attributes }}><h4 class="mono">{{ block.settings.label | escape }}</h4><span class="h2 repro">{{ block.settings.notes | newline_to_br }}</span></div>{%- endfor -%}
    </div>
    <div class="flex-two-thirds">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'scent-notes__image', alt: section.settings.image_alt }}{% else %}<img class="scent-notes__image" src="{{ section.settings.fallback_asset | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1600" height="1200">{% endif %}</div>
  </div>
</div>
{% schema %}
{"name":"Product scent notes","settings":[{"type":"text","id":"heading","label":"Heading","default":"Scent Notes"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_alt","label":"Image alt text"},{"type":"text","id":"fallback_asset","label":"Fallback asset","default":"phlur-vanilla-skin-perfume-scent-notes.jpg"},{"type":"select","id":"image_position","label":"Image position","default":"center center","options":[{"value":"center center","label":"Center"},{"value":"top center","label":"Top"},{"value":"bottom center","label":"Bottom"}]},{"type":"color","id":"background_color","label":"Background","default":"#fafafa"},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"border_color","label":"Divider","default":"#bdbdbd"},{"type":"header","content":"Typography"},{"type":"range","id":"heading_size","label":"Heading size","min":12,"max":40,"step":1,"unit":"px","default":18},{"type":"range","id":"heading_tracking","label":"Heading letter spacing","min":0,"max":200,"step":2,"unit":"%","default":96},{"type":"range","id":"label_size","label":"Label size","min":8,"max":20,"step":1,"unit":"px","default":11},{"type":"range","id":"label_tracking","label":"Label letter spacing","min":0,"max":160,"step":2,"unit":"%","default":78},{"type":"range","id":"notes_size","label":"Notes size","min":12,"max":32,"step":1,"unit":"px","default":20},{"type":"header","content":"Layout & Spacing"},{"type":"range","id":"padding_top","label":"Padding top","min":0,"max":160,"step":2,"unit":"px","default":60},{"type":"range","id":"padding_right","label":"Padding right","min":0,"max":160,"step":2,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":160,"step":2,"unit":"px","default":60},{"type":"range","id":"padding_left","label":"Padding left","min":0,"max":160,"step":2,"unit":"px","default":80},{"type":"range","id":"margin_top","label":"Margin top","min":0,"max":120,"step":2,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Margin bottom","min":0,"max":120,"step":2,"unit":"px","default":0},{"type":"range","id":"section_max_width","label":"Maximum width","min":800,"max":2000,"step":20,"unit":"px","default":2000},{"type":"range","id":"item_gap","label":"Column gap","min":0,"max":80,"step":2,"unit":"px","default":30},{"type":"range","id":"stack_gap","label":"Stacked gap","min":0,"max":60,"step":1,"unit":"px","default":20},{"type":"range","id":"heading_gap","label":"Heading bottom gap","min":0,"max":80,"step":1,"unit":"px","default":32},{"type":"range","id":"heading_gap_tablet","label":"Tablet heading gap","min":0,"max":60,"step":1,"unit":"px","default":20},{"type":"range","id":"row_padding","label":"Note row padding","min":0,"max":60,"step":1,"unit":"px","default":24},{"type":"range","id":"row_padding_mobile","label":"Mobile note row padding","min":0,"max":60,"step":1,"unit":"px","default":20},{"type":"range","id":"tablet_padding_horizontal","label":"Tablet horizontal padding","min":0,"max":80,"step":2,"unit":"px","default":40},{"type":"range","id":"mobile_padding_top","label":"Mobile padding top","min":0,"max":120,"step":2,"unit":"px","default":40},{"type":"range","id":"mobile_padding_bottom","label":"Mobile padding bottom","min":0,"max":120,"step":2,"unit":"px","default":40},{"type":"range","id":"mobile_padding_horizontal","label":"Mobile horizontal padding","min":0,"max":60,"step":1,"unit":"px","default":20}],"blocks":[{"type":"note","name":"Note group","settings":[{"type":"text","id":"label","label":"Label","default":"Top"},{"type":"textarea","id":"notes","label":"Notes","default":"Pink Pepper\nPink Apple\nSugar Crystals"}]}],"max_blocks":3,"presets":[{"name":"Product scent notes","blocks":[{"type":"note"},{"type":"note","settings":{"label":"Heart","notes":"Lily\nJasmine Petals\nCashmere Wood"}},{"type":"note","settings":{"label":"Base","notes":"Benzoin\nVanilla\nSandalwood\nAgarwood"}}]}]}
{% endschema %}
