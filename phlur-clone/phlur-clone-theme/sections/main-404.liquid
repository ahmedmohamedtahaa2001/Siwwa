{{ 'system-pages.css' | asset_url | stylesheet_tag }}
<section class="system-page"><header class="system-page__header"><p class="system-meta">404</p><h1 class="system-page__title">{{ section.settings.heading | escape }}</h1><p>{{ section.settings.body | escape }}</p></header><a class="system-page__button" href="{{ routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a></section>
{% schema %}{"name":"404","settings":[{"type":"text","id":"heading","label":"Heading","default":"Page not found"},{"type":"text","id":"body","label":"Message","default":"The page you requested does not exist or has moved."},{"type":"text","id":"button_label","label":"Button label","default":"Continue shopping"}]}{% endschema %}
