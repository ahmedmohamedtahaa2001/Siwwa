{{ 'system-pages.css' | asset_url | stylesheet_tag }}
<section class="system-page"><header class="system-page__header"><h1 class="system-page__title">{{ blog.title | escape }}</h1></header>{% paginate blog.articles by 12 %}<ul class="system-grid" role="list">{% for article in blog.articles %}<li class="system-card"><a class="system-card__image" href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320, 640, 1000', alt: article.image.alt }}{% endif %}</a><h2 class="system-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p class="system-meta">{{ article.published_at | date: format: 'date' }}</p></li>{% endfor %}</ul>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}{"name":"Blog","settings":[]}{% endschema %}
