{%- if predictive_search.performed -%}
  <div class="predictive-search-results" role="listbox" aria-label="{{ section.settings.results_label | escape }}">
    {%- if predictive_search.resources.products.size > 0 -%}
      <h2>{{ section.settings.products_heading | escape }}</h2>
      <ul role="group">
        {%- for product in predictive_search.resources.products limit: section.settings.products_limit -%}
          <li role="option"><a href="{{ product.url }}">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}{%- endif -%}<span>{{ product.title }}</span><span>{{ product.price | money }}</span></a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if predictive_search.resources.queries.size > 0 -%}<h2>{{ section.settings.suggestions_heading | escape }}</h2><ul role="group">{%- for query in predictive_search.resources.queries -%}<li role="option"><a href="{{ query.url }}">{{ query.styled_text }}</a></li>{%- endfor -%}</ul>{%- endif -%}
  </div>
{%- endif -%}
{% schema %}
{"name":"Predictive search","settings":[{"type":"text","id":"results_label","label":"Results accessibility label","default":"Search results"},{"type":"text","id":"products_heading","label":"Products heading","default":"Products"},{"type":"text","id":"suggestions_heading","label":"Suggestions heading","default":"Suggestions"},{"type":"range","id":"products_limit","label":"Products shown","min":2,"max":10,"step":1,"default":6},{"type":"header","content":"Layout & Spacing"},{"type":"range","id":"padding_top","label":"Padding top (desktop)","min":0,"max":200,"step":4,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Padding bottom (desktop)","min":0,"max":200,"step":4,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Padding left (desktop)","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Padding right (desktop)","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_top","label":"Margin top","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Margin bottom","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"section_max_width","label":"Max width","min":800,"max":1920,"step":40,"unit":"px","default":1440},{"type":"range","id":"item_gap","label":"Gap between items","min":0,"max":80,"step":4,"unit":"px","default":24},{"type":"header","content":"Mobile Spacing"},{"type":"range","id":"mobile_padding_top","label":"Padding top (mobile)","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_padding_bottom","label":"Padding bottom (mobile)","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_padding_horizontal","label":"Horizontal padding (mobile)","min":0,"max":60,"step":4,"unit":"px","default":0}]}
{% endschema %}
