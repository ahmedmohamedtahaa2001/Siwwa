{{ 'phlur-header.css' | asset_url | stylesheet_tag }}
{{ 'mobile-drawer.css' | asset_url | stylesheet_tag }}
{%- assign about_url = section.settings.about_link | default: pages.contact.url | default: routes.root_url -%}{%- assign membership_url = section.settings.membership_link | default: routes.all_products_collection_url -%}
<sticky-header data-sticky-type="always" class="header-wrapper color-scheme-1 header-wrapper--border-bottom"><header class="header header--middle-left header--mobile-left page-width header--has-menu header--has-social header--has-account"><div class="header-wrap"><div class="header-left-align-wrap"><div class="logo-wrap"><h1 class="header__heading"><a href="{{ routes.root_url }}" class="header__heading-link link link--text"><span class="header__heading-logo-wrapper"><img src="{{ 'phlur-logotype.svg' | asset_url }}" alt="{{ section.settings.logo_alt | default: shop.name | escape }}" width="79" height="24"></span></a></h1></div><nav class="header__inline-menu" aria-label="Main navigation"><ul class="list-menu list-menu--inline" role="list"><li><button id="shop-nav-trigger" class="header__menu-item list-menu__item link link--text focus-inset" aria-expanded="false" aria-controls="shop-main-drawer" data-shop-trigger><span>{{ section.settings.shop_label | default: 'Shop' | escape }}</span></button></li><li><a id="HeaderMenu-about" href="{{ about_url }}" class="header__menu-item list-menu__item link link--text focus-inset"><span>{{ section.settings.about_label | default: 'Contact' | escape }}</span></a></li><li><a id="HeaderMenu-membership" href="{{ membership_url }}" class="header__menu-item list-menu__item link link--text focus-inset"><span>{{ section.settings.membership_label | default: 'Shop All' | escape }}</span></a></li></ul></nav></div><div class="header__icons"><button type="button" class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle" aria-haspopup="dialog" aria-label="Search" data-search-open><span class="search-icons">{% render 'icon-phlur-search' %}</span></button>{% if shop.customer_accounts_enabled %}<a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header__icon header__icon--account link focus-inset small-hide"><img src="{{ 'phlur-profile.svg' | asset_url }}" alt="" width="26" height="26"><span class="visually-hidden">{% if customer %}Account{% else %}Log in{% endif %}</span></a>{% endif %}<button type="button" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble" data-cart-open aria-haspopup="dialog"><span class="visually-hidden">Cart</span><img src="{{ 'phlur-cart.svg' | asset_url }}" alt="" width="26" height="26"><span class="cart-count{% if cart.item_count == 0 %} hidden{% endif %}" data-cart-count>{{ cart.item_count }}</span></button><noscript><a href="{{ routes.cart_url }}" class="visually-hidden">Cart</a></noscript><button type="button" class="header__icon header__icon--menu header__icon--summary" aria-label="Menu" data-mobile-menu-open>{% render 'icon-phlur-menu' %}</button></div></div></header></sticky-header>
{% render 'mega-menu', section: section %}{% render 'mobile-menu', section: section %}{% render 'search-overlay', section: section %}
{% schema %}
{"name":"Header","settings":[{"type":"text","id":"logo_alt","label":"Logo alt text","default":"Phlur logo"},{"type":"text","id":"shop_label","label":"Shop label","default":"Shop"},{"type":"text","id":"about_label","label":"About label","default":"About"},{"type":"url","id":"about_link","label":"About link"},{"type":"text","id":"membership_label","label":"Membership label","default":"Membership"},{"type":"url","id":"membership_link","label":"Membership link"},{"type":"text","id":"navigation_label","label":"Navigation label","default":"Main navigation"},{"type":"text","id":"mobile_navigation_label","label":"Mobile navigation label","default":"Mobile navigation"},{"type":"text","id":"search_label","label":"Search label","default":"Search"},{"type":"text","id":"search_placeholder","label":"Search placeholder","default":"Search"},{"type":"text","id":"search_submit_label","label":"Search submit label","default":"Search"},{"type":"text","id":"account_label","label":"Account label","default":"Log in"},{"type":"text","id":"cart_label","label":"Cart label","default":"Cart"},{"type":"text","id":"menu_open_label","label":"Menu label","default":"Menu"},{"type":"text","id":"close_label","label":"Close label","default":"Close"},{"type":"text","id":"popular_searches_heading","label":"Popular searches heading","default":"Popular Searches"},{"type":"text","id":"popular_icon_url","label":"Popular search icon URL","default":"https://cdn.shopify.com/s/files/1/0517/7203/1157/files/Glass.svg?v=1785720242"},{"type":"text","id":"trending_products_heading","label":"Trending products heading","default":"Trending Products"}],"blocks":[{"type":"menu_column","name":"Menu column","settings":[{"type":"text","id":"column_id","label":"Column ID","default":"shop"},{"type":"text","id":"heading","label":"Heading","default":"Shop"},{"type":"url","id":"heading_link","label":"Heading link"},{"type":"link_list","id":"menu","label":"Menu"}]},{"type":"shop_link","name":"Shop link","settings":[{"type":"text","id":"column","label":"Column","default":"shop"},{"type":"text","id":"label","label":"Label","default":"Shop All"},{"type":"url","id":"link","label":"Link"}]},{"type":"featured_card","name":"Featured card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"image_url","label":"Fallback image URL"},{"type":"text","id":"image_alt","label":"Alt text"},{"type":"text","id":"label","label":"Label","default":"New arrivals"},{"type":"url","id":"link","label":"Link"}]},{"type":"popular_search","name":"Popular search","settings":[{"type":"text","id":"label","label":"Label","default":"Missing Person"},{"type":"url","id":"link","label":"Link"}]},{"type":"trending_product","name":"Trending product","settings":[{"type":"text","id":"title","label":"Title","default":"Mini Perfume Set"},{"type":"text","id":"subtitle","label":"Subtitle","default":"4 x 7mL Eau de Parfum"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"image_url","label":"Image URL"},{"type":"text","id":"image_alt","label":"Image alt text"}]}],"presets":[{"name":"Header"}]}
{% endschema %}
