{{ 'product-related-collection.css' | asset_url | stylesheet_tag }}{{ 'component-loading-spinner.css' | asset_url | stylesheet_tag }}<script src="{{ 'product-related-collection.js' | asset_url }}" defer></script>
{% style %}#shopify-section-{{ section.id }}{--related-bg:{{ section.settings.background_color }};--related-text:{{ section.settings.text_color }};--related-badge-bg:{{ section.settings.badge_background }};--related-badge-text:{{ section.settings.badge_color }};--related-button-bg:{{ section.settings.button_background }};--related-button-text:{{ section.settings.button_text }};--related-working-bg:{{ section.settings.button_working_background }};--related-working-text:{{ section.settings.button_working_text }};--related-gap:{{ section.settings.item_gap }}px;--related-duration:{{ section.settings.transition_duration }}ms;--related-hover-duration:{{ section.settings.hover_transition_duration }}ms;--related-gutter:{{ section.settings.desktop_gutter }}px;--related-max-width:{{ section.settings.section_max_width }}px;padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;margin:{{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px;background:var(--related-bg);color:var(--related-text)}#shopify-section-{{ section.id }} [data-related-collection]{--related-nav-size:{{ section.settings.nav_size }}px;--related-nav-prev:{{ section.settings.nav_previous_offset }}px;--related-nav-next:{{ section.settings.nav_next_offset }}px;--related-heading-margin:{{ section.settings.heading_margin_bottom }}px}@media(max-width:989px){#shopify-section-{{ section.id }}{--related-gutter:{{ section.settings.tablet_gutter }}px}}@media(max-width:749px){#shopify-section-{{ section.id }}{--related-gutter:{{ section.settings.mobile_padding_horizontal }}px;padding-top:{{ section.settings.mobile_padding_top }}px;padding-bottom:{{ section.settings.mobile_padding_bottom }}px}}{% endstyle %}
<div id="collection-{{ section.id }}" class="collection related-products-wrap section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}" data-related-collection data-section-id="{{ section.id }}"><div class="page-width"><div class="container-top-padding-40"><div class="collection__title title-wrapper title-wrapper--no-top-margin page-width"><h2 class="title aktiv inline-richtext scroll-trigger animate--slide-in">{{ section.settings.heading }}</h2></div></div></div><div class="slider-wrapper"><div class="swiper relatedCollectionSwiper swiper-initialized swiper-horizontal" data-related-slider tabindex="0"><ul id="Slider-{{ section.id }}" class="rebuy-widget-container swiper-wrapper" role="list" aria-label="{{ section.settings.slider_label }}">{%- if section.settings.source_mode == 'blocks' -%}{%- for block in section.blocks -%}
{%- liquid
  assign forced_badge = blank
  case forloop.index
    when 1
      assign forced_badge = 'NEW'
    when 2, 3, 4, 6
      assign forced_badge = 'BESTSELLER'
    when 5
      assign forced_badge = 'NEW'
    when 13
      assign forced_badge = 'FAREWELL SALE'
  endcase
-%}
{%- if block.settings.product != blank -%}{% render 'molecule-related-product-card', product: block.settings.product, section: section, settings: section.settings, block: block, forced_badge: forced_badge %}{%- else -%}
{%- case forloop.index -%}
  {%- when 5 -%}{% render 'molecule-related-fallback-card', section: section, block: block, title: 'Honey Moon', handle: 'honey-moon-50ml', primary_asset: 'honeymoon-50ml-ledge.jpg', secondary_asset: 'honeymoon-50ml-editorial-1.jpg', badge: 'NEW' %}
  {%- when 6 -%}{% render 'molecule-related-fallback-card', section: section, block: block, title: 'Cherry Stem', handle: 'cherry-stem-50ml', primary_asset: 'CherryStem-50mL-Ledge.jpg', secondary_asset: 'CherryStem-50mL-Editorial5.jpg', badge: 'BESTSELLER' %}
  {%- when 7 -%}{% render 'molecule-related-fallback-card', section: section, block: block, title: 'Strawberry Letter', handle: 'strawberry-letter-perfume', primary_asset: 'StrawberryLetter-50mL.jpg', secondary_asset: 'Nav_-_Collection_Feature_-_Strawberry_Letter.jpg' %}
  {%- when 8 -%}{% render 'molecule-related-fallback-card', section: section, block: block, title: 'Golden Rule', handle: 'golden-rule-50ml', primary_asset: 'PHLUR_Ecomm_PDP_EDP_50ml_GoldenRule.jpg', secondary_asset: 'Golden_Rule_-_50mL_-_Editorial.jpg' %}
  {%- when 9 -%}{% render 'molecule-related-fallback-card', section: section, block: block, title: 'Afterglow', handle: 'afterglow-50ml', primary_asset: 'Afterglow-50mL-Ledge.jpg', secondary_asset: 'Afterglow_-_50mL_-_Editorial.jpg' %}
  {%- when 10 -%}{% render 'molecule-related-fallback-card', section: section, block: block, title: 'Rose Whip', handle: 'rose-whip-50ml', primary_asset: 'Rose_Whip_-_50mL_Allure_2025.jpg', secondary_asset: 'RoseWhip-50mL-Editorial.jpg' %}
  {%- when 11 -%}{% render 'molecule-related-fallback-card', section: section, block: block, title: 'Soft Spot', handle: 'soft-spot-50ml', primary_asset: '1-PHLUR_PDP_SoftSpot_EDP_CapOn.jpg', secondary_asset: 'SoftSpot-FS.jpg' %}
  {%- when 12 -%}{% render 'molecule-related-fallback-card', section: section, block: block, title: 'Mood Ring', handle: 'mood-ring-50ml', primary_asset: 'MoodRing-50mL.jpg', secondary_asset: '6-PHLR_PDP_MoodRing_50ml_EDP_Editorial.jpg' %}
  {%- when 13 -%}{% render 'molecule-related-fallback-card', section: section, block: block, title: 'Somebody Wood', handle: 'somebody-wood-50ml', primary_asset: '1-PHLUR_PDP_SomebodyWood_EDP_CapOn.jpg', secondary_asset: 'C-PHLUR_PDP_SomebodyWood_EDP_Editorial.jpg', badge: 'FAREWELL SALE' %}
{%- endcase -%}
{%- endif -%}{%- endfor -%}{%- else -%}{%- for item in section.settings.collection.products limit: section.settings.product_limit -%}{% render 'molecule-related-product-card', product: item, section: section, settings: section.settings %}{%- endfor -%}{%- endif -%}</ul><button class="swiper-button-prev swiper-button swiper-button-disabled" type="button" aria-label="{{ section.settings.previous_label }}" aria-disabled="true"><span class="nav-arrow"><span class="nav-arrow-bg-circle"></span><img class="product-gallery-nav-icon" src="{{ section.settings.previous_icon_asset | asset_url }}" alt="" width="24" height="24"></span></button><button class="swiper-button-next swiper-button" type="button" aria-label="{{ section.settings.next_label }}" aria-disabled="false"><span class="nav-arrow"><span class="nav-arrow-bg-circle"></span><img class="product-gallery-nav-icon" src="{{ section.settings.next_icon_asset | asset_url }}" alt="" width="24" height="24"></span></button></div></div></div>
{% schema %}
{"name":"Related products","settings":[{"type":"select","id":"source_mode","label":"Source","default":"collection","options":[{"value":"collection","label":"Collection"},{"value":"blocks","label":"Ordered blocks"}]},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"heading","label":"Heading","default":"The Body Mist Collection"},{"type":"range","id":"product_limit","label":"Product limit","min":1,"max":19,"step":1,"default":19},{"type":"text","id":"variant_label","label":"Variant label","default":"Full Size Body Mist"},{"type":"text","id":"add_label","label":"Add label","default":"Add"},{"type":"text","id":"sold_out_label","label":"Sold out label","default":"Sold out"},{"type":"text","id":"regular_price_label","label":"Price accessibility label","default":"Regular price"},{"type":"text","id":"slider_label","label":"Slider label","default":"Slider"},{"type":"text","id":"previous_label","label":"Previous label","default":"Previous products"},{"type":"text","id":"next_label","label":"Next label","default":"Next products"},{"type":"text","id":"bestseller_tag","label":"Bestseller tag","default":"Bestseller"},{"type":"text","id":"bestseller_label","label":"Bestseller badge","default":"BESTSELLER"},{"type":"text","id":"fallback_badge","label":"Fallback badge"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"color","id":"background_color","label":"Background","default":"#fafafa"},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"badge_background","label":"Badge background","default":"#ffffff"},{"type":"color","id":"badge_color","label":"Badge text","default":"#000000"},{"type":"color","id":"button_background","label":"Button background","default":"#ffffff"},{"type":"color","id":"button_text","label":"Button text","default":"#000000"},{"type":"color","id":"button_working_background","label":"Working background","default":"#000000"},{"type":"color","id":"button_working_text","label":"Working text","default":"#ffffff"},{"type":"text","id":"previous_icon_asset","label":"Previous icon","default":"Chevron-L.svg"},{"type":"text","id":"next_icon_asset","label":"Next icon","default":"Chevron-R.svg"},{"type":"range","id":"nav_size","label":"Navigation size","min":24,"max":64,"step":2,"unit":"px","default":48},{"type":"range","id":"nav_previous_offset","label":"Previous offset","min":0,"max":80,"step":2,"unit":"px","default":16},{"type":"range","id":"nav_next_offset","label":"Next offset","min":0,"max":80,"step":2,"unit":"px","default":16},{"type":"range","id":"transition_duration","label":"Slide transition","min":100,"max":1000,"step":50,"unit":"ms","default":300},{"type":"range","id":"hover_transition_duration","label":"Hover transition","min":100,"max":1000,"step":50,"unit":"ms","default":200},{"type":"header","content":"Layout & Spacing"},{"type":"range","id":"padding_top","label":"Padding top","min":0,"max":160,"step":2,"unit":"px","default":38},{"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":160,"step":2,"unit":"px","default":0},{"type":"range","id":"margin_top","label":"Margin top","min":0,"max":120,"step":2,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Margin bottom","min":0,"max":120,"step":2,"unit":"px","default":0},{"type":"range","id":"section_max_width","label":"Maximum width","min":800,"max":2000,"step":20,"unit":"px","default":1600},{"type":"range","id":"item_gap","label":"Item gap","min":0,"max":40,"step":1,"unit":"px","default":16},{"type":"range","id":"desktop_gutter","label":"Desktop gutter","min":0,"max":120,"step":2,"unit":"px","default":80},{"type":"range","id":"tablet_gutter","label":"Tablet gutter","min":0,"max":80,"step":2,"unit":"px","default":40},{"type":"range","id":"mobile_padding_top","label":"Mobile padding top","min":0,"max":120,"step":2,"unit":"px","default":28},{"type":"range","id":"mobile_padding_bottom","label":"Mobile padding bottom","min":0,"max":120,"step":2,"unit":"px","default":0},{"type":"range","id":"mobile_padding_horizontal","label":"Mobile horizontal padding","min":0,"max":60,"step":1,"unit":"px","default":20},{"type":"range","id":"heading_margin_bottom","label":"Heading margin","min":0,"max":60,"step":1,"unit":"px","default":30}],"blocks":[{"type":"product","name":"Ordered product","settings":[{"type":"product","id":"product","label":"Product"}]}],"max_blocks":19,"presets":[{"name":"Related products"}]}
{% endschema %}
