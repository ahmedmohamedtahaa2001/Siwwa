{{ 'system-pages.css' | asset_url | stylesheet_tag }}
<section class="system-page"><header class="system-page__header"><h1 class="system-page__title">{{ section.settings.heading | escape }}</h1><form class="system-page__form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchPageInput">{{ section.settings.input_label | escape }}</label><input class="system-page__input" id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}"><input type="hidden" name="options[prefix]" value="last"><button class="system-page__button" type="submit">{{ section.settings.submit_label | escape }}</button></form>{% if search.performed %}<p class="system-meta" role="status">{{ search.results_count }} {{ section.settings.results_label | escape }}{% if search.terms != blank %} “{{ search.terms | escape }}”{% endif %}</p>{% endif %}</header>
{% if search.performed %}{% paginate search.results by 24 %}{% if search.results_count > 0 %}<ul class="system-grid" role="list">{% for item in search.results %}<li class="system-card"><a class="system-card__image" href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240, 480, 800', alt: item.featured_image.alt }}{% endif %}</a><h2 class="system-card__title"><a href="{{ item.url }}">{{ item.title | escape }}</a></h2>{% if item.object_type == 'product' %}<p class="system-meta">{{ item.price | money }}</p>{% else %}<p class="system-meta">{{ item.object_type | capitalize }}</p>{% endif %}</li>{% endfor %}</ul>{% else %}<p>{{ section.settings.no_results | escape }}</p>{% endif %}{% render 'pagination', paginate: paginate %}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Search","settings":[{"type":"text","id":"heading","label":"Heading","default":"Search"},{"type":"text","id":"input_label","label":"Input label","default":"Search the store"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Search products and pages"},{"type":"text","id":"submit_label","label":"Button label","default":"Search"},{"type":"text","id":"results_label","label":"Results label","default":"results for"},{"type":"text","id":"no_results","label":"No results message","default":"No results found. Try another search term."}]}{% endschema %}
