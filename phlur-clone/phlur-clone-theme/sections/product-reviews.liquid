{{ 'product-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-reviews.js' | asset_url }}" defer="defer"></script>

<div class="container-wide show-product-in-reviews" data-product-reviews>
  <div class="okeReviews oke-w" data-oke-widget data-oke-container data-oke-reviews-product-id="shopify-{{ section.settings.fallback_product_id }}">
    <div class="js-oke-widgetSize">
      <header class="oke-w-header">
        <div class="oke-w-header-content">
          <div class="oke-w-ratingAverageModule" role="img" aria-label="Rated {{ section.settings.rating }} out of 5 stars Based on {{ section.settings.review_count }} reviews">
            <strong class="oke-w-ratingAverageModule-rating">{{ section.settings.rating }}</strong>
            {% render 'review-stars', rating: 5 %}
            <span class="oke-w-ratingAverageModule-count">{{ section.settings.review_count }} {{ section.settings.reviews_label }}</span>
          </div>
          <div class="oke-w-reviewsSummaryModule">
            <h2 class="oke-reviewsSummary-heading">Reviews Summary
              <button class="oke-summaryTooltip" type="button" aria-describedby="tooltip-774014"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor"/><path d="M10 9v5M10 6.2v.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button><span id="tooltip-774014" role="tooltip">Generated by AI from 100 most recent customer reviews</span>
            </h2>
            <p class="oke-reviewsSummary-updated">{{ section.settings.summary_updated }}</p>
            <p class="oke-reviewsSummary-content is-clamped">{{ section.settings.summary_content }}</p>
            <button role="button" type="button" class="oke-reviewsSummary-readMore oke-readMore" data-summary-toggle aria-expanded="false"><span class="oke-reviewsSummary-readMore-text oke-bodyText">Read More</span></button>
          </div>
          <a class="oke-button oke-writeReview" href="{{ product.url }}#write-a-review" aria-label="{{ section.settings.write_review_label }}">{{ section.settings.write_review_label }}</a>
        </div>
      </header>
      <main id="reviews-panel-458db543-4fb7-43dd-9b81-41d89be4904a" class="oke-w-main">
        <div class="oke-w-reviews-head"><h2>Customer Reviews</h2><span>{{ section.settings.review_count | default: 904 }} reviews</span></div>
        <div class="oke-w-reviews-controls">
          <label for="ReviewSort-{{ section.id }}">Sort</label>
          <select id="ReviewSort-{{ section.id }}" data-review-sort><option value="recent">Most Recent</option><option value="highest">Highest Rating</option><option value="lowest">Lowest Rating</option></select>
        </div>
        <ul class="oke-w-reviews-list" role="list">
          {%- for block in section.blocks -%}
            <li id="review-{{ block.settings.review_id }}" class="oke-w-reviews-list-item{% if forloop.index > 3 %} is-deferred{% endif %}" data-review-item data-rating="{{ block.settings.rating }}" data-index="{{ forloop.index }}"{% if forloop.index > 3 %} hidden{% endif %} {{ block.shopify_attributes }}>
              <article class="oke-w-review">
                <aside class="oke-w-review-side"><strong>{{ block.settings.author | escape }}</strong>{% if block.settings.verified %}<span class="oke-verified"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="8"/><path d="m4.5 8 2.2 2.2L11.8 5" fill="none" stroke="#fff" stroke-width="1.5"/></svg> Verified Buyer</span>{% elsif block.settings.source_badge != blank %}<span class="oke-sourceBadge">{{ block.settings.source_badge | escape }}</span>{% endif %}{% if block.settings.age != blank %}<span>Age: {{ block.settings.age | escape }}</span>{% endif %}{% if block.settings.gender != blank %}<span>Gender: {{ block.settings.gender | escape }}</span>{% endif %}</aside>
                <div class="oke-w-review-main">
                  <div class="oke-reviewContent-top">{% render 'review-stars', rating: block.settings.rating %}<time>{{ block.settings.date | escape }}</time></div>
                  <div class="oke-w-review-product"><img src="{{ block.settings.product_asset | default: 'island-escape-trio-main.jpg' | asset_url }}" alt="{{ block.settings.product | escape }}" width="64" height="64" loading="lazy"><span>{{ block.settings.product | escape }}</span></div>
                  <h3>{{ block.settings.title | escape }}</h3>
                  <div class="oke-reviewContent-body"><p data-review-body>{{ block.settings.body | escape }}</p><button class="oke-link" type="button" data-review-toggle hidden aria-expanded="false">Read More</button></div>
                  <p class="oke-recommended"><svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true"><circle cx="9" cy="9" r="8" fill="none" stroke="currentColor"/><path d="m5 9 2.5 2.5L13 6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg> Yes, I recommend this product.</p>
                  <div class="oke-helpful"><span>Was this helpful?</span><button type="button" data-helpful="yes" aria-pressed="false"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M7 18H3V8h4m0 10h8.3a2 2 0 0 0 1.9-1.4l1.5-5A2 2 0 0 0 16.8 9H13l.6-3.1A2.4 2.4 0 0 0 11.2 3L7 8v10Z" fill="none" stroke="currentColor" stroke-linejoin="round"/></svg> Yes</button><button type="button" data-helpful="no" aria-pressed="false"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M7 2H3v10h4m0-10h8.3a2 2 0 0 1 1.9 1.4l1.5 5a2 2 0 0 1-1.9 2.6H13l.6 3.1a2.4 2.4 0 0 1-2.4 2.9L7 12V2Z" fill="none" stroke="currentColor" stroke-linejoin="round"/></svg> No</button></div>
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>
        {% if section.blocks.size > 3 %}<button class="oke-button oke-showMore" type="button" data-show-more>{{ section.settings.show_more_label }}</button>{% endif %}
      </main>
    </div>
  </div>
</div>
{% schema %}
{"name":"Product reviews","tag":"section","class":"section","settings":[{"type":"text","id":"fallback_product_id","label":"Fallback product ID","default":"10497284735157"},{"type":"text","id":"rating","label":"Average rating","default":"4.6"},{"type":"number","id":"review_count","label":"Review count","default":119},{"type":"text","id":"reviews_label","label":"Reviews label","default":"reviews"},{"type":"text","id":"summary_updated","label":"Summary updated text","default":"Last updated 4 days ago"},{"type":"textarea","id":"summary_content","label":"Review summary","default":"Customers describe Vanilla Canyon as a sophisticated vanilla with woody and smoky depth. Many praise its longevity, projection, and versatility for layering."},{"type":"text","id":"write_review_label","label":"Write review label","default":"Write a Review"},{"type":"text","id":"show_more_label","label":"Show more label","default":"Show More"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"text","id":"review_id","label":"Review ID"},{"type":"text","id":"author","label":"Author"},{"type":"checkbox","id":"verified","label":"Verified buyer","default":true},{"type":"text","id":"source_badge","label":"Source badge"},{"type":"text","id":"product","label":"Product"},{"type":"text","id":"product_asset","label":"Fallback product asset","default":"FatherFigure-50mL_6ab972d7-e860-4603-81e6-8f14cbaae348.jpg"},{"type":"text","id":"age","label":"Age"},{"type":"text","id":"gender","label":"Gender"},{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"text","id":"date","label":"Date"},{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"body","label":"Body"}]}],"max_blocks":5,"presets":[{"name":"Product reviews"}]}
{% endschema %}
