{{ 'system-pages.css' | asset_url | stylesheet_tag }}
<section class="system-page"><header class="system-page__header"><h1 class="system-page__title">{{ section.settings.heading | escape }}</h1></header>{% paginate collections by 24 %}<ul class="system-grid" role="list">{% for collection in collections %}<li class="system-card"><a class="system-card__image" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240, 480, 800', alt: collection.featured_image.alt }}{% endif %}</a><h2 class="system-card__title"><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2><p class="system-meta">{{ collection.products_count }} products</p></li>{% endfor %}</ul>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}{"name":"Collection list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Collections"}]}{% endschema %}
