{{ 'home-rich-text.css' | asset_url | stylesheet_tag }}
<style data-shopify>
  .section-{{ section.id }}-padding {
    padding-top: 0;
    padding-bottom: 0;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 0;
      padding-bottom: 0;
    }
  }
</style>
{%- liquid
  assign statement = section.settings.heading | default: 'Modern fragrances inspired by memories and feelings — those intimately personal and universally shared.'
  assign button_label = section.settings.link_label | default: 'About Us'
  assign button_link = section.settings.link | default: '/pages/our-story'
-%}
<div class="isolate">
    <div class="rich-text content-container color-scheme-1 gradient rich-text--full-width content-container--full-width section-{{ section.id }}-padding" style="--rich-text-background:{{ section.settings.background | default: '#fafafa' }};--rich-text-color:{{ section.settings.text_color | default: '#000000' }};">
      <div class="rich-text__wrapper rich-text__wrapper--left page-width">
        <div class="container-padding-40">
          <div class="rich-text__blocks left">
            <h2 class="repro rich-text__heading rte inline-richtext h2 scroll-trigger animate--slide-in" data-cascade style="--animation-order: 0;">{{ statement | escape }}</h2>
            <div class="rich-text__buttons scroll-trigger animate--slide-in" data-cascade style="--animation-order: 1;"><a href="{{ button_link }}" class="button outline-black">{{ button_label | escape }}</a></div>
          </div>
        </div>
      </div>
    </div>
</div>
{% schema %}
{"name":"Phlur rich text","tag":"section","class":"section","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"Modern fragrances inspired by memories and feelings — those intimately personal and universally shared."},{"type":"text","id":"link_label","label":"Button label","default":"About Us"},{"type":"url","id":"link","label":"Button link"},{"type":"color","id":"background","label":"Background","default":"#fafafa"},{"type":"color","id":"text_color","label":"Text color","default":"#000000"}],"presets":[{"name":"Phlur rich text"}]}
{% endschema %}
