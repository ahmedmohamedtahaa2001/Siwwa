{% style %}
  #shopify-section-{{ section.id }} .pdp-brand-video { box-sizing:border-box; width:100%; max-width:{{ section.settings.section_max_width }}px; margin-inline:auto; padding:{{ section.settings.desktop_padding_top }}px {{ section.settings.desktop_padding_horizontal }}px {{ section.settings.desktop_padding_bottom }}px; }
  #shopify-section-{{ section.id }} .pdp-brand-video__media { display:block; width:100%; aspect-ratio:{{ section.settings.video_aspect_ratio }}; object-fit:{{ section.settings.video_fit }}; object-position:{{ section.settings.video_position }}; }
  @media(max-width:749px){#shopify-section-{{ section.id }} .pdp-brand-video{padding:{{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_horizontal }}px {{ section.settings.mobile_padding_bottom }}px}#shopify-section-{{ section.id }} .pdp-brand-video__media{aspect-ratio:{{ section.settings.mobile_video_aspect_ratio }};object-position:{{ section.settings.mobile_video_position }}}}
{% endstyle %}
<div class="pdp-brand-video">
  {%- liquid
    assign desktop_video_source = section.settings.desktop_video_asset | asset_url
    assign mobile_video_source = section.settings.mobile_video_asset | asset_url
    if section.settings.video_source_mode == 'external'
      assign desktop_video_source = section.settings.desktop_video_url
      assign mobile_video_source = section.settings.mobile_video_url
    endif
  -%}
  <video class="pdp-brand-video__media" autoplay loop muted playsinline disablepictureinpicture preload="none" aria-label="{{ section.settings.video_aria_label | escape }}" data-performance-video>
    <source data-src="{{ mobile_video_source | escape }}" media="(max-width: 749px)" type="video/mp4">
    <source data-src="{{ desktop_video_source | escape }}" media="(min-width: 750px)" type="video/mp4">
  </video>
</div>
{% schema %}
{"name":"PDP brand video","tag":"section","class":"pdp-full-width-brand-vid","settings":[{"type":"select","id":"video_source_mode","label":"Video source","default":"theme_asset","options":[{"value":"theme_asset","label":"Theme asset"},{"value":"external","label":"External URL"}]},{"type":"text","id":"desktop_video_asset","label":"Desktop theme asset filename","default":"f6185d3473374cf7828232ad564d8a15.HD-720p-4.5Mbps-91277877.mp4"},{"type":"text","id":"mobile_video_asset","label":"Mobile theme asset filename","default":"ec5852b07b5843aab17cd448ae3871d3.HD-1080p-7.2Mbps-91277878.mp4"},{"type":"text","id":"desktop_video_url","label":"Desktop external MP4 URL","default":"https://cdn.shopify.com/videos/c/o/v/placeholder.mp4"},{"type":"text","id":"mobile_video_url","label":"Mobile external MP4 URL","default":"https://cdn.shopify.com/videos/c/o/v/placeholder.mp4"},{"type":"text","id":"video_aria_label","label":"Video accessibility label","default":"Vanilla Canyon fragrance film"},{"type":"select","id":"video_fit","label":"Video fit","default":"cover","options":[{"value":"cover","label":"Cover"},{"value":"contain","label":"Contain"}]},{"type":"select","id":"video_position","label":"Desktop video position","default":"center center","options":[{"value":"center center","label":"Center"},{"value":"top center","label":"Top"},{"value":"bottom center","label":"Bottom"}]},{"type":"select","id":"mobile_video_position","label":"Mobile video position","default":"center center","options":[{"value":"center center","label":"Center"},{"value":"top center","label":"Top"},{"value":"bottom center","label":"Bottom"}]},{"type":"text","id":"video_aspect_ratio","label":"Desktop aspect ratio","default":"1280 / 561"},{"type":"text","id":"mobile_video_aspect_ratio","label":"Mobile aspect ratio","default":"335 / 596"},{"type":"range","id":"section_max_width","label":"Maximum width","min":800,"max":2000,"step":20,"unit":"px","default":2000},{"type":"range","id":"desktop_padding_top","label":"Desktop padding top","min":0,"max":120,"step":2,"unit":"px","default":40},{"type":"range","id":"desktop_padding_horizontal","label":"Desktop horizontal padding","min":0,"max":160,"step":2,"unit":"px","default":80},{"type":"range","id":"desktop_padding_bottom","label":"Desktop padding bottom","min":0,"max":120,"step":2,"unit":"px","default":40},{"type":"range","id":"mobile_padding_top","label":"Mobile padding top","min":0,"max":80,"step":1,"unit":"px","default":20},{"type":"range","id":"mobile_padding_horizontal","label":"Mobile horizontal padding","min":0,"max":60,"step":1,"unit":"px","default":20},{"type":"range","id":"mobile_padding_bottom","label":"Mobile padding bottom","min":0,"max":80,"step":1,"unit":"px","default":20}],"presets":[{"name":"PDP brand video"}]}
{% endschema %}
