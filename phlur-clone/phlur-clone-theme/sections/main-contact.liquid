{{ 'system-pages.css' | asset_url | stylesheet_tag }}
<section class="system-page"><header class="system-page__header"><h1 class="system-page__title">{{ page.title | default: section.settings.heading | escape }}</h1>{% if page.content != blank %}<div class="system-page__content rte">{{ page.content }}</div>{% endif %}</header>{% form 'contact', class: 'system-form-stack' %}{% if form.posted_successfully? %}<p class="system-success" role="status">{{ section.settings.success_message | escape }}</p>{% endif %}{{ form.errors | default_errors }}<label>{{ section.settings.name_label | escape }}<input type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name"></label><label>{{ section.settings.email_label | escape }}<input type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required></label><label>{{ section.settings.phone_label | escape }}<input type="tel" name="contact[phone]" value="{{ form.phone | escape }}" autocomplete="tel"></label><label>{{ section.settings.message_label | escape }}<textarea name="contact[body]" rows="8" required>{{ form.body }}</textarea></label><button class="system-page__button" type="submit">{{ section.settings.submit_label | escape }}</button>{% endform %}</section>
{% schema %}{"name":"Contact","settings":[{"type":"text","id":"heading","label":"Fallback heading","default":"Contact us"},{"type":"text","id":"name_label","label":"Name label","default":"Name"},{"type":"text","id":"email_label","label":"Email label","default":"Email"},{"type":"text","id":"phone_label","label":"Phone label","default":"Phone"},{"type":"text","id":"message_label","label":"Message label","default":"Message"},{"type":"text","id":"submit_label","label":"Submit label","default":"Send"},{"type":"text","id":"success_message","label":"Success message","default":"Thanks for contacting us. We’ll get back to you shortly."}]}{% endschema %}
