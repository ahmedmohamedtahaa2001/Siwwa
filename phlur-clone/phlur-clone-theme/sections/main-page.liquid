{{ 'system-pages.css' | asset_url | stylesheet_tag }}
<section class="system-page"><header class="system-page__header"><h1 class="system-page__title">{{ page.title | escape }}</h1></header><div class="system-page__content rte">{{ page.content }}</div>{% if page.handle == 'contact' %}{% form 'contact', class: 'system-form-stack' %}{% if form.posted_successfully? %}<p class="system-success" role="status">Thanks for contacting us. We’ll get back to you shortly.</p>{% endif %}{{ form.errors | default_errors }}<label>Name<input type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name"></label><label>Email<input type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required></label><label>Phone<input type="tel" name="contact[phone]" value="{{ form.phone | escape }}" autocomplete="tel"></label><label>Message<textarea name="contact[body]" rows="8" required>{{ form.body }}</textarea></label><button class="system-page__button" type="submit">Send</button>{% endform %}{% endif %}</section>
{% schema %}{"name":"Page","settings":[]}{% endschema %}
