{{ 'home-image-text.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-image-text.js' | asset_url }}" defer="defer"></script>

<div class="phlur-discovery section-{{ section.id }}-padding gradient color-scheme-1" data-home-image-text>
  <div class="page-width">
    <div class="container-padding-40">
      <div class="image-with-text image-with-text--no-overlap isolate collapse-corners scroll-trigger scroll-trigger--offscreen animate--slide-in">
        <div class="image-with-text__grid grid grid--gapless grid--1-col grid--3-col-tablet image-with-text__grid--reverse">
          <div class="image-with-text__media-item image-with-text__media-item--large image-with-text__media-item--middle grid__item">
            <div class="image-with-text__media image-with-text__media--medium global-media-settings background-transparent media">
              {%- if section.settings.image != blank -%}
                {{
                  section.settings.image
                  | image_url: width: 1500
                  | image_tag:
                    widths: '165, 360, 535, 750, 1070, 1500',
                    sizes: '(min-width: 1600px) 750px, (min-width: 750px) calc((100vw - 130px) / 2), calc(100vw - 40px)',
                    loading: 'lazy',
                    fetchpriority: 'auto',
                    alt: section.settings.image_alt
                }}
              {%- else -%}
                <img src="{{ 'home-discovery-set.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1500" height="844" loading="lazy" fetchpriority="auto">
              {%- endif -%}
            </div>
          </div>
          <div class="image-with-text__text-item grid__item">
            <div id="ImageWithText--{{ section.id }}" class="image-with-text__content image-with-text__content--middle image-with-text__content--desktop-left image-with-text__content--mobile-left image-with-text__content--medium content-container background-transparent">
              <h2 class="image-with-text__heading aktiv inline-richtext h2">{{ section.settings.heading | default: "There's More to Discover" }}</h2>
              <div class="image-with-text__text rte body">{{ section.settings.body | default: '<p>The Discovery Set is an eight-piece sample collection – with $20 credit towards your next full size fragrance.</p>' }}</div>
              <a href="{{ section.settings.link | default: '/products/fragrance-discovery-set' }}" class="button outline-black button--secondary">{{ section.settings.button_label | default: 'SHOP NOW' }}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home image with text",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt", "default": "Phlur fragrance discovery set" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "There's More to Discover" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>The Discovery Set is an eight-piece sample collection – with $20 credit towards your next full size fragrance.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP NOW" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Home image with text" }]
}
{% endschema %}
