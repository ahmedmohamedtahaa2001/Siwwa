{{ 'system-pages.css' | asset_url | stylesheet_tag }}
<article class="system-page"><header class="system-page__header"><p class="system-meta"><a href="{{ blog.url }}">{{ blog.title | escape }}</a> · {{ article.published_at | date: format: 'date' }}</p><h1 class="system-page__title">{{ article.title | escape }}</h1></header>{% if article.image %}{{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '480, 900, 1400, 1800', alt: article.image.alt }}{% endif %}<div class="system-page__content rte">{{ article.content }}</div></article>
{% schema %}{"name":"Article","settings":[]}{% endschema %}
