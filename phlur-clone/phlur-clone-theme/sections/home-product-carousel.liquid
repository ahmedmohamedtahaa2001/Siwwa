{{ 'featured-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-collection.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign featured_collection = section.settings.collection
  assign view_all_url = section.settings.view_all_link | default: featured_collection.url | default: routes.all_products_collection_url
-%}
<section id="shopify-section-{{ section.id }}" class="shopify-section section featured-collection featured-collection--{{ section.settings.fallback_catalog | default: 'bestsellers' }}" style="--featured-background:{{ section.settings.background }};--featured-color:{{ section.settings.text_color }}" data-featured-collection>
  <div class="page-width"><div class="container-top-padding-40"><div class="collection__title title-wrapper title-wrapper--no-top-margin page-width">
    <div class="collection-header-left"><h2 class="aktiv inline-richtext h2 scroll-trigger animate--slide-in"><a href="{{ view_all_url }}">{{ section.settings.heading | default: "Wear What's True" | escape }}</a></h2></div>
    {%- if section.settings.show_view_all -%}<div class="collection-header-right"><a class="scroll-trigger animate--slide-in" href="{{ view_all_url }}">{{ section.settings.view_all_label | default: 'Shop Perfume' | escape }}</a></div>{%- endif -%}
  </div></div></div>
  <div class="color-scheme-1 isolate" id="gift"><div id="collection-{{ section.id }}" class="collection featured-collection section-{{ section.id }}-padding" data-id="{{ section.id }}"><div class="swiper collectionSwiper swiper-initialized swiper-horizontal" data-featured-viewport>
    <ul class="rebuy-widget-container swiper-wrapper featured-collection__track" id="Slider-{{ section.id }}" data-id="{{ section.id }}" role="list" aria-label="Slider" data-featured-track>
      {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}{% render 'featured-product-card', product: product, index: forloop.index, section_id: section.id, add_label: section.settings.add_label, fallback_catalog: section.settings.fallback_catalog %}{%- endfor -%}
      {%- endif -%}
    </ul>
    <div class="swiper-button-prev swiper-button featured-collection__arrow swiper-button-disabled" data-featured-prev aria-label="Previous products" aria-disabled="true" tabindex="-1"><span class="nav-arrow" aria-hidden="true"><span class="nav-arrow-bg-circle"></span>{% render 'icon-chevron', direction: 'left' %}</span></div>
    <div class="swiper-button-next swiper-button featured-collection__arrow" data-featured-next aria-label="Next products" aria-disabled="false" tabindex="0"><span class="nav-arrow" aria-hidden="true"><span class="nav-arrow-bg-circle"></span>{% render 'icon-chevron', direction: 'right' %}</span></div>
  </div></div></div>
</section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"Wear What's True"},{"type":"collection","id":"collection","label":"Collection"},{"type":"select","id":"fallback_catalog","label":"Fallback catalog","default":"bestsellers","options":[{"value":"bestsellers","label":"Bestsellers"},{"value":"perfumes","label":"Perfumes"}]},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":12,"step":1,"default":12},{"type":"checkbox","id":"show_view_all","label":"Show view all","default":true},{"type":"text","id":"view_all_label","label":"View all label","default":"Shop Perfume"},{"type":"url","id":"view_all_link","label":"View all link"},{"type":"text","id":"add_label","label":"Add label","default":"Add"},{"type":"color","id":"background","label":"Background","default":"#fafafa"},{"type":"color","id":"text_color","label":"Text color","default":"#000000"}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
