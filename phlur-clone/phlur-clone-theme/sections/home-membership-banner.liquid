{{ 'home-membership-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign membership_heading = section.settings.heading | default: 'MEMBERS GET MORE'
  assign membership_body = section.settings.body | default: 'Over $200 worth of gifts and savings'
  assign membership_button = section.settings.button_label | default: 'JOIN NOW'
  assign membership_link = section.settings.link | default: '/products/membership'
-%}

  <a class="homepage-hero-link-wrapper homepage-hero-link-{{ section.id }} page-width link-forloop-5" href="{{ membership_link }}">
    <div class="homepage-hero-link-wrapper-{{ section.id }} container-bottom-padding-40 forloop-5">
      <div data-section-id="{{ section.id }}" class="homepage-hero-wrap homepage-hero-text--{{ section.id }} homepage-hero-text--800 origHeight">
        <div class="homepage-hero-text__container">
          <div class="hero__media hero__media--{{ section.id }} origHeight">
            <div class="hero__media-container">
              {% if section.settings.image_desktop != blank %}
                {{ section.settings.image_desktop | image_url: width: 3840 | image_tag: class: 'desktop bg-image image-fit', widths: '960, 1440, 1920, 2880, 3840', sizes: '100vw', loading: 'lazy', alt: section.settings.image_alt }}
              {% else %}
                <img loading="lazy" class="desktop bg-image image-fit" src="{{ 'home-membership-desktop.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="3840" height="1680">
              {% endif %}
              {% if section.settings.image_mobile != blank %}
                {{ section.settings.image_mobile | image_url: width: 2160 | image_tag: class: 'mobile bg-image image-fit', widths: '375, 750, 1125, 1500, 2160', sizes: '100vw', loading: 'lazy', alt: section.settings.image_alt }}
              {% else %}
                <img loading="lazy" class="mobile bg-image image-fit" src="{{ 'home-membership-mobile.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="2160" height="2700">
              {% endif %}
            </div>
          </div>
        </div>

        <div class="homepage-hero-text__inner">
          <div class="homepage-hero-text__aligner homepage-hero-text--left homepage-hero-text-mobile--left_bottom">
            <h2 class="large desktop">{{ membership_heading | escape }}</h2>
            <h2 class="large mobile">{{ membership_heading | escape }}</h2>
            <p class="desktop">{{ membership_body | escape }}</p>
            <p class="mobile">{{ membership_body | escape }}</p>
            <button class="desktop outline-white">{{ membership_button | escape }}</button>
          </div>
        </div>
      </div>
    </div>
  </a>

{% schema %}
{
  "name": "Membership banner",
  "tag": "section",
  "class": "section-full-width-banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "MEMBERS GET MORE" },
    { "type": "text", "id": "body", "label": "Body", "default": "Over $200 worth of gifts and savings" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "JOIN NOW" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Phlur membership benefits" }
  ],
  "presets": [
    { "name": "Membership banner" }
  ]
}
{% endschema %}
