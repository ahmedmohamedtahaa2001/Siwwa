{% style %}
#shopify-section-{{ section.id }}{--rebuy-bg:{{ section.settings.background_color }};--rebuy-text:{{ section.settings.text_color }};--rebuy-button-bg:{{ section.settings.button_background }};--rebuy-button-text:{{ section.settings.button_text }};--rebuy-working-bg:{{ section.settings.button_working_background }};--rebuy-working-text:{{ section.settings.button_working_text }};--rebuy-compare:{{ section.settings.compare_price_color }};--rebuy-gap:{{ section.settings.item_gap }}px;--rebuy-duration:{{ section.settings.slide_duration }}ms;--rebuy-hover-duration:{{ section.settings.hover_duration }}ms;--rebuy-nav-size:{{ section.settings.nav_size }}px;--rebuy-nav-circle:{{ section.settings.nav_circle_size }}px;--rebuy-nav-prev:{{ section.settings.nav_previous_offset }}px;--rebuy-nav-next:{{ section.settings.nav_next_offset }}px;--rebuy-max-width:{{ section.settings.section_max_width }}px;--rebuy-heading-top:{{ section.settings.heading_padding_top }}px;--rebuy-heading-bottom:{{ section.settings.heading_margin_bottom }}px;margin:{{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px;padding-top:{{ section.settings.padding_top }}px;padding-right:{{ section.settings.padding_right }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background:var(--rebuy-bg);color:var(--rebuy-text)}
@media(max-width:749px){#shopify-section-{{ section.id }}{padding-top:{{ section.settings.mobile_padding_top }}px;padding-bottom:40px}}
{% endstyle %}
{%- assign widget_id = section.settings.widget_id | default: '145779' -%}
<div class="page-width"><div class="container-top-padding-40"><div class="collection__title title-wrapper title-wrapper--no-top-margin page-width title-wrapper--self-padded-tablet-down collection__title--desktop-slider"><h2 class="aktiv title inline-richtext h2 scroll-trigger animate--slide-in">{% if section.settings.heading_link != blank %}<a href="{{ section.settings.heading_link }}">{{ section.settings.heading }}</a>{% else %}{{ section.settings.heading }}{% endif %}</h2></div></div><h3 class="scroll-trigger animate--slide-in scroll-trigger--offscreen"></h3></div>
<div data-rebuy-id="{{ widget_id }}" data-rebuy-shopify-product-ids="{{ section.settings.source_product_id | default: '10429585653941' }}" data-initialized="true"><div id="rebuy-widget-{{ widget_id }}" class="rebuy-widget scroll-trigger animate--slide-in widget-type-product widget-display-embed is-visible widget-layout-line"><div class="rebuy-widget-wrapper widget-display-embed is-visible"><div class="swiper recSwiper swiper-initialized swiper-horizontal swiper-backface-hidden" data-rebuy-slider><ul id="Slider-Gallery-{{ widget_id }}" class="rebuy-widget-container swiper-wrapper widget-display-embed is-visible" role="list" aria-live="polite">
{% if section.settings.source_mode == 'collection' and section.settings.collection != blank %}{% for item in section.settings.collection.products limit: section.settings.product_limit %}{% render 'molecule-rebuy-product-card', product: item, block: blank, section: section, index: forloop.index, count: section.settings.product_limit, widget_id: widget_id %}{% endfor %}{% else %}{% for block in section.blocks limit: section.settings.product_limit %}{% render 'molecule-rebuy-product-card', product: block.settings.product, block: block, section: section, index: forloop.index, count: section.blocks.size, widget_id: widget_id %}{% endfor %}{% endif %}
</ul><div class="swiper-button-prev swiper-button swiper-button-disabled" tabindex="-1" role="button" aria-label="{{ section.settings.previous_label }}" aria-controls="Slider-Gallery-{{ widget_id }}" aria-disabled="true"><div class="nav-arrow"><div class="nav-arrow-bg-circle"></div><img src="{{ section.settings.previous_icon_asset }}" alt="chevron icon" aria-hidden="true" width="24" height="24" class="product-gallery-nav-icon"></div></div><div class="swiper-button-next swiper-button" tabindex="0" role="button" aria-label="{{ section.settings.next_label }}" aria-controls="Slider-Gallery-{{ widget_id }}" aria-disabled="false"><div class="nav-arrow"><div class="nav-arrow-bg-circle"></div><img src="{{ section.settings.next_icon_asset }}" alt="chevron icon" aria-hidden="true" width="24" height="24" class="product-gallery-nav-icon"></div></div><span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span></div></div></div></div>
