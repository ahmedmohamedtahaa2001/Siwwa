{{ 'product-info-revision.css' | asset_url | stylesheet_tag }}
{{ 'product-info-ground-truth.css' | asset_url | stylesheet_tag }}
{{ 'product-info-ground-tuning.css' | asset_url | stylesheet_tag }}
{{ 'layer-it-with.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-spinner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-main.js' | asset_url }}" defer></script>
{%- assign display_title = product.metafields.custom.display_title | default: section.settings.fallback_title -%}
{% style %}
  body, #MainContent { width: 100%; max-width: 100%; }
  #shopify-section-{{ section.id }} > section > .page-width {
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    max-width: {{ section.settings.section_max_width }}px;
  }
  #shopify-section-{{ section.id }} .product {
    gap: {{ section.settings.item_gap }}px;
    max-width: {{ section.settings.product_content_width }}px;
    --gallery-sticky-top: {{ section.settings.gallery_sticky_top }}px;
    --membership-chevron-size: {{ section.settings.membership_chevron_size }}px;
  }
  #shopify-section-{{ section.id }} .scentCollectionSwiper {
    --scent-card-width: {{ section.settings.scent_card_width }}px;
    --scent-card-gap: {{ section.settings.scent_gap }}px;
  }
  #shopify-section-{{ section.id }} .productSwiper {
    --gallery-badge-background: {{ section.settings.gallery_badge_background }};
    --gallery-badge-color: {{ section.settings.gallery_badge_color }};
    --gallery-bullet-color: {{ section.settings.gallery_bullet_color }};
    --gallery-bullet-inactive-color: {{ section.settings.gallery_bullet_inactive_color }};
    --gallery-arrow-background: {{ section.settings.gallery_arrow_background }};
    --gallery-arrow-size: {{ section.settings.gallery_arrow_size }}px;
    --gallery-icon-size: {{ section.settings.gallery_icon_size }}px;
    --gallery-ratio: {{ section.settings.gallery_ratio_percent | divided_by: 100.0 }};
    --gallery-previous-offset: {{ section.settings.gallery_previous_offset }}px;
    --gallery-next-offset: {{ section.settings.gallery_next_offset }}px;
    --gallery-arrow-blur: {{ section.settings.gallery_arrow_blur }}px;
    --gallery-disabled-opacity: {{ section.settings.gallery_disabled_opacity | divided_by: 100.0 }};
    --gallery-badge-top: {{ section.settings.gallery_badge_top }}px;
    --gallery-badge-left: {{ section.settings.gallery_badge_left }}px;
    --gallery-badge-padding-vertical: {{ section.settings.gallery_badge_padding_vertical }}px;
    --gallery-badge-padding-horizontal: {{ section.settings.gallery_badge_padding_horizontal }}px;
    --gallery-badge-font-size: {{ section.settings.gallery_badge_font_size }}px;
    --gallery-badge-line-height: {{ section.settings.gallery_badge_line_height }}px;
    --gallery-pagination-bottom: {{ section.settings.gallery_pagination_bottom }}px;
    --gallery-pagination-gap: {{ section.settings.gallery_pagination_gap }}px;
    --gallery-bullet-size: {{ section.settings.gallery_bullet_size }}px;
    --gallery-bullet-border-width: {{ section.settings.gallery_bullet_border_width }}px;
    --gallery-transition-duration: {{ section.settings.gallery_transition_duration }}ms;
    --gallery-mobile-gap: {{ section.settings.gallery_mobile_gap }}px;
    --gallery-mobile-gutter: {{ section.settings.gallery_mobile_gutter }}px;
    --gallery-mobile-slide-inset: {{ section.settings.gallery_mobile_slide_inset }}px;
    --gallery-desktop-height: {{ section.settings.gallery_desktop_height }}px;
    --gallery-laptop-height: {{ section.settings.gallery_laptop_height }}px;
    --gallery-tablet-height: {{ section.settings.gallery_tablet_height }}px;
    --gallery-mobile-height: {{ section.settings.gallery_mobile_height }}px;
    --gallery-width-adjustment: {{ section.settings.gallery_width_adjustment }}px;
    --gallery-badge-letter-spacing: {{ section.settings.gallery_badge_letter_spacing }}px;
    --gallery-mobile-pagination-bottom: {{ section.settings.gallery_mobile_pagination_bottom }}px;
    --gallery-control-transition: {{ section.settings.gallery_control_transition }};
    --gallery-image-fit: {{ section.settings.gallery_image_fit }};
    --gallery-badge-font-family: {{ section.settings.gallery_badge_font_family }};
    --gallery-badge-font-weight: {{ section.settings.gallery_badge_font_weight }};
    --gallery-badge-transform: {{ section.settings.gallery_badge_transform }};
    --gallery-badge-item-gap: {{ section.settings.gallery_badge_item_gap }}px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} > section > .page-width {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_horizontal }}px {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}
<section id="MainProduct-{{ section.id }}" class="section-{{ section.id }}-padding gradient color-scheme-1 product-kind--{{ section.settings.product_kind | handleize }}" data-section="{{ section.id }}">
  <svg class="oke-star-definitions" aria-hidden="true" width="0" height="0" style="position:absolute;color:#000"><defs><path id="oke-star-empty" fill="currentColor" d="M16 1.9l4.3 8.8 9.7 1.4-7 6.8 1.7 9.6-8.7-4.6-8.7 4.6L9 18.9l-7-6.8 9.7-1.4L16 1.9z"></path><path id="oke-star-filled" fill="currentColor" d="M16 1.9l4.3 8.8 9.7 1.4-7 6.8 1.7 9.6-8.7-4.6-8.7 4.6L9 18.9l-7-6.8 9.7-1.4L16 1.9z"></path></defs></svg>
  <div class="page-width"><div class="container-bottom-padding-60">
    <div class="product product--medium product--left product--thumbnail_slider product--mobile-hide grid grid--1-col grid--2-col-tablet">
      <div class="grid__item product__media-wrapper">{% render 'product-media-gallery' %}</div>
      <div class="product__info-wrapper grid__item scroll-trigger animate--slide-in">
        <product-info id="ProductInfo-{{ section.id }}" class="product__info-container product__column-sticky" data-section="{{ section.id }}" data-url="{{ product.url | default: section.settings.fallback_product_url }}">
          <div class="product__title">
            <div class="flex-container-row"><h1 class="aktiv h3">{{ display_title | escape }}</h1><div data-oke-star-rating data-oke-reviews-product-id="shopify-{{ product.id | default: section.settings.fallback_product_id }}" data-oke-rendered><div data-oke-reviews-version="0.103.2" data-oke-container class="okeReviews oke-sr"><div class="oke-is-clickable" tabindex="0" role="button"><div class="oke-sr-rating"> {{ section.settings.rating_value }} </div><div class="oke-sr-stars"><div class="oke-stars"><div class="oke-stars-background"><svg height="13" viewBox="0 0 199.3846153846154 32" aria-hidden="true" role="none"><use x="0" href="#oke-star-empty"></use><use x="41.84615384615385" href="#oke-star-empty"></use><use x="83.6923076923077" href="#oke-star-empty"></use><use x="125.53846153846155" href="#oke-star-empty"></use><use x="167.3846153846154" href="#oke-star-empty"></use></svg></div><div class="oke-stars-foreground" style="width:{{ section.settings.rating_percent_exact }}%;"><svg height="13" viewBox="0 0 199.3846153846154 32" aria-hidden="true" role="none"><use x="0" href="#oke-star-filled"></use><use x="41.84615384615385" href="#oke-star-filled"></use><use x="83.6923076923077" href="#oke-star-filled"></use><use x="125.53846153846155" href="#oke-star-filled"></use><use x="167.3846153846154" href="#oke-star-filled"></use></svg></div><span class="oke-a11yText">{{ section.settings.rating_aria | escape }}</span></div></div><div class="oke-sr-count"><span class="oke-sr-count-number">{{ section.settings.rating_value }}</span><span class="oke-sr-label-text"> {{ section.settings.rating_label | escape }}</span><span class="oke-sr-total-text"> ({{ section.settings.review_count }})</span></div><span class="oke-a11yText">{{ section.settings.rating_click_label | escape }}</span></div><script type="application/json" data-oke-metafield-data>{"averageRating":"{{ section.settings.rating_value }}","reviewCount":{{ section.settings.review_count }}}</script></div></div></div>
            <h3 class="repro variant-title">{{ product.metafields.custom.variant_title | default: section.settings.variant_title | escape }}</h3>
            <h3 class="repro tagline" style="border-left:{{ section.settings.tagline_border_width }}px solid {{ section.settings.tagline_border_color }};">{{ product.metafields.custom.tagline | default: section.settings.tagline | escape }}</h3>
          </div>
          <p class="product__text inline-richtext subtitle">{{ section.settings.subtitle }}</p>
          {% render 'product-form' %}
          <div class="Phlur-Accordion">
            {%- assign accordion_index = 0 -%}
            {%- for block in section.blocks -%}{%- if block.type == 'accordion' -%}
              <div class="js_accordion{% if accordion_index == 0 %} first-accordion open{% endif %}" {{ block.shopify_attributes }}>
                <button class="accordion-header-wrap" type="button" aria-expanded="{% if accordion_index == 0 %}true{% else %}false{% endif %}" aria-controls="AccordionPanel-{{ section.id }}-{{ block.id }}"><span class="summary__title"><span>{{ block.settings.title | escape }}</span></span><span class="icon-plus-rotate" aria-hidden="true"></span></button>
                <div id="AccordionPanel-{{ section.id }}-{{ block.id }}" class="accordion_content rte">{% if block.settings.use_ingredients_metafield and product.metafields.custom.ingredients != blank %}{{ product.metafields.custom.ingredients | metafield_tag }}{% else %}{{ block.settings.content }}{% endif %}</div>
              </div>
              {%- assign accordion_index = accordion_index | plus: 1 -%}
            {%- endif -%}{%- endfor -%}
          {%- if section.settings.show_layer_it_with -%}
            {%- assign layer_sizes = '(min-width: 1600px) 367px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)' -%}
            <p class="layer-it-with-heading">{{ section.settings.layer_heading | escape }}</p>
            <div class="layer-it-with-pdp">
              {%- for block in section.blocks -%}{%- if block.type == 'product' -%}{% render 'layer-product-card', block: block, section: section, layer_sizes: layer_sizes %}{%- endif -%}{%- endfor -%}
            </div>
          {%- endif -%}
          </div>
        </product-info>
      </div>
    </div>
  </div></div>
</section>
{% schema %}
