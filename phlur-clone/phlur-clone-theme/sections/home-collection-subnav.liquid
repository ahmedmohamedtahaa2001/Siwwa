{{ 'collection-subnav.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show -%}<div class="collection-subnav scroll-trigger animate--slide-in"><ul class="shop-submenu desktop" role="list">{%- for block in section.blocks -%}<li><a href="{{ block.settings.link }}"{% if block.settings.current %} aria-current="page"{% endif %}>{{ block.settings.label | escape }}</a></li>{%- endfor -%}</ul></div><ul class="scroll-menu" role="list" aria-label="{{ section.settings.aria_label | default: 'Shop collections' | escape }}">{%- for block in section.blocks -%}<li><a href="{{ block.settings.link }}"{% if block.settings.current %} aria-current="page"{% endif %}>{{ block.settings.label | escape }}</a></li>{%- endfor -%}</ul>{%- endif -%}
{% schema %}{"name":"Collection subnav","tag":"section","class":"collection-subnav-wrap","settings":[{"type":"checkbox","id":"show","label":"Show sub-navigation","default":true},{"type":"text","id":"aria_label","label":"Accessibility label","default":"Shop collections"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","id":"label","label":"Label","default":"Shop All"},{"type":"url","id":"link","label":"Link"},{"type":"checkbox","id":"current","label":"Current link","default":false}]}],"presets":[{"name":"Collection subnav"}]}{% endschema %}
