    { "type": "number", "id": "focus_width", "label": "Focus outline width", "default": 2 },
    { "type": "number", "id": "focus_offset", "label": "Focus outline offset", "default": 2 }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
      { "type": "link_list", "id": "menu", "label": "Menu" }
    ] },
    { "type": "newsletter", "name": "Subscribe", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Subscribe" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Sign up for 10% off your first order</p>" },
