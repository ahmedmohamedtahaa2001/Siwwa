    { "type": "header", "content": "Localization" },
    { "type": "number", "id": "localization_height", "label": "Control height", "default": 42 },
    { "type": "number", "id": "localization_size", "label": "Control font size", "default": 14 },
    { "type": "number", "id": "localization_weight", "label": "Control font weight", "default": 500 },
    { "type": "number", "id": "localization_line_height", "label": "Control line height", "default": 21 },
    { "type": "number", "id": "globe_size", "label": "Globe size", "default": 14 },
    { "type": "number", "id": "globe_gap", "label": "Globe gap", "default": 7 },
