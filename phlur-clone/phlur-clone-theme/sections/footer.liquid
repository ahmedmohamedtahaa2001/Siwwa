    { "type": "number", "id": "country_padding", "label": "Country row padding", "default": 8 },
    { "type": "header", "content": "Copyright and focus" },
    { "type": "number", "id": "copyright_size", "label": "Copyright size desktop", "default": 12 },
    { "type": "number", "id": "copyright_size_mobile", "label": "Copyright size mobile", "default": 13 },
    { "type": "number", "id": "copyright_line_height", "label": "Copyright line height desktop", "default": 40 },
    { "type": "number", "id": "copyright_line_height_mobile", "label": "Copyright line height mobile", "default": 13 },
