{{ 'system-pages.css' | asset_url | stylesheet_tag }}<section class="system-page"><p><a href="{{ routes.account_url }}">Back to account</a></p><h1 class="system-page__title">Addresses</h1><h2>Add a new address</h2>{% form 'customer_address', customer.new_address, class: 'system-form-stack' %}{{ form.errors | default_errors }}<label>First name<input type="text" name="address[first_name]" autocomplete="given-name"></label><label>Last name<input type="text" name="address[last_name]" autocomplete="family-name"></label><label>Company<input type="text" name="address[company]" autocomplete="organization"></label><label>Address<input type="text" name="address[address1]" autocomplete="address-line1" required></label><label>Apartment, suite, etc.<input type="text" name="address[address2]" autocomplete="address-line2"></label><label>City<input type="text" name="address[city]" autocomplete="address-level2" required></label><label>Country<select name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select></label><label>Province<input type="text" name="address[province]" autocomplete="address-level1"></label><label>Postal code<input type="text" name="address[zip]" autocomplete="postal-code"></label><label>Phone<input type="tel" name="address[phone]" autocomplete="tel"></label><label><input type="checkbox" name="address[default]" value="1"> Set as default address</label><button class="system-page__button" type="submit">Add address</button>{% endform %}<h2>Saved addresses</h2>{% paginate customer.addresses by 10 %}{% for address in customer.addresses %}<article class="system-address">{% if address == customer.default_address %}<strong>Default</strong>{% endif %}{{ address | format_address }}<form method="post" action="{{ address.url }}"><input type="hidden" name="_method" value="delete"><button class="system-page__button system-page__button--secondary" type="submit">Delete</button></form></article>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
