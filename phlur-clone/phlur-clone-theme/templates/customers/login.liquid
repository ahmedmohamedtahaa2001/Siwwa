{{ 'system-pages.css' | asset_url | stylesheet_tag }}<section class="system-page"><h1 class="system-page__title">Sign in</h1>{% form 'customer_login', class: 'system-form-stack' %}{{ form.errors | default_errors }}<label>Email<input type="email" name="customer[email]" autocomplete="email" required></label>{% if form.password_needed %}<label>Password<input type="password" name="customer[password]" autocomplete="current-password" required></label>{% endif %}<button class="system-page__button" type="submit">Sign in</button><a href="{{ routes.account_register_url }}">Create account</a><a href="#recover">Forgot password?</a>{% endform %}<div id="recover"><h2>Reset password</h2>{% form 'recover_customer_password', class: 'system-form-stack' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p class="system-success" role="status">We sent you an email with a password reset link.</p>{% endif %}<label>Email<input type="email" name="email" autocomplete="email" required></label><button class="system-page__button system-page__button--secondary" type="submit">Submit</button>{% endform %}</div></section>
