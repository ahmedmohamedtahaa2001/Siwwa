{{ 'system-pages.css' | asset_url | stylesheet_tag }}<section class="system-page"><p><a href="{{ routes.account_url }}">Back to account</a></p><h1 class="system-page__title">{{ order.name }}</h1><p class="system-meta">Placed {{ order.created_at | date: format: 'date_at_time' }}</p><div class="system-page__content"><table><thead><tr><th>Product</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for line_item in order.line_items %}<tr><td>{% if line_item.url %}<a href="{{ line_item.url }}">{{ line_item.title }}</a>{% else %}{{ line_item.title }}{% endif %}</td><td>{{ line_item.quantity }}</td><td>{{ line_item.final_line_price | money }}</td></tr>{% endfor %}</tbody><tfoot><tr><th colspan="2">Total</th><td>{{ order.total_net_amount | money_with_currency }}</td></tr></tfoot></table></div></section>
