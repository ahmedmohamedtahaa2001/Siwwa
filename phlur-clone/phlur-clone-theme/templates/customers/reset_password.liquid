{{ 'system-pages.css' | asset_url | stylesheet_tag }}<section class="system-page"><h1 class="system-page__title">Reset password</h1>{% form 'reset_customer_password', class: 'system-form-stack' %}{{ form.errors | default_errors }}<label>Password<input type="password" name="customer[password]" autocomplete="new-password" required></label><label>Confirm password<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label><button class="system-page__button" type="submit">Reset password</button>{% endform %}</section>
