{{ 'system-pages.css' | asset_url | stylesheet_tag }}<main class="system-page"><h1 class="system-page__title">{{ shop.name }}</h1>{% unless shop.password_message == blank %}<div class="system-page__content">{{ shop.password_message }}</div>{% endunless %}{% form 'storefront_password', class: 'system-form-stack' %}{{ form.errors | default_errors }}<label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="system-page__button" type="submit">Enter store</button>{% endform %}</main>
