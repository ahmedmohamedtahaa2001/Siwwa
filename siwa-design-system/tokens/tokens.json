{
  "$meta": {
    "system": "Siwa Design System",
    "version": "3.0.0",
    "supersedes": "2.0.0",
    "unifies": [
      "Siwa DS v2.0.0 — warm Egyptian palette, stamped geometry, bilingual parity",
      "Siwa Premium Cozy Design System — bento layout, ecommerce component coverage"
    ],
    "spec": "../DESIGN.md",
    "emits": "./siwa-tokens.css",
    "shape": "Flat map, drop-in compatible with phlur-clone/mapping/siwa-tokens.json (which reads v2.0.0 and should be repointed here).",
    "contrastVerified": "All colour pairs verified against WCAG 2.2 on #f7f5ee and #eae0c4. Table in DESIGN.md §2.1. Zero failures.",
    "corrections": "Five v2.0.0 colour tokens failed their own AA floor and were corrected. Ledger in DESIGN.md §11.1."
  },

  "--colors-background": "#f7f5ee",
  "--colors-surface": "#eae0c4",
  "--colors-surface-hover": "#d3cab0",
  "--colors-surface-dark": "#2f3932",

  "--colors-text": "#1b2724",
  "--colors-text-secondary": "#6f6156",
  "--colors-heading": "#6b4a28",
  "--colors-heading-alt": "#50251c",
  "--colors-on-dark": "#d3d8d1",

  "--colors-primary": "#b38145",
  "--colors-primary-strong": "#a5773f",
  "--colors-secondary": "#e1b160",

  "--colors-border": "#e4b68a",
  "--colors-border-strong": "#997a5c",
  "--colors-hairline-accent": "#b8bdbd",

  "--colors-link": "#845a48",
  "--colors-success": "#586851",
  "--colors-warning": "#8b5823",
  "--colors-danger": "#9c3b2c",
  "--colors-tag": "#66634e",

  "--colors-original": "#6b4a28",
  "--colors-impression": "#2f3932",
  "--colors-verified": "#586851",

  "--scrim-color": "rgba(27, 39, 36, 0.50)",

  "--font-display-latin": "'Fraunces', Georgia, 'Times New Roman', serif",
  "--font-ui-latin": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
  "--font-display-arabic": "'Aref Ruqaa', 'Markazi Text', Georgia, serif",
  "--font-ui-arabic": "'IBM Plex Sans Arabic', 'Tajawal', Arial, sans-serif",
  "--font-mono": "'JetBrains Mono', 'Fira Code', 'Courier New', monospace",

  "--text-hero": "clamp(2rem, 1.20rem + 3.40vw, 3rem)",
  "--text-h1": "clamp(1.75rem, 1.30rem + 1.90vw, 2.25rem)",
  "--text-h2": "clamp(1.5rem, 1.20rem + 1.30vw, 1.875rem)",
  "--text-h3": "1.5rem",
  "--text-body-lg": "1.125rem",
  "--text-body": "1rem",
  "--text-body-sm": "0.875rem",
  "--text-label": "0.75rem",

  "--weight-light": "300",
  "--weight-regular": "400",
  "--weight-medium": "500",
  "--weight-semibold": "600",
  "--weight-bold": "700",

  "--leading-display": "1.10",
  "--leading-heading": "1.25",
  "--leading-body": "1.60",
  "--leading-tight": "1.20",

  "--tracking-display": "-0.01em",
  "--tracking-body": "0em",
  "--tracking-label": "0.12em",
  "--tracking-button": "0.08em",

  "--spacing-1": "4px",
  "--spacing-2": "8px",
  "--spacing-3": "12px",
  "--spacing-4": "16px",
  "--spacing-6": "24px",
  "--spacing-8": "32px",
  "--spacing-12": "48px",
  "--spacing-16": "64px",
  "--spacing-24": "96px",
  "--spacing-section": "72px",
  "--spacing-section-tight": "48px",

  "--rounded-none": "0px",
  "--rounded-sm": "2px",
  "--rounded-editorial": "16px",
  "--rounded-bento": "24px",
  "--rounded-full": "9999px",

  "--shadow-none": "none",
  "--shadow-editorial": "0 4px 20px 0 rgba(27, 39, 36, 0.10)",
  "--shadow-modal": "0 8px 32px 0 rgba(27, 39, 36, 0.18), 0 2px 8px 0 rgba(27, 39, 36, 0.10)",
  "--focus-ring": "0 0 0 2px var(--colors-background), 0 0 0 4px var(--colors-text)",
  "--focus-ring-dark": "0 0 0 2px var(--colors-surface-dark), 0 0 0 4px var(--colors-secondary)",
  "--focus-ring-width": "2px",

  "--duration-instant": "0ms",
  "--duration-fast": "120ms",
  "--duration-medium": "240ms",
  "--duration-slow": "400ms",
  "--duration-story": "800ms",
  "--easing-default": "cubic-bezier(0.25, 0.1, 0.25, 1.0)",
  "--easing-enter": "cubic-bezier(0.0, 0.0, 0.2, 1.0)",
  "--easing-exit": "cubic-bezier(0.4, 0.0, 1.0, 1.0)",

  "--grid-max-width": "1200px",
  "--grid-outer-gutter": "24px",
  "--grid-outer-gutter-sm": "16px",
  "--grid-outer-gutter-xs": "16px",
  "--grid-gutter": "16px",
  "--grid-gutter-xs": "12px",
  "--nav-height": "64px",
  "--measure": "68ch",
  "--tap-min": "44px",
  "--control-h": "48px",
  "--control-h-sm": "40px",

  "--bp-mobile": "480px",
  "--bp-tablet": "768px",
  "--bp-desktop": "1200px",
  "--bp-desktop-lg": "1440px",

  "--z-base": "0",
  "--z-card-badge": "10",
  "--z-sticky-nav": "100",
  "--z-drawer": "200",
  "--z-scrim": "300",
  "--z-modal": "301",
  "--z-toast": "400"
}
